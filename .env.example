# Supabase
PUBLIC_SUPABASE_URL=your-supabase-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (emails)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=info@videomarketingsevilla.com

# Pushover (preferred: API; fallback: email bridge)
PUSHOVER_API_TOKEN=your-pushover-app-token
PUSHOVER_USER_KEY=your-pushover-user-key
PUSHOVER_EMAIL=your-pushover-email-bridge@pomail.net

# Cloudinary
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Site
PUBLIC_SITE_URL=https://videomarketingsevilla.com
PUBLIC_WHATSAPP_NUMBER=34600000000
CAPTCHA_SECRET=change-this-random-secret

# Google Ads / Analytics
# Use GTM if you want to manage all Google tags from Tag Manager.
PUBLIC_GTM_ID=
# Use these only if you are not loading the same tags through GTM.
PUBLIC_GA4_MEASUREMENT_ID=G-5R4XHSCR49
PUBLIC_GOOGLE_ADS_ID=
# Optional. Do not use until the conversion action is confirmed in Google Ads.
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
