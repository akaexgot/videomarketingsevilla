---
/**
 * BaseLayout
 * Main layout wrapper for all public pages
 */
import Head from "../components/seo/Head.astro";
import GoogleTracking from "../components/seo/GoogleTracking.astro";
import CookieConsent from "../components/seo/CookieConsent.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import MobileBottomBar from "../components/ui/MobileBottomBar.astro";
import ProjectModal from "../components/ui/ProjectModal.astro";
import "../styles/global.css";
import "../styles/contacto-chat.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    url?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
    structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const { title, description, image, imageAlt, url, type, noindex, structuredData } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <Head
            title={title}
            description={description}
            image={image}
            imageAlt={imageAlt}
            url={url}
            type={type}
            noindex={noindex}
            structuredData={structuredData}
        />
        <GoogleTracking />
    </head>
    <body class="bg-dark text-light antialiased">


        <Navbar />

        <main style="display: flex; flex-direction: column; font-size: 0;">
            <slot />
        </main>

        <Footer />
        <MobileBottomBar />
        <ProjectModal />
        <CookieConsent />

        <!-- Scroll Reveal Observer -->
        <script>
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                        } else {
                            entry.target.classList.remove("is-visible");
                        }
                    });
                },
                {
                    threshold: 0.08,
                    rootMargin: "0px 0px -5% 0px",
                },
            );

            document
                .querySelectorAll(
                    ".reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-bottom, .reveal-zoom, .stagger-children",
                )
                .forEach((el) => {
                    observer.observe(el);
                });
        </script>

        <!-- ═══ GLOBAL CHAT WIDGET ═══ -->
        <div id="global-chat-panel" class="chat-panel">
            <div class="chat-panel__header">
                <div class="chat-panel__avatar">VM</div>
                <div class="chat-panel__header-info">
                    <h3>VideoMarketing Sevilla</h3>
                    <p><span class="chat-panel__status-dot"></span>Normalmente responde en minutos</p>
                </div>
                <button id="global-chat-close" class="chat-panel__close" aria-label="Cerrar chat">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div id="global-chat-name-form" class="chat-panel__name-form">
                <h4>👋 ¡Hola!</h4>
                <p>Introduce tu nombre para iniciar el chat</p>
                <input type="text" id="global-chat-name-input" placeholder="Tu nombre" maxlength="50" />
                <button id="global-chat-start-btn">Iniciar chat</button>
            </div>
            <div id="global-chat-messages" class="chat-panel__messages" style="display:none">
                <div class="chat-welcome">
                    <span class="chat-welcome__emoji">💬</span>
                    <strong>¡Bienvenido!</strong><br/>
                    Escribe tu mensaje y te responderemos lo antes posible.
                </div>
            </div>
            <div id="global-chat-input-area" class="chat-panel__input" style="display:none">
                <input type="text" id="global-chat-input" placeholder="Escribe un mensaje..." maxlength="500" />
                <button id="global-chat-send" class="chat-panel__send" disabled>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
        </div>

        <script>
        (function() {
            const chatPanel = document.getElementById('global-chat-panel');
            const chatCloseBtn = document.getElementById('global-chat-close');
            const chatNameForm = document.getElementById('global-chat-name-form');
            const chatNameInput = document.getElementById('global-chat-name-input') as HTMLInputElement;
            const chatStartBtn = document.getElementById('global-chat-start-btn');
            const chatMessages = document.getElementById('global-chat-messages');
            const chatInputArea = document.getElementById('global-chat-input-area');
            const chatInput = document.getElementById('global-chat-input') as HTMLInputElement;
            const chatSend = document.getElementById('global-chat-send') as HTMLButtonElement;
            const floatingBtn = document.getElementById('floating-chat-btn');

            if (!chatPanel || !floatingBtn) return;

            let chatOpen = false;
            let conversationId: string | null = null;
            let visitorId = localStorage.getItem('vm_visitor_id');
            let visitorName = localStorage.getItem('vm_visitor_name');
            let pollInterval: ReturnType<typeof setInterval> | null = null;

            if (!visitorId) {
                visitorId = 'v_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
                localStorage.setItem('vm_visitor_id', visitorId);
            }
            // Ensure cookie is set for server-side validation (middleware)
            document.cookie = `vm_visitor_id=${visitorId}; path=/; max-age=31536000; SameSite=Lax`;

            function openChat() {
                if (!chatOpen) {
                    chatOpen = true;
                    chatPanel.classList.add('chat-panel--open');
                    floatingBtn.style.display = 'none';
                    if (visitorName && chatNameForm) {
                        chatNameForm.style.display = 'none';
                        startChat();
                    }
                }
            }

            (window as any).vmOpenGlobalChat = openChat;

            function isOpenChatTrigger(target: EventTarget | null) {
                return target instanceof Element ? target.closest('.js-open-chat') : null;
            }

            function getTouchTrigger(e: TouchEvent) {
                const touch = e.changedTouches[0];
                if (!touch) return null;
                const el = document.elementFromPoint(touch.clientX, touch.clientY);
                return el?.closest('.js-open-chat') || null;
            }

            // Open/Close
            floatingBtn.addEventListener('click', () => {
                openChat();
            });

            // Also allow .js-open-chat buttons (e.g. hero buttons) to open global chat.
            // Capture pointer/touch early so mobile scroll handlers cannot swallow the CTA.
            document.addEventListener('pointerup', (e) => {
                const trigger = isOpenChatTrigger(e.target);
                if (!trigger) return;
                e.preventDefault();
                openChat();
            }, { capture: true });

            document.addEventListener('touchend', (e) => {
                const trigger = getTouchTrigger(e);
                if (!trigger) return;
                e.preventDefault();
                openChat();
            }, { capture: true, passive: false });

            document.addEventListener('click', (e) => {
                const trigger = isOpenChatTrigger(e.target);
                if (!trigger) return;
                e.preventDefault();
                openChat();
            }, { capture: true });

            chatCloseBtn?.addEventListener('click', () => {
                chatOpen = false;
                chatPanel.classList.remove('chat-panel--open');
                floatingBtn.style.display = 'flex';
            });

            chatStartBtn?.addEventListener('click', () => {
                const name = chatNameInput?.value.trim();
                if (!name) { chatNameInput?.focus(); return; }
                visitorName = name;
                localStorage.setItem('vm_visitor_name', name);
                startChat();
            });

            chatNameInput?.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') chatStartBtn?.click();
            });

            // ── Secret admin access via name input ──
            chatNameInput?.addEventListener('input', () => {
                if (chatNameInput.value.trim().toLowerCase() === 'admin') {
                    window.location.href = '/admin/login';
                }
            });

            async function startChat() {
                if (chatNameForm) chatNameForm.style.display = 'none';
                if (chatMessages) chatMessages.style.display = 'flex';
                if (chatInputArea) chatInputArea.style.display = 'flex';
                chatInput?.focus();

                try {
                    const res = await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'create', visitor_id: visitorId, visitor_name: visitorName }),
                    });
                    const data = await res.json();
                    conversationId = data.conversation_id;
                    await loadMessages();
                    if (pollInterval) clearInterval(pollInterval);
                    pollInterval = setInterval(loadMessages, 5000);
                } catch (err) { console.error('Chat error:', err); }
            }

            async function loadMessages() {
                if (!conversationId || !chatMessages) return;
                try {
                    const res = await fetch(`/api/chat?conversation_id=${conversationId}`);
                    const messages = await res.json();
                    const welcome = chatMessages.querySelector('.chat-welcome');
                    if (messages.length > 0 && welcome) welcome.remove();
                    const existing = chatMessages.querySelectorAll('.chat-msg');
                    const existingIds = new Set(Array.from(existing).map(el => (el as HTMLElement).dataset.id));
                    let hasNew = false;
                    messages.forEach((msg: any) => {
                        if (!existingIds.has(msg.id)) {
                            const div = document.createElement('div');
                            div.className = `chat-msg chat-msg--${msg.sender_type}`;
                            div.dataset.id = msg.id;
                            const time = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
                            div.innerHTML = `${msg.message}<span class="chat-msg__time">${time}</span>`;
                            chatMessages.appendChild(div);
                            hasNew = true;
                        }
                    });
                    if (hasNew) chatMessages.scrollTop = chatMessages.scrollHeight;
                } catch (err) { console.error('Load messages error:', err); }
            }

            chatInput?.addEventListener('input', () => { 
                chatSend.disabled = !chatInput.value.trim(); 
                
                // ── Secret admin access via message input ──
                if (chatInput.value.trim().toLowerCase() === 'admin') {
                    window.location.href = '/admin/login';
                }
            });
            chatInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !chatSend.disabled) sendMessage(); });
            chatSend?.addEventListener('click', sendMessage);

            async function sendMessage() {
                const text = chatInput?.value.trim();
                if (!text || !conversationId) return;
                chatInput.value = '';
                chatSend.disabled = true;
                try {
                    await fetch('/api/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'send', conversation_id: conversationId, sender_type: 'visitor', message: text }),
                    });
                    await loadMessages();
                } catch (err) { console.error('Send error:', err); }
            }

            if (visitorName && chatNameForm) chatNameForm.style.display = 'none';
        })();
        </script>
        <!-- ═══ EXCLUSIVE VIDEO PLAYBACK ═══ -->
        <!-- Only one YouTube video plays at a time; starting one pauses all others -->
        <script>
        (function() {
            /**
             * Exclusive YouTube Playback
             * Uses YouTube IFrame API postMessage to ensure only one video
             * plays at a time across the entire page.
             */

            // Pause a YouTube iframe via postMessage
            function pauseIframe(iframe) {
                try {
                    if (iframe.contentWindow) {
                        iframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' }),
                            '*'
                        );
                    }
                } catch (e) { /* cross-origin safety */ }
            }

            // Get all YouTube iframes on the page
            function getYouTubeIframes() {
                return Array.from(document.querySelectorAll('iframe'))
                    .filter(f => f.src && f.src.includes('youtube-nocookie.com/embed'));
            }

            // Listen for YouTube state change messages
            window.addEventListener('message', (event) => {
                // YouTube sends messages as JSON strings
                let data;
                try {
                    data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
                } catch (e) { return; }

                // YouTube IFrame API event
                if (data?.event === 'infoDelivery') {
                    const state = data?.info?.playerState;
                    const currentTime = data?.info?.currentTime || 0;
                    const duration = data?.info?.duration || 0;
                    
                    const allIframes = getYouTubeIframes();
                    const sourceIframe = allIframes.find(f => {
                        try { return f.contentWindow === event.source; } catch (e) { return false; }
                    });
                    if (!sourceIframe) return;

                    // Exclude Hero player, as it manages its own state via YT.Player API
                    if (sourceIframe.id === 'hero-player') return;

                    // PRE-END LOOPING: If it's a background video, loop it BEFORE it ends to avoid the Play button flash!
                    if (sourceIframe.src.includes('mute=1') && duration > 0 && currentTime >= duration - 0.4) {
                        // Fade out to mask any YouTube UI flashes during seek
                        sourceIframe.style.transition = 'opacity 0.2s';
                        sourceIframe.style.opacity = '0';
                        
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'seekTo', args: [0, true] }), '*'
                        );
                        
                        return; // Prevent further processing
                    }

                    // Fallback manual loop if it somehow reaches ENDED (0)
                    if (state === 0 && sourceIframe.src.includes('mute=1')) {
                        sourceIframe.style.transition = 'opacity 0.2s';
                        sourceIframe.style.opacity = '0';
                        
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'seekTo', args: [0, true] }), '*'
                        );
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'playVideo', args: '' }), '*'
                        );
                        
                        return;
                    }

                    // When video is playing (1), ensure it's visible (fades in)
                    if (state === 1 && sourceIframe.src.includes('mute=1')) {
                        if (sourceIframe.style.opacity === '0' || sourceIframe.style.opacity === '') {
                            sourceIframe.style.transition = 'opacity 0.5s';
                            sourceIframe.style.opacity = '1';
                        }
                    }

                    // If a foreground video started playing (1), pause other foreground videos
                    if (state === 1 && sourceIframe.classList.contains('vm-exclusive-video')) {
                        allIframes.forEach(iframe => {
                            if (iframe !== sourceIframe && iframe.classList.contains('vm-exclusive-video')) {
                                pauseIframe(iframe);
                            }
                        });
                    }
                }
            });

            // Enable YouTube JS API listening on all iframes
            // YouTube requires enablejsapi=1 AND we need to call addEventListener
            // via postMessage to receive state change events
            function enableListening() {
                getYouTubeIframes().forEach(iframe => {
                    try {
                        if (iframe.contentWindow) {
                            iframe.contentWindow.postMessage(
                                JSON.stringify({ event: 'listening', id: iframe.id || 'yt' }),
                                '*'
                            );
                        }
                    } catch (e) { /* cross-origin safety */ }
                });
            }

            let listeningInterval: ReturnType<typeof setInterval> | null = null;

            function hasPlayableYouTubeIframes() {
                return getYouTubeIframes().length > 0;
            }

            function startListeningLoop() {
                enableListening();
                if (!listeningInterval && hasPlayableYouTubeIframes()) {
                    listeningInterval = setInterval(() => {
                        if (!hasPlayableYouTubeIframes()) {
                            if (listeningInterval) clearInterval(listeningInterval);
                            listeningInterval = null;
                            return;
                        }
                        enableListening();
                    }, 3000);
                }
            }

            // Run on load and periodically only while YouTube iframes exist.
            if (document.readyState === 'complete') {
                startListeningLoop();
            } else {
                window.addEventListener('load', startListeningLoop);
            }
        })();
        </script>
    </body>
</html>
