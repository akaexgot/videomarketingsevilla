---
/**
 * BaseLayout
 * Main layout wrapper for all public pages
 */
import Head from "../components/seo/Head.astro";
import GoogleTracking from "../components/seo/GoogleTracking.astro";
import CookieConsent from "../components/seo/CookieConsent.astro";
import Navbar from "../components/ui/Navbar.astro";
import Footer from "../components/ui/Footer.astro";
import MobileBottomBar from "../components/ui/MobileBottomBar.astro";
import ProjectModal from "../components/ui/ProjectModal.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    url?: string;
    type?: 'website' | 'article';
    noindex?: boolean;
    structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const { title, description, image, imageAlt, url, type, noindex, structuredData } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <Head
            title={title}
            description={description}
            image={image}
            imageAlt={imageAlt}
            url={url}
            type={type}
            noindex={noindex}
            structuredData={structuredData}
        />
        <GoogleTracking />
    </head>
    <body class="bg-dark text-light antialiased">


        <Navbar />

        <main style="display: flex; flex-direction: column; font-size: 0;">
            <slot />
        </main>

        <Footer />
        <MobileBottomBar />
        <ProjectModal />
        <CookieConsent />

        <!-- Scroll Reveal Observer -->
        <script>
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("is-visible");
                        } else {
                            entry.target.classList.remove("is-visible");
                        }
                    });
                },
                {
                    threshold: 0.08,
                    rootMargin: "0px 0px -5% 0px",
                },
            );

            document
                .querySelectorAll(
                    ".reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-bottom, .reveal-zoom, .stagger-children",
                )
                .forEach((el) => {
                    observer.observe(el);
                });
        </script>

        <!-- --- EXCLUSIVE VIDEO PLAYBACK --- -->
        <!-- Only one YouTube video plays at a time; starting one pauses all others -->
        <script>
        (function() {
            /**
             * Exclusive YouTube Playback
             * Uses YouTube IFrame API postMessage to ensure only one video
             * plays at a time across the entire page.
             */

            // Pause a YouTube iframe via postMessage
            function pauseIframe(iframe) {
                try {
                    if (iframe.contentWindow) {
                        iframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' }),
                            '*'
                        );
                    }
                } catch (e) { /* cross-origin safety */ }
            }

            // Get all YouTube iframes on the page
            function getYouTubeIframes() {
                return Array.from(document.querySelectorAll('iframe'))
                    .filter(f => f.src && f.src.includes('youtube-nocookie.com/embed'));
            }

            // Listen for YouTube state change messages
            window.addEventListener('message', (event) => {
                // YouTube sends messages as JSON strings
                let data;
                try {
                    data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
                } catch (e) { return; }

                // YouTube IFrame API event
                if (data?.event === 'infoDelivery') {
                    const state = data?.info?.playerState;
                    const currentTime = data?.info?.currentTime || 0;
                    const duration = data?.info?.duration || 0;
                    
                    const allIframes = getYouTubeIframes();
                    const sourceIframe = allIframes.find(f => {
                        try { return f.contentWindow === event.source; } catch (e) { return false; }
                    });
                    if (!sourceIframe) return;

                    // Exclude Hero player, as it manages its own state via YT.Player API
                    if (sourceIframe.id === 'hero-player') return;

                    // PRE-END LOOPING: If it's a background video, loop it BEFORE it ends to avoid the Play button flash!
                    if (sourceIframe.src.includes('mute=1') && duration > 0 && currentTime >= duration - 0.4) {
                        // Fade out to mask any YouTube UI flashes during seek
                        sourceIframe.style.transition = 'opacity 0.2s';
                        sourceIframe.style.opacity = '0';
                        
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'seekTo', args: [0, true] }), '*'
                        );
                        
                        return; // Prevent further processing
                    }

                    // Fallback manual loop if it somehow reaches ENDED (0)
                    if (state === 0 && sourceIframe.src.includes('mute=1')) {
                        sourceIframe.style.transition = 'opacity 0.2s';
                        sourceIframe.style.opacity = '0';
                        
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'seekTo', args: [0, true] }), '*'
                        );
                        sourceIframe.contentWindow.postMessage(
                            JSON.stringify({ event: 'command', func: 'playVideo', args: '' }), '*'
                        );
                        
                        return;
                    }

                    // When video is playing (1), ensure it's visible (fades in)
                    if (state === 1 && sourceIframe.src.includes('mute=1')) {
                        if (sourceIframe.style.opacity === '0' || sourceIframe.style.opacity === '') {
                            sourceIframe.style.transition = 'opacity 0.5s';
                            sourceIframe.style.opacity = '1';
                        }
                    }

                    // If a foreground video started playing (1), pause other foreground videos
                    if (state === 1 && sourceIframe.classList.contains('vm-exclusive-video')) {
                        allIframes.forEach(iframe => {
                            if (iframe !== sourceIframe && iframe.classList.contains('vm-exclusive-video')) {
                                pauseIframe(iframe);
                            }
                        });
                    }
                }
            });

            // Enable YouTube JS API listening on all iframes
            // YouTube requires enablejsapi=1 AND we need to call addEventListener
            // via postMessage to receive state change events
            function enableListening() {
                getYouTubeIframes().forEach(iframe => {
                    try {
                        if (iframe.contentWindow) {
                            iframe.contentWindow.postMessage(
                                JSON.stringify({ event: 'listening', id: iframe.id || 'yt' }),
                                '*'
                            );
                        }
                    } catch (e) { /* cross-origin safety */ }
                });
            }

            let listeningInterval: ReturnType<typeof setInterval> | null = null;

            function hasPlayableYouTubeIframes() {
                return getYouTubeIframes().length > 0;
            }

            function startListeningLoop() {
                enableListening();
                if (!listeningInterval && hasPlayableYouTubeIframes()) {
                    listeningInterval = setInterval(() => {
                        if (!hasPlayableYouTubeIframes()) {
                            if (listeningInterval) clearInterval(listeningInterval);
                            listeningInterval = null;
                            return;
                        }
                        enableListening();
                    }, 3000);
                }
            }

            // Run on load and periodically only while YouTube iframes exist.
            if (document.readyState === 'complete') {
                startListeningLoop();
            } else {
                window.addEventListener('load', startListeningLoop);
            }
        })();
        </script>
    </body>
</html>
