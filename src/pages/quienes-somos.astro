                        {settings.email && (
                            <a href={`mailto:${settings.email}`} class="qs-contact-card">
                                <div class="qs-contact-card__icon" style="background:rgba(155,27,48,0.08);">
                                    <svg class="qs-contact-card__svg" style="color:#9b1b30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
