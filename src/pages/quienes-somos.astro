---
/**
 * Quiénes Somos — Fullscreen Video Hero + Fullpage Scroll
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/quienes-somos.css";
import { getSettings } from "../lib/data";
import CompaniesCarousel from "../components/home/CompaniesCarousel.astro";
import AwardsCarousel from "../components/home/AwardsCarousel.astro";
import { buildBreadcrumbSchema, getSiteUrl } from "../lib/seo";

const settings = await getSettings();
const structuredData = [
    buildBreadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Quienes Somos', path: '/quienes-somos' },
    ]),
    {
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        name: 'Quienes Somos | VideoMarketing Sevilla',
        url: `${getSiteUrl()}/quienes-somos`,
    },
];

import "../styles/contacto.css";

function extractYouTubeId(url: string | null | undefined): string | null {
    if (!url) return null;
    const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (m) return m[1];
    if (/^[A-Za-z0-9_-]{11}$/.test(url.trim())) return url.trim();
    return null;
}

// Extraer video hero
const heroVideoUrl = settings.hero_video_desktop;
const heroVideoIsNative = heroVideoUrl && (
    heroVideoUrl.includes('cloudinary.com') ||
    heroVideoUrl.endsWith('.mp4') ||
    heroVideoUrl.endsWith('.webm')
);
const heroVideoId = !heroVideoIsNative ? extractYouTubeId(heroVideoUrl) : null;

// Extraer video corporativo de contenido
const corporateVideoId = extractYouTubeId(settings.about_corporate_video);

// Extraer URL limpia de mapa si el usuario pegó el iframe completo en ajustes
let cleanMapUrl = settings.google_maps_embed;
if (cleanMapUrl && cleanMapUrl.includes('<iframe')) {
    const match = cleanMapUrl.match(/src="([^"]+)"/);
    if (match) cleanMapUrl = match[1];
}
---

<BaseLayout
    structuredData={structuredData}
    title="Quiénes Somos"
    description="Conoce a VideoMarketing Sevilla. Somos una productora audiovisual especializada en video marketing para empresas en Sevilla y toda España."
>

    <!-- ═══ HERO CONDICIONAL ═══ -->
    {heroVideoUrl && (heroVideoIsNative || heroVideoId) ? (
        <>
            <section id="video-hero" class="qs-video-hero">
                <div class="qs-video-hero__bg">
                    {heroVideoIsNative ? (
                        <video
                            aria-hidden="true"
                            src={heroVideoUrl}
                            class="qs-video-hero__iframe"
                            autoplay
                            loop
                            muted
                            playsinline
                            style="object-fit: cover;"
                        ></video>
                    ) : (
                    <iframe
                        src={`https://www.youtube-nocookie.com/embed/${heroVideoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&origin=${Astro.url.origin}`}
                        class="qs-video-hero__iframe"
                        frameborder="0" allow="autoplay; encrypted-media; compute-pressure"
                        title="Vídeo corporativo VideoMarketing Sevilla"
                    ></iframe>
                    )}
                </div>
                <!-- Gradient overlay -->
                <div class="qs-video-hero__overlay"></div>
                <!-- Content -->
                <div class="qs-video-hero__content">
                    <div class="qs-video-hero__badge">
                        <span class="qs-video-hero__dot"></span>
                        <span>Nosotros</span>
                    </div>
                    <h1 class="qs-video-hero__title">
                        Quiénes <span class="text-gradient-carmin">somos</span>
                    </h1>
                    <p class="qs-video-hero__subtitle">
                        Somos una productora audiovisual con sede en Sevilla,<br class="hidden md:block" />
                        especializados en crear contenido que conecta marcas con personas.
                    </p>
                </div>
                <!-- Scroll indicator -->
                <div class="qs-video-hero__scroll">
                    <span>Descubre más</span>
                    <div class="qs-video-hero__scroll-arrow">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </div>
            </section>
        </>
    ) : (
        <section class="contact-hero" style="padding-bottom: 2rem;">
            <div class="contact-hero__glow"></div>
            <div class="section-container contact-hero__inner">
                <div class="contact-hero__badge">
                    <span class="contact-hero__badge-dot"></span>
                    <span>Nosotros</span>
                </div>
                <h1 class="contact-hero__title" style="color: #18181b;">
                    Quiénes <span class="contact-hero__title--accent" style="color: #c42847;">somos</span>
                </h1>
                <p class="contact-hero__subtitle" style="color: rgba(0,0,0,0.6); margin-bottom: 0;">
                    Somos una productora audiovisual con sede en Sevilla,<br class="hidden md:block" />
                    especializados en crear contenido que conecta marcas con personas.
                </p>
            </div>
        </section>
        <style is:global>
            body, main { background-color: #ffffff !important; }
            .navbar { background: rgba(255, 255, 255, 0.9) !important; border-bottom: 1px solid rgba(0,0,0,0.05); }
            .nav-link { color: #c42847 !important; font-weight: 500; }
            .nav-link:hover, .nav-link.active { color: #9b1b30 !important; }
        </style>
    )}

    <!-- ═══ ABOUT & STATS ═══ -->
    <section class="qs-about" id="qs-about">
        <div class="qs-about__main-content">
            <!-- Stats Band at the top of the About section -->
            <div class="qs-stats-container">
                <div class="section-container qs-stats__grid">
                    <div class="qs-stat">
                        <span class="qs-stat__number text-gradient-carmin">100+</span>
                        <span class="qs-stat__label">Proyectos realizados</span>
                    </div>
                    <div class="qs-stat__divider"></div>
                    <div class="qs-stat">
                        <span class="qs-stat__number text-gradient-carmin">50+</span>
                        <span class="qs-stat__label">Clientes satisfechos</span>
                    </div>
                    <div class="qs-stat__divider"></div>
                    <div class="qs-stat">
                        <span class="qs-stat__number text-gradient-carmin">6+</span>
                        <span class="qs-stat__label">Sectores</span>
                    </div>
                </div>
            </div>
            <div class="qs-about-content-wrapper">
                <div class="section-container qs-about__grid">

                <!-- Vídeo corporativo -->
                <div class="qs-video reveal-left">
                    <div class="qs-video__frame">
                        {corporateVideoId ? (
                            <iframe
                                src={`https://www.youtube-nocookie.com/embed/${corporateVideoId}?rel=0&enablejsapi=1&origin=${Astro.url.origin}`}
                                class="w-full h-full object-cover"
                                style="border:none;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; compute-pressure"
                                allowfullscreen></iframe>
                        ) : (
                            <div class="qs-video__placeholder">
                                <div class="qs-video__play">
                                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                                <p class="qs-video__label">Vídeo corporativo</p>
                                <p class="qs-video__sublabel">Próximamente</p>
                            </div>
                        )}
                    </div>
                </div>

                <!-- Texto -->
                <div class="qs-about__text reveal-right">
                    <h2 class="qs-about__heading">
                        Transformamos ideas en
                        <span class="text-gradient-carmin"> contenido audiovisual</span>
                    </h2>
                    <div class="qs-about__body">
                        <p>
                            En VideoMarketing Sevilla creemos que cada empresa tiene una historia
                            que merece ser contada. Desde nuestra fundación, nos hemos dedicado
                            a crear contenido audiovisual de calidad cinematográfica para empresas
                            que quieren destacar.
                        </p>
                        <p>
                            Nuestro equipo combina creatividad, tecnología y estrategia para
                            producir vídeos que no solo se ven bien, sino que generan resultados
                            medibles para tu negocio.
                        </p>
                        <p>
                            Trabajamos con empresas de todos los sectores en Sevilla, Cádiz y
                            toda España, ofreciendo un servicio personalizado y cercano.
                        </p>
                    </div>
                    <a href="/contacto" class="qs-cta-btn">
                        Solicitar presupuesto
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </a>
                </div>

                </div>
            </div>
        </div>
        <CompaniesCarousel />
    </section>

    <!-- ═══ ENCUENTRANOS ═══ -->
    <section class="qs-find" id="qs-find">
        <div class="qs-find__main-content">
            <div class="section-container">

                <div class="qs-section-header reveal">
                    <h2 class="qs-section-title">Encuéntranos</h2>
                    <p class="qs-section-subtitle">Estamos en Sevilla y trabajamos para toda España</p>
                </div>

                <div class="qs-find__grid">

                    <!-- Mapa -->
                    <div class="qs-map reveal-left">
                        {cleanMapUrl ? (
                            <iframe
                                src={cleanMapUrl}
                                class="qs-map__iframe"
                                allowfullscreen
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                title="Ubicación VideoMarketing Sevilla"
                            ></iframe>
                        ) : (
                            <div class="qs-map__placeholder">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>Sevilla, España</span>
                            </div>
                        )}
                    </div>

                    <!-- Tarjetas de contacto -->
                    <div class="qs-contacts reveal-right">

                        {settings.whatsapp_number && (
