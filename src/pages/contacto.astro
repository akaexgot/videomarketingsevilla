---
/**
 * Contacto Page — Premium redesign
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqsSection from "../components/home/FaqsSection.astro";
import "../styles/contacto.css";
import { getSettings } from "../lib/data";
import { createCaptchaChallenge } from "../lib/captcha";
import { buildBreadcrumbSchema, getSiteUrl } from "../lib/seo";

const settings = await getSettings();
const captcha = createCaptchaChallenge();
const structuredData = [
    buildBreadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Contacto', path: '/contacto' },
    ]),
    {
        '@context': 'https://schema.org',
        '@type': 'ContactPage',
        name: 'Contacto VideoMarketing Sevilla',
        url: `${getSiteUrl()}/contacto`,
    },
];

const sharedHeroVideoUrl = null;
const sharedHeroVideoIsNative = false;
const sharedHeroVideoId = null;
const whatsappHref = `https://wa.me/${settings.whatsapp_number?.replace(/[^0-9]/g, '')}?text=Hola,%20me%20gustaria%20saber%20mas%20sobre%20vuestros%20servicios%20de%20video%20marketing.`;
---

<BaseLayout
    title="Contacto"
    structuredData={structuredData}
    description="Contacta con VideoMarketing Sevilla. Cuéntanos tu proyecto de video marketing y te enviamos un presupuesto personalizado."
>

    <!-- ═══════════════════════════════════════════
         HERO HEADER
    ═══════════════════════════════════════════ -->
    {false ? (
        <section id="video-hero" class="relative min-h-[600px] h-screen flex flex-col items-center justify-center text-center overflow-hidden w-full" style={sharedHeroVideoId ? `background: #000 url(https://i.ytimg.com/vi/${sharedHeroVideoId}/maxresdefault.jpg) center/cover no-repeat;` : 'background: #000;'}>
            <div class="absolute inset-0 z-0 overflow-hidden bg-black pointer-events-none">
                {sharedHeroVideoIsNative ? (
                    <video
                        aria-hidden="true"
                        src={sharedHeroVideoUrl}
                        class="absolute inset-0 w-full h-full object-cover"
                        autoplay
                        loop
                        muted
                        playsinline
                    ></video>
                ) : (
                <iframe
                    src={`https://www.youtube-nocookie.com/embed/${sharedHeroVideoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&disablekb=1&fs=0&iv_load_policy=3`}
                    class="contact-video-bg__iframe"
                    style="position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100vh; min-width: 177.77vh; transform: translate(-50%, -50%); pointer-events: none;"
                    frameborder="0" allow="autoplay; encrypted-media" tabindex="-1"
                    aria-hidden="true"
                    title="Vídeo de fondo de contacto"
                ></iframe>
                )}
            </div>
            <div class="absolute inset-0 z-10 bg-black/50 pointer-events-none"></div>

            <div class="relative z-20 section-container contact-hero__inner">
                <div class="contact-hero__badge" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); color: white;">
                    <span class="contact-hero__badge-dot" style="background: #e11d48;"></span>
                    <span>Hablemos</span>
                </div>

                <h1 class="contact-hero__title" style="color: white; margin-bottom: 0.25rem; line-height: 1.1;">
                    Cuéntanos tu <span class="text-rose-500" style="color: #e11d48;">proyecto</span>
                </h1>

                <p class="contact-hero__subtitle" style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 0 auto 1rem; font-size: 1.125rem;">
                    Rellena el formulario o escríbenos por WhatsApp.<br />
                    Te respondemos en menos de 24 horas.
                </p>

                <div class="contact-hero__buttons" style="justify-content: center;">
                    <a href={whatsappHref} target="_blank" rel="noopener" data-ga-event="whatsapp_click" data-ga-method="contact_hero_whatsapp" class="contact-hero__btn contact-hero__btn--primary" style="background: #e11d48; color: white; border: none; box-shadow: 0 4px 6px -1px rgba(225, 29, 72, 0.4);">
                        <svg fill="currentColor" class="w-5 h-5 mr-2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/>
                            <path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 005.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89A11.82 11.82 0 0012.05 0zm0 21.79h-.01a9.87 9.87 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88z"/>
                        </svg>
                        WhatsApp directo
                    </a>
                    <button type="button" class="contact-hero__btn contact-hero__btn--secondary js-scroll-form" style="background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2);">
                        <svg fill="none" class="w-5 h-5 mr-2" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                        Ir al formulario
                    </button>
                </div>
            </div>
        </section>
    ) : (
        <section class="contact-hero mb-0 hidden">
            <div class="contact-hero__glow"></div>

            <div class="section-container contact-hero__inner">
                <div class="contact-hero__badge">
                    <span class="contact-hero__badge-dot"></span>
                    <span>Hablemos</span>
                </div>

                <h1 class="contact-hero__title">
                    Cuéntanos tu <span class="contact-hero__title--accent">proyecto</span>
                </h1>

                <p class="contact-hero__subtitle">
                    Rellena el formulario o escríbenos por WhatsApp.<br />
                    Te respondemos en menos de 24 horas.
                </p>

                <div class="contact-hero__buttons">
                    <a href={whatsappHref} target="_blank" rel="noopener" data-ga-event="whatsapp_click" data-ga-method="contact_hero_whatsapp" class="contact-hero__btn contact-hero__btn--primary">
                        <svg fill="currentColor" stroke="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/>
                            <path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 005.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89A11.82 11.82 0 0012.05 0zm0 21.79h-.01a9.87 9.87 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88z"/>
                        </svg>
                        WhatsApp directo
                    </a>
                    <!-- Scroll to form btn -->
                    <button type="button" class="contact-hero__btn contact-hero__btn--secondary js-scroll-form">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                        Ir al formulario
                    </button>
                </div>
            </div>
        </section>
        <style is:global>
            body, main { background-color: #ffffff !important; }
            .navbar { background: transparent !important; border: none !important; }
            .nav-link { color: #6b7280 !important; font-weight: 500; }
            .nav-link:hover, .nav-link.active { color: #111111 !important; }
            #nav-logo-white { opacity: 0 !important; }
            #nav-logo-dark { opacity: 1 !important; }
            #nav-cta { color: #111111 !important; border-color: rgba(0,0,0,0.12) !important; background: rgba(0,0,0,0.04) !important; }
            .hamburger-line { background: #111111 !important; }
        </style>
    )}

    <!-- ═══════════════════════════════════════════
         FORM + SIDEBAR
    ═══════════════════════════════════════════ -->
    <style>
        .contact-video-bg__iframe {
            opacity: 0;
            animation: contactVideoReveal 0.45s ease 5.8s forwards;
        }

        @keyframes contactVideoReveal {
            to { opacity: 1; }
        }
    </style>

    <style is:global>
        body, main { background-color: #ffffff !important; }
        .contact-hero { display: none !important; }
        #faq-section { min-height: auto !important; padding-top: 3rem !important; }
    </style>

    <section class="contact-body contact-body--first">
        <div class="contact-body__bg-dots"></div>

        <div class="section-container contact-body__grid">

            <!-- LEFT: Form -->
            <div class="contact-form-wrap">
                <form id="contact-form" class="contact-form" novalidate>

                    <div class="contact-form__row">
                        <div class="contact-form__field">
                            <label for="contact-name" class="contact-form__label">Nombre *</label>
                            <input type="text" id="contact-name" name="name" required
                                   class="contact-form__input" placeholder="Tu nombre completo" />
                        </div>
                        <div class="contact-form__field">
                            <label for="contact-email" class="contact-form__label">Email *</label>
                            <input type="email" id="contact-email" name="email" required
                                   class="contact-form__input" placeholder="tu@empresa.com" />
                        </div>
                    </div>

                    <div class="contact-form__row">
                        <div class="contact-form__field">
                            <label for="contact-phone" class="contact-form__label">Teléfono</label>
                            <input type="tel" id="contact-phone" name="phone"
                                   class="contact-form__input" placeholder="+34 600 000 000" />
                        </div>
                        <div class="contact-form__field">
                            <label for="contact-company" class="contact-form__label">Empresa</label>
                            <input type="text" id="contact-company" name="company"
                                   class="contact-form__input" placeholder="Nombre de tu empresa" />
                        </div>
                    </div>

                    <div class="contact-form__field">
                        <label for="contact-message" class="contact-form__label">Mensaje *</label>
                        <textarea id="contact-message" name="message" required rows="6"
                                  class="contact-form__input contact-form__textarea"
                                  placeholder="Cuéntanos sobre tu proyecto: qué necesitas, plazos, presupuesto aproximado..."></textarea>
                    </div>

                    <div class="contact-form__field contact-form__field--trap" aria-hidden="true">
                        <label for="contact-website" class="contact-form__label">Web</label>
                        <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
                    </div>

                    <input type="hidden" name="captchaToken" value={captcha.token} />
                    <input type="hidden" name="formStartedAt" value={captcha.startedAt} />

                    <div class="contact-form__field">
                        <label for="contact-captcha" class="contact-form__label">Captcha *</label>
                        <div class="contact-form__captcha">
                            <img src={captcha.image} alt="Captcha de seguridad" width="190" height="62" />
                            <input type="text" id="contact-captcha" name="captchaAnswer" required
                                   class="contact-form__input" inputmode="text" autocomplete="off"
                                   autocapitalize="characters" maxlength="6" placeholder="Escribe el código" />
                        </div>
                    </div>

                    <div id="form-status" class="contact-form__status hidden"></div>

                    <button type="submit" id="contact-submit" class="contact-form__submit">
                        <span>Enviar mensaje</span>
                        <svg class="contact-form__submit-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                        </svg>
                    </button>

                </form>
            </div>

            <!-- RIGHT: Sidebar -->
            <aside class="contact-sidebar">

                <!-- WhatsApp -->
                <a
                    href={`https://wa.me/${settings.whatsapp_number?.replace(/[^0-9]/g, '')}?text=Hola,%20me%20gustaría%20saber%20más%20sobre%20vuestros%20servicios%20de%20video%20marketing.`}
                    target="_blank"
                    rel="noopener"
                    data-ga-event="whatsapp_click"
                    data-ga-method="whatsapp"
                    class="contact-card contact-card--wa"
                >
                    <div class="contact-card__icon contact-card__icon--wa">
                        <svg class="contact-card__icon-svg" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="contact-card__title">¿Prefieres WhatsApp?</h3>
                        <p class="contact-card__text">Escríbenos directamente y te respondemos al instante.</p>
                        <span class="contact-card__link contact-card__link--wa">
                            Abrir WhatsApp
                            <svg class="contact-card__link-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </span>
                    </div>
                </a>

                <!-- Info -->
                <div class="contact-card">
                    <h3 class="contact-card__title contact-card__title--info">Información de contacto</h3>
                    <ul class="contact-info-list">
                        {settings.address && (
                            <li class="contact-info-list__item">
                                <svg class="contact-info-list__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                <span>{settings.address}</span>
                            </li>
                        )}
                        {settings.phone && (
                            <li class="contact-info-list__item">
                                <svg class="contact-info-list__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                <a href={`tel:${settings.phone}`} data-ga-event="phone_click" data-ga-method="phone">{settings.phone}</a>
                            </li>
                        )}
                        {settings.email && (
                            <li class="contact-info-list__item">
                                <svg class="contact-info-list__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <span>{settings.email}</span>
                            </li>
                        )}
                    </ul>
                </div>

                <!-- Trust badges -->
                <div class="contact-trust">
                    <div class="contact-trust__item">
                        <svg class="contact-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>Respuesta en menos de 24h</span>
                    </div>
                    <div class="contact-trust__item">
                        <svg class="contact-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>Presupuesto sin compromiso</span>
                    </div>
                    <div class="contact-trust__item">
                        <svg class="contact-trust__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span>Primera consulta gratuita</span>
                    </div>
                </div>

            </aside>
        </div>
    </section>

    <!-- ═══ FAQ SECTION ═══ -->
    <FaqsSection />

</BaseLayout>

<link rel="stylesheet" href="/src/styles/contacto.css" />

<script>
    // ── Contact form ──
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status")!;
    const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.querySelector("span")!.textContent = "Enviando...";

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
            const res = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            });

            if (res.ok) {
                (window as any).vmTrackEvent?.('generate_lead', { method: 'contact_form' });
                status.textContent = "✅ ¡Mensaje enviado con éxito! Te responderemos pronto.";
                status.className = "contact-form__status contact-form__status--success";
                form.reset();
            } else {
                const payload = await res.json().catch(() => null);
                throw new Error(payload?.error || "Error sending");
            }
        } catch (error) {
            status.textContent = "❌ Error al enviar. Intenta de nuevo o contáctanos por WhatsApp.";
            status.className = "contact-form__status contact-form__status--error";
        }

        submitBtn.disabled = false;
        submitBtn.querySelector("span")!.textContent = "Enviar mensaje";
    });


    document.querySelector('.js-scroll-form')?.addEventListener('click', () => {
        document.querySelector('.contact-body')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
</script>

<script>
    /* ── Fullpage Scroll Effect ── */
    document.addEventListener('DOMContentLoaded', () => {
        return;

        const sections = Array.from(document.querySelectorAll('section'));
        if (sections.length === 0) return;

        // Solo activar scroll snap en escritorio (>1024px)
        if (window.innerWidth <= 1024) return;

        let isScrolling = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;

        function getVisibleSectionIndex() {
            let maxVisibleIndex = 0;
            let maxVisibleArea = 0;

            sections.forEach((sec, idx) => {
                const rect = sec.getBoundingClientRect();
                const visibleHeight = Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0));
                if (visibleHeight > maxVisibleArea) {
                    maxVisibleArea = visibleHeight;
                    maxVisibleIndex = idx;
                }
            });
            return maxVisibleIndex;
        }

        function scrollToSection(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;

            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });

            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                isScrolling = false;
            }, 1300);
        }

        window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;

            const currentIndex = getVisibleSectionIndex();
            if (e.deltaY > 0) {
                scrollToSection(currentIndex + 1);
            } else if (e.deltaY < 0) {
                scrollToSection(currentIndex - 1);
            }
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => {
            touchStartY = e.changedTouches[0].screenY;
        }, { passive: false });

        window.addEventListener('touchmove', (e) => {
            e.preventDefault();
        }, { passive: false });

        window.addEventListener('touchend', (e) => {
            if (isScrolling) return;

            const touchEndY = e.changedTouches[0].screenY;
            const deltaY = touchStartY - touchEndY;
            const currentIndex = getVisibleSectionIndex();

            if (deltaY > 50) {
                scrollToSection(currentIndex + 1);
            } else if (deltaY < -50) {
                scrollToSection(currentIndex - 1);
            }
        }, { passive: false });

        window.addEventListener('keydown', (e) => {
            // Ignore space and arrows when focused on form elements
            if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement).tagName)) {
                return;
            }

            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const currentIndex = getVisibleSectionIndex();
                if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
                    scrollToSection(currentIndex + 1);
                } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
                    scrollToSection(currentIndex - 1);
                } else if (e.key === 'Home') {
                    scrollToSection(0);
                } else if (e.key === 'End') {
                    scrollToSection(sections.length - 1);
                }
            }
        }, { passive: false });

        // Hero Buttons Logic
        const btnScrollForm = document.querySelector('.js-scroll-form');

        if (btnScrollForm) {
            btnScrollForm.addEventListener('click', () => {
                scrollToSection(1); // Scrolls to the form section
            });
        }
    });
</script>
