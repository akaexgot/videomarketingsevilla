---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/data";
import { getMailtoHref } from "../lib/contact";

const settings = await getSettings();
const emailHref = getMailtoHref(settings.email);
---

<BaseLayout
    title="Aviso Legal"
    description="Aviso legal de VideoMarketing Sevilla. Información corporativa y condiciones de uso."
>
    <section class="pt-32 pb-24">
        <div class="section-container">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-[Outfit] font-bold text-white mb-8">
                    Aviso Legal
                </h1>
                <div
                    class="prose prose-invert prose-sm text-light-muted leading-relaxed space-y-6"
                >
                    <p>Última actualización: Marzo 2024</p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        1. Datos del titular
                    </h2>
                    <p>
                        <strong class="text-white"
                            >{settings.site_name}</strong
                        ><br />
                        Dirección: {settings.address}<br />
                        Email: <a href={emailHref}>{settings.email}</a>
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        2. Objeto
                    </h2>
                    <p>
                        El presente sitio web tiene como finalidad dar a conocer
                        los servicios de producción audiovisual de
                        VideoMarketing Sevilla.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        3. Propiedad intelectual
                    </h2>
                    <p>
                        Todos los contenidos de este sitio web (textos,
                        imágenes, vídeos, logotipos) son propiedad de
                        VideoMarketing Sevilla o de sus respectivos autores, y
                        están protegidos por las leyes de propiedad intelectual.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        4. Limitación de responsabilidad
                    </h2>
                    <p>
                        VideoMarketing Sevilla no se hace responsable de los
                        posibles daños derivados del uso de este sitio web.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        5. Legislación aplicable
                    </h2>
                    <p>
                        Las presentes condiciones se rigen por la legislación
                        española.
                    </p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
