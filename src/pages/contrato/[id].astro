---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getServiceSupabase } from "../../lib/supabase";
import { INVOICE_CLIENT_FIELDS } from "../../lib/contracts";
import { getMailtoHref, getTelHref, getWhatsappHref } from "../../lib/contact";

const { id } = Astro.params;
const supabase = getServiceSupabase();

let contract: any = null;
let template: any = null;
let settings: any = null;
let error = null;

if (supabase && id) {
    const { data: cData, error: cError } = await supabase
        .from('contracts')
        .select('*, contract_templates(*)')
        .eq('id', id)
        .maybeSingle();

    if (cError || !cData) {
        error = "Contrato no encontrado o enlace expirado.";
    } else if (cData.status === 'completed' || cData.status === 'paid') {
        contract = cData;
        template = cData.contract_templates;
    } else {
        contract = cData;
        template = cData.contract_templates;
    }

    const { data: sData } = await supabase.from('settings').select('*').maybeSingle();
    settings = sData;
} else {
    error = "Error de conexión con el servidor.";
}

// Prepare merged data for initial preview
const initialData = { ...contract?.admin_data, ...contract?.client_data };
const fiscalFieldLabels = Object.fromEntries(INVOICE_CLIENT_FIELDS.map((field) => [field.key, field.label]));
const invoiceFieldKeys = INVOICE_CLIENT_FIELDS.map((field) => field.key);
const templateClientFields = template?.client_fields || [];
const requiredClientFields = contract?.is_billable
    ? [...new Set([...templateClientFields, ...invoiceFieldKeys])]
    : templateClientFields;
const hasClientDataStep = requiredClientFields.length > 0;
const paymentStatus = contract?.payment_status || 'unpaid';
const isAwaitingAsyncPayment = paymentStatus === 'pending' || paymentStatus === 'processing';
const phoneHref = getTelHref(settings?.phone);
const emailHref = getMailtoHref(settings?.email);
const supportWhatsappHref = getWhatsappHref(settings?.whatsapp_number, `Hola, tengo una duda con el contrato num ${contract?.id}`);
---

<BaseLayout
    title="Firma de Contrato | VideoMarketing Sevilla"
    noindex={true}
    description="Portal seguro de firma de contratos y gestión de pagos."
>
    <section class="contract-body">
        <div class="contract-bg-dots"></div>

        <div class="section-container contract-body__grid">
            <!-- MAIN COLUMN -->
            <div class="contract-main-col">
                {error ? (
                    <div class="card error-card">
                        <div class="error-icon">
                            <svg fill="none" class="w-12 h-12 mx-auto" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        </div>
                        <h2 class="error-title">{error}</h2>
                        <p class="error-text">Si crees que esto es un error o el enlace ha caducado, contacta con nosotros.</p>
                        <a href="/" class="btn-back">Volver a Inicio</a>
                    </div>
                ) : (
                    <div class="card main-card">
                        <div class="card-header">
                            <div class="header-pre">VideoMarketing Sevilla</div>
                            <h1 class="header-title">Finalización de Contrato</h1>
                            <p class="header-desc">Sigue los pasos secuenciales para formalizar tu proyecto con nosotros de forma segura.</p>
                        </div>

                        <div class="step-indicator" id="stepper">
                            <div class="step active" data-step="0"><span>Info</span></div>
                            <div class={`step ${hasClientDataStep ? '' : 'step--hidden'}`} data-step="1"><span>{contract?.is_billable ? 'Fiscal' : 'Datos'}</span></div>
                            <div class="step" data-step="2"><span>Firma</span></div>
                            <div class={`step ${contract?.is_billable ? '' : 'step--hidden'}`} data-step="3"><span>Pago</span></div>
                        </div>

                        <div class="card-body">
                            <!-- STEP 0: EMAIL & PHONE -->
                            <div id="step-0" class="active-step">
                                <div class="form-grid">
                                    <h3 class="step-title">Tus datos de contacto</h3>
                                    <p class="step-desc">Necesitamos estos datos para enviarte la copia firmada del contrato automáticamente.</p>
                                    
                                    <div class="input-group">
                                        <label class="field-label">Correo Electrónico *</label>
                                        <input type="email" id="c-email" value={contract?.client_email || ''} class="client-auth-input" />
                                    </div>
                                    <div class="input-group">
                                        <label class="field-label">Teléfono de Contacto *</label>
                                        <input type="tel" id="c-phone" value={contract?.client_phone || ''} class="client-auth-input" />
                                    </div>
                                    
                                    <button class="btn-primary" id="go-to-step-1">
                                        {contract?.is_billable ? 'Continuar a datos fiscales' : 'Continuar a revisión'}
                                    </button>
                                    
                                    <div class="trust-info-minimal">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                        Tus datos están protegidos y solo se usarán para la gestión de este contrato.
                                    </div>
                                </div>
                            </div>

                            <!-- STEP 1: FISCAL INFO -->
                            <div id="step-1" style="display: none;">
                                <div class="form-grid">
                                    <h3 class="step-title">{contract?.is_billable ? 'Datos fiscales para factura' : 'Datos legales'}</h3>
                                    <p class="step-desc">
                                        {contract?.is_billable
                                            ? 'Estos datos son necesarios para emitir la factura del pago y completar el contrato.'
                                            : 'Introduce la información legal que aparecerá en el contrato.'}
                                    </p>
                                    
                                    {requiredClientFields.map((field: string) => (
                                        <div class="input-group">
                                            <label class="field-label field-label--with-badge">
                                                <span>{fiscalFieldLabels[field] || field.replace(/_/g, ' ')} *</span>
                                                {invoiceFieldKeys.includes(field) && (
                                                    <span class="invoice-field-badge">Factura</span>
                                                )}
                                            </label>
                                            <input type="text" class="client-data-input" data-field={field} value={contract?.client_data?.[field] || ''} />
                                        </div>
                                    ))}
                                    
                                    <div class="flex-actions">
                                        <button class="btn-secondary" id="back-to-step-0">Volver</button>
                                        <button class="btn-primary" id="go-to-step-2">Revisar y Continuar</button>
                                    </div>
                                </div>
                            </div>

                            <!-- STEP 2: REVIEW & SIGN -->
                            <div id="step-2" style="display: none;">
                                <h3 class="step-title">Revisión del documento</h3>
                                <div class="contract-review-box" id="contract-preview">
                                    <!-- HTML injected here -->
                                </div>

                                <div class="sign-section">
                                    <h3 class="step-title">Aceptación y Firma</h3>
                                    
                                    <div class="terms-check-wrapper" style="margin-bottom: 2rem;">
                                        <label class="terms-label" id="terms-label-element">
                                            <input type="checkbox" id="terms-accept" class="terms-checkbox" />
                                            <span class="terms-text" style="color: #18181b;">
                                                <strong>Acepto:</strong> {settings?.contract_terms_text || 'Acepto los términos y condiciones del servicio y autorizo la firma digital de este documento.'}
                                            </span>
                                        </label>
                                    </div>

                                    <div class="signature-container">
                                        <p class="signature-hint">Utiliza el dedo o el ratón para firmar dentro del recuadro.</p>
                                        <div class="signature-canvas-wrap">
                                            <canvas id="signature-pad"></canvas>
                                        </div>
                                        <button class="btn-clear-sig" id="clear-sig">Limpiar firma</button>
                                    </div>

                                    <div class="flex-actions" style="margin-top: 2rem;">
                                        <button class="btn-secondary" id="back-to-step-1">Editar datos</button>
                                        <div style="flex: 2; position: relative;">
                                            <button class="btn-primary" id="btn-submit-signature" disabled>
                                                {contract?.is_billable ? 'Firmar y proceder al pago' : 'Firmar y Finalizar'}
                                            </button>
                                            <p id="signature-warning" style="color: #e11d48; font-size: 0.75rem; text-align: center; margin-top: 0.75rem; font-weight: 600;">
                                                Debes firmar y aceptar los términos
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- STEP 3: PAYMENT / SUCCESS -->
                            <div id="step-3" style="display: none;">
                                <div class="success-screen">
                                    {contract?.is_billable && contract.status !== 'completed' && contract.status !== 'paid' ? (
                                        <div id="payment-checkout-box" class="w-full">
                                            <h2 class="success-title">Firma Guardada</h2>
                                            <p class="final-desc">
                                                {isAwaitingAsyncPayment
                                                    ? 'Tu pago esta pendiente de confirmacion. Si elegiste transferencia, sigue las instrucciones bancarias de Stripe.'
                                                    : 'Tu firma se ha registrado correctamente. Solo falta completar el pago inicial para finalizar.'}
                                            </p>
                                            
                                            <div class="payment-card">
                                                <p class="payment-desc">Depósito inicial a abonar:</p>
                                                <div class="payment-amount">{contract?.amount_to_pay}€</div>
                                                
                                                <div class="trust-badges">
                                                    <div class="badge">
                                                        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                                        <span>Tarjeta, Bizum, Klarna o transferencia</span>
                                                    </div>
                                                    <div class="badge">
                                                        <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                                                        <span>Stripe Secured</span>
                                                    </div>
                                                </div>

                                                <button class="btn-primary btn-pay" id="btn-pay">
                                                    Proceder al pago seguro
                                                </button>
                                                <div class="bank-transfer-note">
                                                    <strong>Transferencia bancaria por Stripe</strong>
                                                    <span>Dentro de Stripe, selecciona transferencia bancaria, copia el IBAN y la referencia que te indique, y realiza la transferencia desde tu banco. La confirmacion puede tardar de 1 a 2 dias laborables; enviaremos contrato y factura cuando Stripe confirme el cobro.</span>
                                                </div>
                                                <p class="security-info">Tus datos bancarios nunca se guardan en nuestros servidores. Puedes pagar con tarjeta, Apple Pay, Link, Bizum, Klarna o transferencia bancaria desde Stripe.</p>
                                            </div>
                                        </div>

                                        <div id="payment-success-msg" style="display:none;" class="w-full">
                                            <div class="final-success">
                                                <h2 class="success-title">Pago pendiente de confirmacion</h2>
                                                <p class="final-desc">Stripe ha registrado la operacion. Si has elegido transferencia, revisa el email/instrucciones de Stripe y realiza el pago con el IBAN y referencia indicados. La confirmacion suele tardar de 1 a 2 dias laborables; enviaremos contrato y factura cuando Stripe confirme el cobro.</p>
                                                
                                                <div class="success-icon">
                                                    <svg class="w-20 h-20 text-amber-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"/></svg>
                                                </div>

                                                <div class="success-actions">
                                                    <a href="/" class="btn-primary success-home-link">Volver al sitio web</a>
                                                    <div class="success-downloads">
                                                        {contract.pdf_url && (
                                                            <a href={contract.pdf_url} target="_blank" class="btn-secondary download-button">
                                                                Descargar Contrato (PDF)
                                                            </a>
                                                        )}
                                                        {contract.invoice_url && (
                                                            <a href={contract.invoice_url} target="_blank" class="btn-secondary download-button">
                                                                Descargar Factura
                                                            </a>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    ) : (
                                        <div class="final-success">
                                            <h2 class="success-title">Contrato Firmado</h2>
                                            <p class="final-desc">
                                                {contract.status === 'completed' || contract.status === 'paid' 
                                                    ? '¡Gracias! El contrato ya ha sido firmado y procesado correctamente.' 
                                                    : 'El proceso se ha completado correctamente. En breve recibirás una copia en tu correo electrónico.'}
                                            </p>

                                            <div class="success-icon">
                                                <svg class="w-20 h-20 text-emerald-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                            </div>

                                            <p class="text-xs text-zinc-400 mt-2 mb-8">
                                                Enviado a: {contract?.client_email || 'Tu bandeja de entrada'}
                                            </p>
                                            
                                            <div class="success-actions">
                                                <a href="/" class="btn-primary success-home-link">Volver al sitio web</a>
                                                <div class="success-downloads">
                                                    {contract.pdf_url && (
                                                        <a href={contract.pdf_url} target="_blank" class="btn-secondary download-button">
                                                            Descargar Contrato (PDF)
                                                        </a>
                                                    )}
                                                    {contract.invoice_url && (
                                                        <a href={contract.invoice_url} target="_blank" class="btn-secondary download-button">
                                                            Descargar Factura
                                                        </a>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>

            <!-- SIDEBAR COLUMN -->
            <aside class="contract-sidebar">
                <!-- WhatsApp Card -->
                <a
                    href={supportWhatsappHref}
                    target="_blank"
                    rel="noopener"
                    data-ga-event="whatsapp_click"
                    data-ga-method="whatsapp"
                    class="support-card support-card--wa"
                >
                    <div class="support-card__icon support-card__icon--wa">
                        <svg fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    </div>
                    <div>
                        <h4 class="support-card__title">¿Necesitas ayuda?</h4>
                        <p class="support-card__text">Escríbenos por WhatsApp y resolvemos tus dudas al instante.</p>
                    </div>
                </a>

                <!-- Contact Details -->
                <div class="sidebar-info-card">
                    <h4 class="sidebar-info-card__title">Contacto Directo</h4>
                    <ul class="sidebar-contact-list">
                        <li>
                            <svg fill="none" class="w-4 h-4 text-carmin" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <a href={emailHref}>{settings.email}</a>
                        </li>
                        <li>
                            <svg fill="none" class="w-4 h-4 text-carmin" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <a href={phoneHref} data-ga-event="phone_click" data-ga-method="phone">{settings.phone}</a>
                        </li>
                    </ul>
                </div>

                <!-- Trust Badges Sidebar -->
                <div class="sidebar-trust-box">
                    <div class="trust-item">
                        <div class="trust-item__icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        </div>
                        <div>
                            <h5>Firma Certificada</h5>
                            <p>Proceso legalmente vinculante con trazabilidad completa.</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-item__icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        </div>
                        <div>
                            <h5>Seguridad de Pago</h5>
                            <p>Tus datos bancarios nunca se almacenan en nuestros sistemas.</p>
                        </div>
                    </div>
                    <div class="trust-item">
                        <div class="trust-item__icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <h5>Soporte 24/7</h5>
                            <p>Si tienes problemas, nuestro asistente IA o equipo humano te ayudarán.</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    <style>
        .contract-body {
            position: relative;
            min-height: 100vh;
            background: #000;
            padding: 8rem 0 6rem;
            overflow: hidden;
        }
        .contract-bg-dots {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 32px 32px;
            pointer-events: none;
        }
        .contract-body__grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            position: relative;
            z-index: 10;
        }
        @media (min-width: 1024px) {
            .contract-body__grid {
                grid-template-columns: 3fr 1.3fr;
                gap: 4rem;
                align-items: start;
            }
        }

        .card { background: #ffffff; border: 1px solid #e4e4e7; border-radius: 2rem; overflow: hidden; box-shadow: 0 40px 80px -15px rgba(0,0,0,0.5); position: relative; z-index: 20; pointer-events: auto; }
        .card-header { padding: 3.5rem 3rem 2.5rem; border-bottom: 1px solid #f4f4f5; text-align: center; background: #fafafa; }
        .header-pre { color: #e11d48; font-family: 'Inter', monospace; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 0.75rem; }
        .header-title { font-family: 'Outfit', sans-serif; font-size: 2.25rem; font-weight: 800; color: #09090b; margin: 0; line-height: 1.1; }
        .header-desc { color: #71717a; font-size: 0.95rem; margin-top: 1rem; max-width: 500px; margin-inline: auto; line-height: 1.6; }

        .step-indicator { display: flex; justify-content: center; gap: 0.75rem; margin: 2rem 0; padding: 0 3rem; }
        .step { flex: 1; height: 3px; background: #f4f4f5; border-radius: 2px; position: relative; transition: all 0.4s ease; }
        .step--hidden { display: none; }
        .step span { position: absolute; top: -1.25rem; left: 0; font-size: 0.6rem; text-transform: uppercase; color: #a1a1aa; font-weight: 700; letter-spacing: 0.05em; }
        .step.active { background: #e11d48; box-shadow: 0 5px 15px rgba(225, 29, 72, 0.3); }
        .step.active span { color: #e11d48; }

        .card-body { padding: 3rem; color: #18181b; position: relative; z-index: 2; }
        
        .step-title { font-family: 'Outfit', sans-serif; font-size: 1.5rem; color: #09090b; margin-bottom: 0.5rem; }
        .step-desc { color: #71717a; font-size: 0.9rem; margin-bottom: 2rem; line-height: 1.6; }
        
        .form-grid { display: flex; flex-direction: column; gap: 1.5rem; max-width: 100%; position: relative; z-index: 3; }
        .input-group { display: flex; flex-direction: column; gap: 0.4rem; position: relative; z-index: 4; }
        .field-label { font-size: 0.7rem; text-transform: uppercase; color: #71717a; font-weight: 700; letter-spacing: 0.05em; }
        .field-label--with-badge { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
        .invoice-field-badge { display: inline-flex; align-items: center; border-radius: 999px; background: #ffe4e6; color: #be123c; padding: 0.18rem 0.5rem; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.04em; }
        
        input { width: 100%; padding: 0.875rem 1.25rem; background: #fafafa; border: 1.5px solid #e4e4e7; border-radius: 0.75rem; color: #09090b; font-size: 0.95rem; transition: all 0.2s; box-sizing: border-box; position: relative; z-index: 5; pointer-events: auto; user-select: text; }
