        .btn-primary:hover { background: #f43f5e; transform: translateY(-2px); box-shadow: 0 15px 25px -5px rgba(225, 29, 72, 0.4); }
        .btn-primary:disabled { opacity: 0.3; cursor: not-allowed; transform: none; box-shadow: none; }

        .btn-secondary { background: #f4f4f5; color: #71717a; border: 1px solid #e4e4e7; padding: 1.125rem; border-radius: 1rem; font-weight: 700; cursor: pointer; transition: all 0.2s; }
        .btn-secondary:hover { background: #e4e4e7; color: #18181b; }
