        .sign-section { border-top: 1px solid #f4f4f5; padding-top: 3rem; }
        .terms-check-wrapper { margin-bottom: 2rem; background: #fafafa; padding: 1.5rem; border-radius: 1rem; border: 1px solid #e4e4e7; }
        .terms-label { display: flex; gap: 1rem; cursor: pointer; align-items: flex-start; }
        .terms-label input { width: 1.25rem; height: 1.25rem; accent-color: #e11d48; margin-top: 0.2rem; }
        .terms-text { font-size: 0.85rem; color: #3f3f46; line-height: 1.5; }

        .signature-container { margin-bottom: 3rem; display: flex; flex-direction: column; gap: 0.75rem; }
        .signature-hint { font-size: 0.8rem; color: #71717a; margin-bottom: 1rem; text-align: center; }
        .signature-canvas-wrap { background: #fdfdfd; border: 1px solid #e4e4e7; border-radius: 1.5rem; position: relative; overflow: hidden; height: 250px; z-index: 4; pointer-events: auto; touch-action: none; }
        canvas { width: 100%; height: 100%; min-height: 250px; touch-action: none; cursor: crosshair; display: block; position: relative; z-index: 5; pointer-events: auto; }
        .btn-clear-sig { align-self: flex-end; background: #fff; border: 1px solid #e4e4e7; color: #71717a; padding: 0.55rem 0.95rem; font-size: 0.75rem; font-weight: 700; border-radius: 0.5rem; cursor: pointer; pointer-events: auto; }

        /* Sidebar Styles */
        .contract-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
        .support-card { background: #09090b; border: 1px solid #1a1a1c; border-radius: 1.5rem; padding: 1.5rem; display: flex; gap: 1rem; align-items: center; text-decoration: none; transition: all 0.3s; }
        .support-card--wa:hover { border-color: #25D366; box-shadow: 0 0 20px rgba(37,211,102,0.1); }
        .support-card__icon { width: 3rem; height: 3rem; border-radius: 1rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .support-card__icon--wa { background: rgba(37,211,102,0.1); color: #25D366; }
        .support-card__icon svg { width: 1.5rem; height: 1.5rem; }
        .support-card__title { font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 700; color: #fff; margin: 0; }
        .support-card__text { font-size: 0.8rem; color: #71717a; line-height: 1.4; margin: 0.25rem 0 0; }

        .sidebar-info-card { background: #09090b; border: 1px solid #1a1a1c; border-radius: 1.5rem; padding: 1.5rem; }
        .sidebar-info-card__title { font-family: 'Outfit', sans-serif; font-size: 0.9rem; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.25rem; }
        .sidebar-contact-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
        .sidebar-contact-list li { display: flex; align-items: center; gap: 0.75rem; color: #a1a1aa; font-size: 0.85rem; }
        .text-carmin { color: #e11d48; }

        .sidebar-trust-box { display: flex; flex-direction: column; gap: 1.25rem; padding: 0.5rem; }
        .trust-item { display: flex; gap: 1rem; align-items: flex-start; }
