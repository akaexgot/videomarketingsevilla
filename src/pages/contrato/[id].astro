        .trust-item__icon svg { width: 0.9rem; height: 0.9rem; }
        .trust-item h5 { font-size: 0.85rem; font-weight: 700; color: #e4e4e7; margin: 0; }
        .trust-item p { font-size: 0.75rem; color: #71717a; line-height: 1.4; margin: 0.2rem 0 0; }

        .success-screen { text-align: center; }
        .success-title { font-family: 'Outfit', sans-serif; font-size: 2.5rem; font-weight: 800; color: #09090b; }
        .final-desc { color: #71717a; font-size: 1.1rem; line-height: 1.6; }
        .payment-card { background: #fafafa; border: 1px solid #e4e4e7; border-radius: 1.5rem; padding: 2.5rem; margin-top: 1.5rem; }
        .bank-transfer-note { display: flex; flex-direction: column; gap: 0.35rem; margin: 1rem 0; padding: 1rem; border: 1px solid #fbbf24; border-radius: 1rem; background: #fffbeb; color: #78350f; text-align: left; font-size: 0.85rem; line-height: 1.5; }
        .bank-transfer-note strong { color: #92400e; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
        .payment-amount { font-family: 'Outfit', sans-serif; font-size: 3.5rem; font-weight: 800; color: #09090b; }
        .trust-badges { display: flex; justify-content: center; gap: 1.5rem; margin: 1.5rem 0; opacity: 0.7; }
        .badge { display: flex; align-items: center; gap: 0.4rem; font-size: 0.65rem; color: #71717a; font-weight: 700; text-transform: uppercase; }
        .success-actions { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; margin-top: 2rem; position: relative; z-index: 3; }
        .success-home-link { width: min(100%, 620px); padding-inline: 4rem; }
        .success-downloads { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; width: 100%; }
        .download-button { border-color: #27272a; width: auto; min-width: 220px; background: #09090b; color: #fff; text-align: center; }

        .error-card { background: #09090b; border-color: #1a1a1c; padding: 5rem 2rem; color: #fff; }
        .error-title { font-family: 'Outfit', sans-serif; font-size: 1.75rem; margin-bottom: 0.5rem; }
        .error-text { color: #52525b; margin-bottom: 2rem; }
        .btn-back { display: inline-block; background: #e11d48; color: #fff; padding: 1rem 2rem; border-radius: 1rem; text-decoration: none; font-weight: 700; }

        @media (max-width: 768px) {
            .contract-body { padding-top: 6rem; }
            .card-header { padding: 2.5rem 1.5rem; }
            .card-body { padding: 1.5rem; }
            .flex-actions { grid-template-columns: 1fr; }
            .contract-review-box { padding: 2rem 1.5rem; }
            .header-title { font-size: 1.75rem; }
            .payment-amount { font-size: 3rem; }
        }
    </style>


    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
    <script define:vars={{ contract, template, id, hasClientDataStep }}>
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        const $ = (id) => document.getElementById(id);
        const urlParams = new URLSearchParams(window.location.search);
        const steps = ['step-0', 'step-1', 'step-2', 'step-3'];
        let currentStep = 0;
        let signaturePad = null;
        let resizeSignatureCanvas = () => {};

        if (hasClientDataStep && !contract.is_billable) {
            const nextButton = $('go-to-step-1');
            if (nextButton) nextButton.textContent = 'Continuar a tus datos';
        }

        function setStep(n, options = {}) {
            const { scroll = true } = options;
            currentStep = n;
            steps.forEach((s, idx) => {
                const el = $(s);
                if (el) el.style.display = (idx === n) ? 'block' : 'none';
                
                const stepEl = document.querySelector(`.step[data-step="${idx}"]`);
                if (stepEl) {
                    if (idx <= n) stepEl.classList.add('active');
                    else stepEl.classList.remove('active');
                }
            });
            if (scroll) {
                window.scrollTo({ top: 100, behavior: 'smooth' });
            }
        }

        function replaceVariables(text, data) {
            let result = text;
            for (const [key, value] of Object.entries(data)) {
                const regex = new RegExp(`{{${key}}}`, 'g');
                result = result.replace(regex, value?.toString() || '<span style="color: #e11d48; border-bottom: 2px dashed #e11d48;">[?]</span>');
            }
            return result;
        }

        // STEP 0 -> STEP 1
        $('go-to-step-1')?.addEventListener('click', () => {
            const email = $('c-email').value.trim();
            const phone = $('c-phone').value.trim();

            if (!email || !email.includes('@')) { $('c-email').focus(); return; }
            if (!phone || phone.length < 9) { $('c-phone').focus(); return; }

            if (!hasClientDataStep) {
                $('go-to-step-2')?.click();
                return;
            }

            setStep(1);
        });

        // STEP 1 -> STEP 2
        $('go-to-step-2')?.addEventListener('click', () => {
            const inputs = document.querySelectorAll('.client-data-input');
            const clientData = {};
            let valid = true;
            inputs.forEach(i => {
                if (!i.value.trim()) { i.style.borderColor = '#e11d48'; valid = false; }
                else { i.style.borderColor = ''; clientData[i.dataset.field] = i.value.trim(); }
            });

            if (!valid) return;

            // Prepare preview
            const merged = { 
                ...contract.admin_data, 
                ...clientData,
                CLIENT_EMAIL: $('c-email').value.trim(),
                CLIENT_PHONE: $('c-phone').value.trim()
            };
            $('contract-preview').innerHTML = replaceVariables(template.content, merged);
            
            setStep(2);

            // Re-trigger resize now that it's visible
            setTimeout(() => {
                if (signaturePad) resizeSignatureCanvas();
            }, 50);

            // Init Signature Pad if not done
            if (!signaturePad) {
                const canvas = $('signature-pad');
                signaturePad = new SignaturePad(canvas, {
                    backgroundColor: 'rgba(0,0,0,0)',
                    penColor: '#000000',
                    throttle: 0
                });
                
                resizeSignatureCanvas = function () {
                    const rect = canvas.getBoundingClientRect();
                    const ratio = Math.max(window.devicePixelRatio || 1, 1);
                    const newWidth = Math.round(rect.width * ratio);
                    const newHeight = Math.round(rect.height * ratio);
                    
                    if (canvas.width !== newWidth || canvas.height !== newHeight) {
                        canvas.width = newWidth;
                        canvas.height = newHeight;
                        const context = canvas.getContext("2d");
                        context.setTransform(ratio, 0, 0, ratio, 0, 0);
                        signaturePad.clear();
                    }
                };
                window.addEventListener("resize", resizeSignatureCanvas);
                // Delay resize to ensure element is rendered
                setTimeout(resizeSignatureCanvas, 50);
                
                const checkStatus = () => {
                    const hasFirma = !signaturePad.isEmpty();
                    const hasTerms = $('terms-accept').checked;
                    const btn = $('btn-submit-signature');
                    const warning = $('signature-warning');
                    
                    if (btn) {
                        btn.disabled = !(hasFirma && hasTerms);
                        btn.style.opacity = (hasFirma && hasTerms) ? '1' : '0.4';
                    }
                    
                    if (warning) {
                        warning.style.display = (hasFirma && hasTerms) ? 'none' : 'block';
                        let messages = [];
                        if (!hasFirma) messages.push('falta firma');
                        if (!hasTerms) messages.push('falta aceptar términos');
                        warning.textContent = 'Pendiente: ' + messages.join(' y ');
                    }
                    
                    const label = $('terms-label-element');
                    if (label) {
                        label.style.borderColor = hasTerms ? '#10b981' : '#ffe4e6';
                        label.style.background = hasTerms ? '#f0fdf4' : '#fffafb';
                    }
                };

                signaturePad.onEnd = checkStatus;
                $('terms-accept').addEventListener('change', checkStatus);
                $('terms-accept').addEventListener('click', checkStatus);
                $('terms-accept').addEventListener('input', checkStatus);
                
                // Initial call
                checkStatus();
                
                // Final safety check
                setInterval(checkStatus, 500);

                if (urlParams.get('status') === 'cancel') {
                    setStep(3, { scroll: false });
                    showToast('El pago ha sido cancelado.', 'error');
                }
            }
        });

        // Initialize state
        if (urlParams.get('status') === 'processing' || (contract.is_billable && urlParams.get('status') === 'success')) {
            setStep(3, { scroll: false });
            const checkoutBox = $('payment-checkout-box');
            const successMsg = $('payment-success-msg');
            if (checkoutBox) checkoutBox.style.display = 'none';
            if (successMsg) successMsg.style.display = 'block';
            showToast('Pago registrado. Esperando confirmacion de Stripe.', 'success');
        } else if (urlParams.get('status') === 'success') {
            setStep(3, { scroll: false });
            showToast('Contrato firmado correctamente.', 'success');
        } else if (urlParams.get('status') === 'cancel') {
            setStep(3, { scroll: false });
            showToast('El pago ha sido cancelado.', 'error');
        } else if (contract.status === 'completed' || contract.status === 'paid') {
            setStep(3, { scroll: false });
        } else {
            setStep(0, { scroll: false });
        }

        window.scrollTo(0, 0);

        $('back-to-step-0')?.addEventListener('click', () => setStep(0));
        $('back-to-step-1')?.addEventListener('click', () => setStep(hasClientDataStep ? 1 : 0));

        document.querySelectorAll('.input-group').forEach((group) => {
            group.addEventListener('pointerdown', (event) => {
                const input = group.querySelector('input');
                if (!input || event.target === input) return;
                input.focus();
            });
        });
        
        $('clear-sig')?.addEventListener('click', () => {
            signaturePad.clear();
            $('btn-submit-signature').disabled = true;
        });

        // STEP 2 -> STEP 3 (Signing)
        $('btn-submit-signature')?.addEventListener('click', async () => {
            const btn = $('btn-submit-signature');
            btn.disabled = true;
            btn.textContent = 'Guardando firma...';

            // Gather client data
            const email = $('c-email').value.trim();
            const phone = $('c-phone').value.trim();
            const dataInputs = document.querySelectorAll('.client-data-input');
            const client_data = {};
            dataInputs.forEach(i => client_data[i.dataset.field] = i.value.trim());

            const signature_svg = signaturePad.toDataURL();

            try {
                const res = await fetch(`/api/contracts/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        client_email: email,
                        client_phone: phone,
                        client_data,
                        signature_svg,
                        status: contract.is_billable ? 'pending_payment' : 'completed'
                    })
                });

                if (res.ok) {
                    if (!contract.is_billable) {
                        window.location.href = `/contrato/${id}?status=success`;
                        return;
                    }
                    setStep(3);
                } else {
                    const err = await res.json();
                    showToast(err.error || 'Error al guardar la firma.', 'error');
                    btn.disabled = false;
                    btn.textContent = contract.is_billable ? 'Firmar y proceder al pago' : 'Firmar y Finalizar';
                }
            } catch (err) {
                showToast('Error de conexión.', 'error');
                btn.disabled = false;
                btn.textContent = contract.is_billable ? 'Firmar y proceder al pago' : 'Firmar y Finalizar';
            }
        });

        // STEP 3 -> STRIPE
        $('btn-pay')?.addEventListener('click', async () => {
            const btn = $('btn-pay');
            btn.disabled = true;
            btn.textContent = 'Redirigiendo a Stripe...';

            try {
                const res = await fetch(`/api/stripe/checkout`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contract_id: id })
                });

                if (res.ok) {
                    const { url } = await res.json();
                    window.location.href = url;
                } else {
                    const err = await res.json().catch(() => null);
                    showToast(err?.error || 'Error al crear la sesion de pago.', 'error');
                    btn.disabled = false;
                    btn.textContent = 'Proceder al pago seguro';
                }
            } catch (err) {
                showToast('Error de conexión con Stripe.', 'error');
                btn.disabled = false;
                btn.textContent = 'Proceder al pago seguro';
            }
        });

        // TOAST SYSTEM
        function showToast(message, type = 'success') {
            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                container.style.cssText = 'position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 100; display: flex; flex-direction: column; gap: 0.5rem; pointer-events: none;';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.style.cssText = `
                padding: 1rem 1.5rem;
                background: ${type === 'success' ? '#10b981' : '#e11d48'};
                color: white;
                border-radius: 1rem;
                font-weight: 600;
                font-size: 0.9rem;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
                animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                pointer-events: auto;
                border: 1px solid rgba(255,255,255,0.1);
            `;
            toast.textContent = message;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px) scale(0.95)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
    </script>
</BaseLayout>
