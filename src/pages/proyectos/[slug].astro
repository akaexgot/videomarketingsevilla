---
/**
 * Project Detail Page — Cinematic Fullpage Scroll
 * Screen 1: Vertical making-of video + title + description + client info
 * Screen 2: Horizontal project video (fullscreen — plays in-place on click)
 * Screen 3: CTA
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactFormBlock from '../../components/ui/ContactFormBlock.astro';
import { getProjects } from '../../lib/data';
import { getVideoId, isInstagramReel, getInstagramEmbedUrl } from '../../lib/display';
import { buildBreadcrumbSchema, buildProjectSchemas, getVideoThumbnail } from '../../lib/seo';


const { slug } = Astro.params;
const projects = await getProjects();
const project = projects.find((p: any) => p.slug === slug);

if (!project) {
    return Astro.redirect('/proyectos');
}

const isNative = (url: string | null | undefined) => !!url && (url.includes('cloudinary.com') || url.endsWith('.mp4') || url.endsWith('.webm'));

const projectVideoUrl = project.video_project;
const projectVideoIsNative = isNative(projectVideoUrl);
const mainVideoId = !projectVideoIsNative ? getVideoId(projectVideoUrl) : null;

const expDesktopUrl = project.video_explanation_desktop;
const expMobileUrl = project.video_explanation_mobile;
const makingOfUrl = expMobileUrl || expDesktopUrl;
const makingOfIsNative = isNative(makingOfUrl);
const makingOfIsInstagram = isInstagramReel(makingOfUrl);
const makingOfInstagramEmbed = makingOfIsInstagram ? getInstagramEmbedUrl(makingOfUrl) : null;
const makingOfId = (!makingOfIsNative && !makingOfIsInstagram) ? (getVideoId(expMobileUrl) || getVideoId(expDesktopUrl)) : null;

// Final vars for Screen 1
const hasMakingOf = !!makingOfUrl || !!makingOfId || !!makingOfInstagramEmbed;
const s1VideoUrl = hasMakingOf ? makingOfUrl : projectVideoUrl;
const s1VideoId = hasMakingOf ? makingOfId : mainVideoId;
const s1IsNative = hasMakingOf ? makingOfIsNative : projectVideoIsNative;
const s1IsInstagram = hasMakingOf ? makingOfIsInstagram : false;
const s1InstagramEmbed = hasMakingOf ? makingOfInstagramEmbed : null;
const s1FrameClass = (hasMakingOf && !makingOfIsNative && !makingOfIsInstagram) ? "" : (!hasMakingOf ? "pj-hero__video-frame--horizontal" : "");
const pagePath = `/proyectos/${project.slug}`;
const pageImage = project.thumbnail || getVideoThumbnail(project.video_project);
const structuredData = [
    buildBreadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Proyectos', path: '/proyectos' },
        { name: project.title, path: pagePath },
    ]),
    ...buildProjectSchemas(project, pagePath),
];
---

<BaseLayout
    title={project.title}
    description={project.subtitle || project.description || ''}
    image={pageImage}
    type="article"
    structuredData={structuredData}
>
    <article class="pj-detail" data-project-page>

        <!-- ═══ SCREEN 1: Hero — Vertical video + Project Info ═══ -->
        <section class="pj-detail__screen pj-detail__hero" id="pj-hero">
            <div class="pj-hero__layout">

                <!-- Left: Vertical Video (Making Of) -->
                <div class="pj-hero__video-col reveal-left">
                    {s1VideoUrl || s1VideoId || s1InstagramEmbed ? (
                        <div class={`pj-hero__video-frame ${s1FrameClass}`}>
                            {s1IsInstagram && s1InstagramEmbed ? (
                                <iframe
                                    src={s1InstagramEmbed}
                                    class="pj-hero__video-iframe"
                                    frameborder="0"
                                    scrolling="no"
                                    allowtransparency="true"
                                    allowfullscreen
                                    title="Instagram Reel"
                                    style="border: none; overflow: hidden;"
                                ></iframe>
                            ) : s1IsNative ? (
                                <video aria-hidden="true" src={s1VideoUrl} 
                                    class="pj-hero__video-iframe" 
                                    autoplay loop muted playsinline 
                                    style="object-fit: cover;"
                                ></video>
                            ) : (
                                <iframe
                                    src={`https://www.youtube-nocookie.com/embed/${s1VideoId}?rel=0&modestbranding=1&enablejsapi=1&origin=${Astro.url.origin}`}
                                    class="pj-hero__video-iframe"
                                    frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; compute-pressure"
                                    allowfullscreen
                                    title={hasMakingOf ? "Making Of" : project.title}
                                ></iframe>
                            )}
                        </div>
                    ) : (
                        <div class="pj-hero__video-placeholder">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>Vídeo próximamente</span>
                        </div>
                    )}
                </div>

                <!-- Right: Project info -->
                <div class="pj-hero__info-col reveal-right">
                    {project.client_name && (
                        <div class="pj-hero__badge">
                            <span class="pj-hero__dot"></span>
                            <span>{project.client_name}</span>
                        </div>
                    )}

                    <h1 class="pj-hero__title">{project.title}</h1>

                    {project.subtitle && (
                        <p class="pj-hero__subtitle">{project.subtitle}</p>
                    )}

                    {project.description && (
                        <p class="pj-hero__description">{project.description}</p>
                    )}

                    {project.client_logo && (
                        <div class="pj-hero__client-logo">
                            <img src={project.client_logo} alt={project.client_name || 'Cliente'} />
                        </div>
                    )}
                </div>
            </div>

            <!-- Scroll indicator -->
            <div class="pj-hero__scroll">
                <span>Ver proyecto</span>
                <div class="pj-hero__scroll-arrow">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>
            </div>
        </section>

        <!-- ═══ SCREEN 2: Project Video — Fullscreen (plays in-place) ═══ -->
        {projectVideoUrl || mainVideoId ? (
        <section class="pj-detail__screen pj-detail__video-screen" id="pj-video">
            {/* Background video (muted, autoplay, no controls) */}
            <div class="pj-video__bg" id="pjVideoBg">
                {projectVideoIsNative ? (
                    <video aria-hidden="true" data-src={projectVideoUrl} 
                        class="pj-video__bg-iframe" 
                        loop muted playsinline preload="none"
                        style="object-fit: cover;"
                    ></video>
                ) : (
                    <iframe
                        data-src={`https://www.youtube-nocookie.com/embed/${mainVideoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&origin=${Astro.url.origin}`}
                        src=""
                        class="pj-video__bg-iframe"
                        frameborder="0"
                        allow="autoplay; encrypted-media; compute-pressure"
                        loading="lazy"
                    ></iframe>
                )}
            </div>
            {/* Overlay (hides when playing) */}
            <div class="pj-video__overlay" id="pjVideoOverlay"></div>
            {/* Play button + info (hides when playing) */}
            <div class="pj-video__content" id="pjVideoContent" style="cursor: pointer;">
                <span class="pj-video__label">Reproducir proyecto</span>
                <h2 class="pj-video__title">{project.title}</h2>
                <button class="pj-video__play-btn" id="pjPlayBtn" aria-label="Reproducir vídeo">
                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </button>
            </div>
            {/* Clickable overlay to trigger play from anywhere */}
            <div class="pj-video__click-area" id="pjVideoClickArea" style="position: absolute; inset: 0; z-index: 25; cursor: pointer;"></div>
            {/* Full interactive player (hidden until play, replaces bg) */}
            {projectVideoIsNative ? (
                <video 
                    id="pjFullPlayer"
                    class="pj-video__full-player"
                    data-src={projectVideoUrl}
                    controls
                    playsinline
                    preload="none"
                    style="object-fit: contain; background: #000;"
                ></video>
            ) : (
                <iframe
                    id="pjFullPlayer"
                    class="pj-video__full-player"
                    data-src={`https://www.youtube-nocookie.com/embed/${mainVideoId}?rel=0&modestbranding=1&autoplay=1&enablejsapi=1&origin=${Astro.url.origin}`}
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; compute-pressure"
                    allowfullscreen
                    title={project.title}
                ></iframe>
            )}
        </section>
        ) : null}

        <!-- ═══ SCREEN 3: CONTACT FORM ═══ -->
        <section class="pj-detail__screen pj-detail__cta-screen" id="pj-cta">
            <ContactFormBlock />
        </section>
    </article>
</BaseLayout>

<style>
    .pj-detail {
        background: var(--color-dark);
        color: var(--color-light);
    }

    .pj-detail__screen {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ═══ SCREEN 1: HERO ═══ */
    .pj-detail__hero {
        background: var(--color-dark-surface);
    }

    .pj-hero__layout {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
    }
    @media (min-width: 1024px) {
        .pj-hero__layout {
            grid-template-columns: auto 1fr;
            gap: 5rem;
        }
    }

    .pj-hero__video-col { display: flex; justify-content: center; }

    .pj-hero__video-frame {
        width: 340px;
        aspect-ratio: 9 / 16;
        border-radius: 1.5rem;
        overflow: hidden;
        background: var(--color-dark-card);
        border: 1px solid rgba(255, 255, 255, 0.06);
        box-shadow: 0 25px 80px rgba(0,0,0,0.6), 0 0 60px rgba(155,27,48,0.1);
        position: relative;
    }
    .pj-hero__video-frame--horizontal {
        width: 100%;
        max-width: 540px;
        aspect-ratio: 16 / 9;
    }
    @media (min-width: 768px) { .pj-hero__video-frame { width: 380px; } }
    @media (min-width: 1024px) { .pj-hero__video-frame { width: 420px; } }
    @media (max-width: 1023px) {
        .pj-hero__video-frame { width: 240px; }
        .pj-hero__video-frame--horizontal { width: 100%; max-width: 440px; }
    }

    .pj-hero__video-iframe {
        position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    }
    /* Instagram embed: fill the frame and hide scrollbars */
    .pj-hero__video-iframe[title="Instagram Reel"] {
        overflow: hidden;
        background: #000;
    }

    .pj-hero__video-placeholder {
        width: 380px; aspect-ratio: 9 / 16; border-radius: 1.5rem;
        background: var(--color-dark-card); border: 1px solid rgba(255,255,255,0.06);
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
        color: rgba(255,255,255,0.2);
    }
    .pj-hero__video-placeholder svg { width: 3rem; height: 3rem; }
    .pj-hero__video-placeholder span { font-size: 0.8125rem; font-weight: 500; }

    .pj-hero__info-col { display: flex; flex-direction: column; gap: 1.25rem; }
    @media (max-width: 1023px) { .pj-hero__info-col { text-align: center; align-items: center; } }

    .pj-hero__badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.375rem 1.125rem; border-radius: 9999px;
        border: 1px solid rgba(155,27,48,0.5); background: rgba(155,27,48,0.12);
        backdrop-filter: blur(8px);
        font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em;
        text-transform: uppercase; color: rgba(255,255,255,0.8); width: fit-content;
    }
    .pj-hero__dot {
        display: block; width: 6px; height: 6px; border-radius: 50%;
        background: var(--color-carmin-light); box-shadow: 0 0 8px rgba(232,54,79,0.8);
        animation: pj-pulse 2s infinite;
    }
    @keyframes pj-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .pj-hero__title {
        font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800; color: #fff; line-height: 1.05; letter-spacing: -0.03em; margin: 0;
    }
    .pj-hero__subtitle {
        font-size: clamp(1rem, 1.5vw, 1.25rem); color: rgba(255,255,255,0.5);
        font-style: italic; font-weight: 300; margin: 0; line-height: 1.5;
    }
    .pj-hero__description {
        font-size: clamp(0.875rem, 1.2vw, 1rem); color: rgba(255,255,255,0.4);
        line-height: 1.75; margin: 0.5rem 0 0; max-width: 520px; white-space: pre-line;
    }
    @media (max-width: 1023px) { .pj-hero__description { max-width: 480px; } }

    .pj-hero__client-logo { margin-top: 0.5rem; }
    .pj-hero__client-logo img {
        height: 2rem; object-fit: contain; opacity: 0.5;
        filter: grayscale(1) brightness(2); transition: opacity 0.3s, filter 0.3s;
    }
    .pj-hero__client-logo img:hover { opacity: 0.9; filter: none; }

    .pj-hero__scroll {
        position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
        z-index: 10; display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
        color: rgba(255,255,255,0.35); animation: pj-float 3s ease-in-out infinite;
    }
    .pj-hero__scroll span {
        font-size: 0.65rem; font-weight: 600; letter-spacing: 0.18em;
        text-transform: uppercase; font-family: 'Space Grotesk', monospace;
    }
    .pj-hero__scroll-arrow svg { width: 1.25rem; height: 1.25rem; }
    @keyframes pj-float {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(6px); }
    }

    /* ═══ SCREEN 2: PROJECT VIDEO — FULLSCREEN IN-PLACE ═══ */
    .pj-detail__video-screen { background: #000; }

    .pj-video__bg {
        position: absolute; inset: 0; z-index: 1; background: #0a0a0f;
    }
    .pj-video__bg-iframe {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 177.78vh; height: 56.25vw; min-width: 100%; min-height: 100%;
        pointer-events: none;
    }
    .pj-video__overlay {
        position: absolute; inset: 0; z-index: 2;
        background:
            linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.4) 100%),
            radial-gradient(ellipse 80% 60% at 50% 50%, transparent 0%, rgba(0,0,0,0.25) 100%);
        transition: opacity 0.5s ease;
    }
    .pj-video__content {
        position: relative; z-index: 10;
        display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.25rem;
        transition: opacity 0.5s ease;
    }
    .pj-video__label {
        font-family: 'Space Grotesk', monospace; font-size: 0.7rem; font-weight: 500;
        letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.4);
    }
    .pj-video__title {
        font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800; color: #fff; margin: 0; line-height: 1.1;
        text-shadow: 0 8px 30px rgba(0,0,0,0.5);
    }
    .pj-video__play-btn {
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(155,27,48,0.9); border: 2px solid rgba(255,255,255,0.2);
        color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
        transition: transform 0.3s, box-shadow 0.3s, background 0.3s; margin-top: 0.5rem;
    }
    .pj-video__play-btn svg { width: 2rem; height: 2rem; margin-left: 4px; }
    .pj-video__play-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 0 60px rgba(155,27,48,0.5);
        background: rgba(232,54,79,1);
    }

    /* Full player — fills section, hidden by default */
    .pj-video__full-player {
        position: absolute; inset: 0; z-index: 30;
        width: 100%; height: 100%; border: 0;
        opacity: 0; pointer-events: none;
        transition: opacity 0.5s ease;
    }
    .pj-video__full-player.is-playing {
        opacity: 1; pointer-events: all;
    }
    .pj-video__full-player.is-ready-mobile {
        opacity: 1; pointer-events: all;
    }

    /* When playing, hide overlay and content */
    .pj-detail__video-screen.is-playing .pj-video__overlay,
    .pj-detail__video-screen.is-playing .pj-video__content,
    .pj-detail__video-screen.is-playing .pj-video__click-area,
    .pj-detail__video-screen.is-mobile-ready .pj-video__overlay,
    .pj-detail__video-screen.is-mobile-ready .pj-video__content,
    .pj-detail__video-screen.is-mobile-ready .pj-video__click-area {
        opacity: 0; pointer-events: none;
    }

    /* ═══ SCREEN 3: CTA / CONTACT ═══ */
    .pj-detail__cta-screen { 
        background: var(--color-dark-surface); 
        padding-top: 5vh;
    }

    /* Dark Theme Overrides for ContactFormBlock inside projects */
    .pj-detail__cta-screen :global(.contact-body) {
        background: transparent !important;
        min-height: auto !important;
        padding: 0 !important;
    }

    .pj-detail__cta-screen :global(.contact-form),
    .pj-detail__cta-screen :global(.contact-card) {
        background: var(--color-dark-card) !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__label),
    .pj-detail__cta-screen :global(.contact-card__title),
    .pj-detail__cta-screen :global(.contact-info-list__item),
    .pj-detail__cta-screen :global(.contact-form__input) {
        color: #fff !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input) {
        background: rgba(255, 255, 255, 0.03) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input:focus) {
        border-color: var(--color-carmin) !important;
        background: rgba(255, 255, 255, 0.05) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__label),
    .pj-detail__cta-screen :global(.contact-card__title--info) {
        color: rgba(255, 255, 255, 0.9) !important;
    }

    .pj-detail__cta-screen :global(.contact-card__text),
    .pj-detail__cta-screen :global(.contact-trust__item),
    .pj-detail__cta-screen :global(.contact-info-list__item span) {
        color: rgba(255, 255, 255, 0.5) !important;
    }

    .pj-detail__cta-screen :global(.contact-form__input::placeholder) {
        color: rgba(255, 255, 255, 0.2) !important;
    }

    @media (max-width: 767px) {
        .pj-detail {
            padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
        }

        .pj-detail__screen {
            position: relative !important;
            height: auto !important;
            min-height: 0 !important;
            overflow: visible !important;
            display: block !important;
            align-items: stretch !important;
            justify-content: flex-start !important;
        }

        .pj-detail__hero {
            padding: calc(6.75rem + env(safe-area-inset-top, 0px)) 0 3rem;
        }

        .pj-hero__layout {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            padding: 0 1.15rem;
        }

        .pj-hero__video-frame {
            width: min(68vw, 245px);
            margin-top: 0.75rem;
            border-radius: 1.1rem;
            box-shadow: 0 18px 50px rgba(0,0,0,0.45);
        }

        .pj-hero__video-frame--horizontal {
            width: 100%;
            max-width: calc(100vw - 2rem);
        }

        .pj-hero__info-col {
            gap: 1rem;
            width: 100%;
            text-align: center;
            align-items: center;
        }

        .pj-hero__video-iframe {
            object-fit: contain !important;
            background: #050508;
        }

        .pj-hero__badge {
            max-width: 100%;
            justify-content: center;
            padding: 0.35rem 0.85rem;
            font-size: 0.62rem;
            letter-spacing: 0.11em;
            white-space: normal;
            text-align: center;
        }

        .pj-hero__title {
            width: 100%;
            max-width: 22rem;
            font-size: clamp(2.05rem, 11vw, 3rem);
            line-height: 1.05;
            overflow-wrap: break-word;
        }

        .pj-hero__subtitle {
            max-width: 21rem;
            font-size: 1rem;
            line-height: 1.55;
        }

        .pj-hero__description {
            max-width: 22rem;
            font-size: 0.95rem;
            line-height: 1.65;
            margin-top: 0;
        }

        .pj-hero__scroll {
            display: none;
        }

        .pj-detail__video-screen {
            position: relative !important;
            z-index: 0 !important;
            clear: both;
            isolation: isolate;
            padding: 1rem 1rem 2.25rem !important;
            margin: 0 !important;
            background: #050508;
        }

        .pj-video__bg,
        .pj-video__overlay,
        .pj-video__content,
        .pj-video__click-area {
            display: none !important;
        }

        .pj-video__full-player {
            position: static !important;
            inset: auto !important;
            transform: none !important;
            z-index: 0 !important;
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            height: clamp(190px, 56.25vw, 260px) !important;
            min-height: 0 !important;
            max-height: none !important;
            aspect-ratio: 16 / 9 !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            border-radius: 1rem;
            overflow: hidden;
            background: #000;
            margin: 0 0 0.75rem !important;
        }

        video.pj-video__full-player {
            object-fit: contain !important;
        }

        .pj-detail__cta-screen {
            position: relative !important;
            z-index: 1 !important;
            clear: both;
            padding: 2.25rem 1rem calc(7.5rem + env(safe-area-inset-bottom, 0px)) !important;
            margin-top: 0 !important;
            background: var(--color-dark-surface);
        }

        .pj-detail__cta-screen :global(.contact-body) {
            display: block !important;
            min-height: 0 !important;
            overflow: visible !important;
            padding: 0 !important;
        }

        .pj-detail__cta-screen :global(.section-container) {
            width: 100% !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .pj-detail__cta-screen :global(.contact-body__grid) {
            display: flex !important;
            flex-direction: column;
            gap: 1.5rem;
        }

        .pj-detail__cta-screen :global(.contact-form),
        .pj-detail__cta-screen :global(.contact-card) {
            border-radius: 1.1rem !important;
            padding: 1.25rem !important;
        }

        .pj-detail__cta-screen :global(.contact-form__submit) {
            width: 100%;
            justify-content: center;
            padding: 0.95rem 1.2rem;
            font-size: 1rem;
        }

        :global(#site-footer) {
            padding-bottom: calc(5.75rem + env(safe-area-inset-bottom, 0px));
        }
    }

    @media (max-width: 380px) {
        .pj-hero__video-frame {
            width: min(64vw, 220px);
        }

        .pj-hero__title {
            font-size: clamp(1.85rem, 10.5vw, 2.55rem);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        /* ── Fullpage Scroll ── */
        const sections = Array.from(document.querySelectorAll('.pj-detail__screen, #site-footer'));
        if (sections.length === 0) return;

        const enableFullpageScroll = false;

        if (enableFullpageScroll && window.innerWidth > 1024) {
            let isScrolling = false;
            let scrollTimeout: ReturnType<typeof setTimeout>;

            function getVisibleSectionIndex() {
            let maxIdx = 0, maxArea = 0;
            sections.forEach((sec, idx) => {
                const r = sec.getBoundingClientRect();
                const v = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
                if (v > maxArea) { maxArea = v; maxIdx = idx; }
            });
            return maxIdx;
        }
            function scrollToSection(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;
            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                isScrolling = false;
            }, 1300);
        }

            window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;
            const cur = getVisibleSectionIndex();
            scrollToSection(e.deltaY > 0 ? cur + 1 : cur - 1);
        }, { passive: false });

            let touchStartY = 0;
            window.addEventListener('touchstart', (e) => { touchStartY = e.changedTouches[0].screenY; }, { passive: false });
            window.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });
            window.addEventListener('touchend', (e) => {
            if (isScrolling) return;
            const delta = touchStartY - e.changedTouches[0].screenY;
            const cur = getVisibleSectionIndex();
            if (delta > 50) scrollToSection(cur + 1);
            else if (delta < -50) scrollToSection(cur - 1);
        }, { passive: false });

            window.addEventListener('keydown', (e) => {
            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const cur = getVisibleSectionIndex();
                if (['ArrowDown', 'PageDown', ' '].includes(e.key)) scrollToSection(cur + 1);
                else if (['ArrowUp', 'PageUp'].includes(e.key)) scrollToSection(cur - 1);
                else if (e.key === 'Home') scrollToSection(0);
                else if (e.key === 'End') scrollToSection(sections.length - 1);
            }
            }, { passive: false });
        }

        /* ── Stop videos helper ── */
        function stopVideoInContainer(container: HTMLElement) {
            const iframes = container.querySelectorAll('iframe');
            iframes.forEach(iframe => {
                if (iframe.src.includes('youtube.com') || iframe.src.includes('youtube-nocookie.com')) {
                    iframe.contentWindow?.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                } else if (iframe.src.includes('instagram.com')) {
                    const temp = iframe.src; iframe.src = ''; iframe.src = temp;
                }
            });
            const videos = container.querySelectorAll('video');
            videos.forEach(video => {
                if (!video.hasAttribute('loop')) video.pause(); // Only pause non-looping interactive videos
            });
        }

        /* ── Pause videos when scrolling to another screen ── */
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) {
                    stopVideoInContainer(entry.target as HTMLElement);
                }
            });
        }, { threshold: 0.2 });
        sections.forEach(sec => observer.observe(sec));

        const shouldLoadBackgroundVideo = window.matchMedia('(min-width: 1025px)').matches;
        if (shouldLoadBackgroundVideo) {
            const bgMedia = document.querySelector<HTMLElement>('.pj-video__bg-iframe[data-src]');
            if (bgMedia instanceof HTMLVideoElement) {
                bgMedia.src = bgMedia.dataset.src || '';
                bgMedia.autoplay = true;
                bgMedia.muted = true;
                bgMedia.playsInline = true;
                bgMedia.play().catch(() => {});
            } else if (bgMedia instanceof HTMLIFrameElement) {
                bgMedia.src = bgMedia.dataset.src || '';
            }
        }

        /* ── In-place Play Button ── */
        const playBtn = document.getElementById('pjPlayBtn');
        const clickArea = document.getElementById('pjVideoClickArea');
        const fullPlayer = document.getElementById('pjFullPlayer') as HTMLElement;
        const videoScreen = document.getElementById('pj-video');
        const shouldShowInlinePlayer = window.matchMedia('(max-width: 767px)').matches;

        function srcWithoutAutoplay(src: string) {
            try {
                const url = new URL(src);
                url.searchParams.delete('autoplay');
                return url.toString();
            } catch {
                return src.replace(/([?&])autoplay=1&?/, '$1').replace(/[?&]$/, '');
            }
        }

        if (shouldShowInlinePlayer && fullPlayer && videoScreen) {
            if (fullPlayer.tagName === 'IFRAME') {
                const iframe = fullPlayer as HTMLIFrameElement;
                if (iframe.dataset.src) {
                    iframe.src = srcWithoutAutoplay(iframe.dataset.src);
                }
            } else if (fullPlayer.tagName === 'VIDEO') {
                const video = fullPlayer as HTMLVideoElement;
                if (!video.src && video.dataset.src) {
                    video.src = video.dataset.src;
                }
                video.preload = 'metadata';
            }
            fullPlayer.classList.add('is-ready-mobile');
            videoScreen.classList.add('is-mobile-ready');
        }

        const playMainVideo = () => {
            // Stop hero video before playing main
            stopVideoInContainer(document.getElementById('pj-hero') as HTMLElement);

            if (fullPlayer.tagName === 'IFRAME') {
                const iframe = fullPlayer as HTMLIFrameElement;
                if (iframe.dataset.src) {
                    iframe.src = iframe.dataset.src;
                }
            } else if (fullPlayer.tagName === 'VIDEO') {
                const video = fullPlayer as HTMLVideoElement;
                if (!video.src && video.dataset.src) {
                    video.src = video.dataset.src;
                }
                video.play();
                video.muted = false;
            }
            fullPlayer.classList.add('is-playing');
            videoScreen!.classList.add('is-playing');
        };

        if (playBtn && clickArea && fullPlayer && videoScreen) {
            playBtn.addEventListener('click', (e) => { e.stopPropagation(); playMainVideo(); });
            clickArea.addEventListener('click', playMainVideo);
        }

        /* ── Force navbar transparent on project pages ── */
        const navbar = document.getElementById('navbar');
        const navBg = document.getElementById('nav-bg');
        if (navbar && navBg && document.querySelector('[data-project-page]')) {
            // Override navbar to stay transparent always
            const forceTransparent = () => {
                navBg.style.background = 'linear-gradient(to bottom, rgba(5,5,8,0.55) 0%, rgba(5,5,8,0.12) 65%, transparent 100%)';
                navBg.style.backdropFilter = 'none';
                (navBg.style as any).webkitBackdropFilter = 'none';
                navBg.style.boxShadow = 'none';
            };
            forceTransparent();
            window.addEventListener('scroll', forceTransparent, { passive: true });
        }
    });
</script>
