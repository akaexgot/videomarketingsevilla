---
/**
 * Admin - Global Website Settings
 * Restyled with a premium Zinc Dark Mode aesthetic natively
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getSettings } from "../../lib/data";
import { getServiceSupabase } from "../../lib/supabase";
import { getUserFromCookie } from "../../lib/auth";

// SSR auth is handled by middleware
const serviceSupabase = getServiceSupabase()!;

const settings = await getSettings();
// Helper stringifier para rellenar
const getVal = (key: string) => String((settings as Record<string, unknown>)[key] ?? '');
---

<AdminLayout title="Ajustes Generales" activeSection="ajustes">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between" style="margin-bottom: 1.5rem; gap: 1rem;">
        <div>
            <p class="text-zinc-400 text-sm">Gestiona la configuración global de la web y datos de contacto.</p>
        </div>
        <button id="btn-save-all"
            class="inline-flex items-center justify-center bg-rose-600 text-white text-sm font-medium rounded-md hover:bg-rose-500 transition-colors shadow-sm"
            style="padding: 0.5rem 1rem; gap: 0.5rem;"
        >
            <i data-lucide="save" class="w-4 h-4"></i>
            Guardar cambios
        </button>
    </div>

    <div id="toast-container" class="fixed bottom-6 right-6 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
        <!-- Tabs Navigation -->
        <ol class="w-full lg:w-64 flex flex-col shrink-0" style="gap: 0.25rem;">
            <li>
                <button type="button" class="tab-btn w-full flex items-center rounded-lg text-sm font-medium transition-colors bg-zinc-800 text-zinc-50" style="padding: 0.75rem 1rem; gap: 0.75rem;" data-target="tab-general">
                    <i data-lucide="settings-2" class="w-5 h-5 text-rose-500"></i>
                    General
                </button>
            </li>
            <li>
                <button type="button" class="tab-btn w-full flex items-center rounded-lg text-sm font-medium transition-colors text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50" style="padding: 0.75rem 1rem; gap: 0.75rem;" data-target="tab-hero">
                    <i data-lucide="monitor-play" class="w-5 h-5 text-zinc-500"></i>
                    Sección Inicio
                </button>
            </li>
            <li>
                <button type="button" class="tab-btn w-full flex items-center rounded-lg text-sm font-medium transition-colors text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50" style="padding: 0.75rem 1rem; gap: 0.75rem;" data-target="tab-contact">
                    <i data-lucide="at-sign" class="w-5 h-5 text-zinc-500"></i>
                    Datos de Contacto
                </button>
            </li>
            <li>
                <button type="button" class="tab-btn w-full flex items-center rounded-lg text-sm font-medium transition-colors text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50" style="padding: 0.75rem 1rem; gap: 0.75rem;" data-target="tab-about">
                    <i data-lucide="users" class="w-5 h-5 text-zinc-500"></i>
                    Quiénes Somos
                </button>
            </li>
            <li class="hidden">
                <button type="button" class="tab-btn w-full flex items-center rounded-lg text-sm font-medium transition-colors text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800/50" style="padding: 0.75rem 1rem; gap: 0.75rem;" data-target="tab-contact-page">
                    <i data-lucide="image" class="w-5 h-5 text-zinc-500"></i>
                    Sección Contacto
                </button>
            </li>
        </ol>

        <!-- Settings Form Area -->
        <div class="flex-1 bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
            <form id="settings-form" class="settings-form-content" style="padding: 1.5rem 2rem;">
                
                <!-- Tab: General -->
                <div id="tab-general" class="tab-content space-y-8">
                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Información de la Marca</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 mt-6" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Nombre de la Empresa</label>
                                <input type="text" name="site_name" value={getVal('site_name')} class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Descripción Corta (Footer)</label>
                                <input type="text" name="site_description" value={getVal('site_description')} class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Personalización Global</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 mt-6" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Color Principal (Botones, detalles)</label>
                                <div class="flex gap-2">
                                    <input type="color" id="primary_color_picker" value={getVal('primary_color') || '#e8364f'} class="w-10 h-10 rounded border border-zinc-800 cursor-pointer bg-zinc-950 p-1" />
                                    <input type="text" name="primary_color" id="primary_color_input" value={getVal('primary_color')} placeholder="#e8364f" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm uppercase" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Color Secundario</label>
                                <div class="flex gap-2">
                                    <input type="color" id="secondary_color_picker" value={getVal('secondary_color') || '#ffffff'} class="w-10 h-10 rounded border border-zinc-800 cursor-pointer bg-zinc-950 p-1" />
                                    <input type="text" name="secondary_color" id="secondary_color_input" value={getVal('secondary_color')} placeholder="#ffffff" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm uppercase" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab: Hero Section -->
                <div id="tab-hero" class="tab-content hidden space-y-8">
                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Vídeo Principal de Inicio</h2>
                        <p class="text-sm text-zinc-400 mt-2 mb-6">Gestiona el vídeo de fondo del home para escritorio y móvil. Si no hay vídeo móvil, se usará el horizontal.</p>
                        
                        <div class="grid grid-cols-1 gap-6">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Vídeo horizontal / escritorio (YouTube o Cloudinary MP4)</label>
                                <div class="flex gap-2">
                                    <input type="text" name="hero_video_desktop" id="hero_video_url" value={getVal('hero_video_desktop')} placeholder="https://www.youtube.com/watch?v=... o subir archivo" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                                    <button type="button" onclick="document.getElementById('file-hero-video').click()" class="inline-flex items-center justify-center bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors px-3 py-2 rounded-md border border-zinc-700 text-sm font-medium">
                                        <i data-lucide="upload" class="w-4 h-4 mr-2"></i> Subir
                                    </button>
                                    <input type="file" id="file-hero-video" class="hidden" accept="video/mp4,video/webm" />
                                </div>
                                <div id="loading-hero-video" class="hidden items-center gap-2 mt-2 text-xs text-rose-500 font-medium">
                                    <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Subiendo vídeo... Esto puede tardar varios minutos.
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Vídeo móvil / vertical (opcional)</label>
                                <div class="flex gap-2">
                                    <input type="text" name="hero_video_mobile" id="hero_video_mobile_url" value={getVal('hero_video_mobile')} placeholder="https://... o subir vídeo vertical" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                                    <button type="button" onclick="document.getElementById('file-hero-video-mobile').click()" class="inline-flex items-center justify-center bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors px-3 py-2 rounded-md border border-zinc-700 text-sm font-medium">
                                        <i data-lucide="upload" class="w-4 h-4 mr-2"></i> Subir
                                    </button>
                                    <input type="file" id="file-hero-video-mobile" class="hidden" accept="video/mp4,video/webm" />
                                </div>
                                <p class="text-xs text-zinc-500 mt-2">Si lo dejas vacío, el home móvil usará el vídeo horizontal como fallback.</p>
                                <div id="loading-hero-video-mobile" class="hidden items-center gap-2 mt-2 text-xs text-rose-500 font-medium">
                                    <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Subiendo vídeo vertical... Esto puede tardar varios minutos.
                                </div>
                            </div>
                            
                            <!-- Video Preview Box -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="bg-zinc-950 border border-zinc-800 rounded-lg p-3">
                                    <p class="text-xs font-medium text-zinc-500 mb-2 uppercase tracking-wide">Vista previa escritorio</p>
                                    <div class="aspect-video bg-black rounded-md overflow-hidden relative shadow-inner ring-1 ring-white/10" id="hero-preview-container">
                                        <div class="absolute inset-0 flex flex-col items-center justify-center text-zinc-600">
                                            <i data-lucide="youtube" class="w-12 h-12 mb-2 opacity-50"></i>
                                            <span class="text-sm font-medium">Introduce un enlace o sube un vídeo</span>
                                        </div>
                                        <iframe id="hero-preview-iframe" class="absolute inset-0 w-full h-full hidden" src="" title="Previsualización escritorio" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    </div>
                                </div>
                                <div class="bg-zinc-950 border border-zinc-800 rounded-lg p-3">
                                    <p class="text-xs font-medium text-zinc-500 mb-2 uppercase tracking-wide">Vista previa móvil</p>
                                    <div class="mx-auto bg-black rounded-md overflow-hidden relative shadow-inner ring-1 ring-white/10" id="hero-mobile-preview-container" style="aspect-ratio: 9 / 16; max-height: 360px;">
                                        <div class="absolute inset-0 flex flex-col items-center justify-center text-zinc-600 px-4 text-center">
                                            <i data-lucide="smartphone" class="w-10 h-10 mb-2 opacity-50"></i>
                                            <span class="text-sm font-medium">Sin vídeo móvil: usará el horizontal</span>
                                        </div>
                                        <iframe id="hero-mobile-preview-iframe" class="absolute inset-0 w-full h-full hidden" src="" title="Previsualización móvil" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Textos del Hero</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 mt-6" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Claim Principal (H1)</label>
                                <textarea name="hero_title" rows="2" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm resize-none" placeholder="Productora Audiovisual en Sevilla">{getVal('hero_title')}</textarea>
                                <p class="text-[10px] text-zinc-500 mt-1">Soporta negritas con **texto** si has activado Markdown en el renderizador.</p>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Subtítulo Descriptivo</label>
                                <textarea name="hero_subtitle" rows="3" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm resize-none">{getVal('hero_subtitle')}</textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab: Contact -->
                <div id="tab-contact" class="tab-content hidden space-y-8">
                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Información de Contacto</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 mt-6" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Email Público</label>
                                <input type="email" name="email" value={getVal('email')} class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Teléfono</label>
                                <input type="text" name="phone" value={getVal('phone')} class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Dirección Física</label>
                                <input type="text" name="address" value={getVal('address')} class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Ubicación Google Maps (URL iframe src)</label>
                                <input type="url" name="google_maps_embed" value={getVal('google_maps_embed')} placeholder="https://www.google.com/maps/embed?pb=..." class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                                <p class="text-xs text-zinc-500 mt-2">Pega la URL (el contenido del "src") de compartir mapa en Google Maps. Esta ubicación se mostrará en el mapa de Quiénes Somos.</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Redes Sociales</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 mt-6" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">Instagram (URL)</label>
                                <input type="url" name="instagram" value={getVal('instagram')} placeholder="https://instagram.com/..." class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">LinkedIn (URL)</label>
                                <input type="url" name="linkedin" value={getVal('linkedin')} placeholder="https://linkedin.com/..." class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">WhatsApp (Opcional, formato internacional +34)</label>
                                <input type="text" name="whatsapp_number" value={getVal('whatsapp_number')} placeholder="+34 600..." class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab: About Section -->
                <div id="tab-about" class="tab-content hidden space-y-8">
                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Vídeo Corporativo</h2>
                        <p class="text-sm text-zinc-400 mt-2 mb-6">Este vídeo aparecerá junto al texto explicativo "Transformamos ideas en contenido", en la segunda pantalla de la página de Quiénes Somos.</p>
                        <div class="grid grid-cols-1" style="gap: 1.5rem;">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">URL del Vídeo de la segunda pantalla (YouTube)</label>
                                <input type="url" name="about_corporate_video" value={getVal('about_corporate_video')} placeholder="https://www.youtube.com/watch?v=..." class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                                <p class="text-xs text-zinc-500 mt-2">El vídeo de fondo de la portada de Quiénes Somos sigue usando el mismo vídeo configurado en Inicio.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tab: Contact Page Section -->
                <div id="tab-contact-page" class="tab-content hidden space-y-8">
                    <div>
                        <h2 class="text-lg font-semibold text-zinc-50 mb-1 border-b border-zinc-800 pb-3">Fondo de la Página de Contacto</h2>
                        <p class="text-sm text-zinc-400 mt-2 mb-6">Si introduces un vídeo, ocupará la portada completa (diseño oscuro). Si lo dejas vacío, se usará el fondo blanco y elegante con puntos por defecto.</p>
                        <div class="grid grid-cols-1 gap-6">
                            <div>
                                <label class="block text-xs font-medium text-zinc-400 mb-1.5">URL del Vídeo Fondo (YouTube o Cloudinary MP4)</label>
                                <div class="flex gap-2">
                                    <input type="text" id="contact_hero_video_url" value={getVal('contact_hero_video')} placeholder="https://www.youtube.com/watch?v=... o subir archivo" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" />
                                    <button type="button" onclick="document.getElementById('file-contact-video').click()" class="inline-flex items-center justify-center bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors px-3 py-2 rounded-md border border-zinc-700 text-sm font-medium">
                                        <i data-lucide="upload" class="w-4 h-4 mr-2"></i> Subir
                                    </button>
                                    <input type="file" id="file-contact-video" class="hidden" accept="video/mp4,video/webm" />
                                </div>
                                <div id="loading-contact-video" class="hidden items-center gap-2 mt-2 text-xs text-rose-500 font-medium">
                                    <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Subiendo vídeo... Esto puede tardar varios minutos.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</AdminLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Tabs Logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Reset all buttons
                tabBtns.forEach(b => {
                    b.classList.remove('bg-zinc-800', 'text-zinc-50');
                    b.classList.add('text-zinc-400');
                    b.querySelector('i')?.classList.replace('text-rose-500', 'text-zinc-500');
                });
                // Hide all contents
                tabContents.forEach(c => c.classList.add('hidden'));

                // Activate clicked
                const targetId = (btn as HTMLElement).dataset.target;
                btn.classList.add('bg-zinc-800', 'text-zinc-50');
                btn.classList.remove('text-zinc-400');
                btn.querySelector('i')?.classList.replace('text-zinc-500', 'text-rose-500');
                document.getElementById(targetId!)?.classList.remove('hidden');
            });
        });

        // Color Sync Logic
function syncColor(pickerId: string, inputId: string) {
            const picker = document.getElementById(pickerId) as HTMLInputElement;
            const input = document.getElementById(inputId) as HTMLInputElement;
            if (picker && input) {
                picker.addEventListener('input', (e) => {
                    input.value = (e.target as HTMLInputElement).value;
                });
                input.addEventListener('input', (e) => {
                    const val = (e.target as HTMLInputElement).value;
                    if (/^#[0-9A-F]{6}$/i.test(val)) {
                        picker.value = val;
                    }
                });
            }
        };
        syncColor('primary_color_picker', 'primary_color_input');
        syncColor('secondary_color_picker', 'secondary_color_input');

        // Video Upload Logic
        async function uploadVideoToCloudinary(file: File, folder: string) {
            const timestamp = Math.round(Date.now() / 1000);
            const signRes = await fetch('/api/admin/cloudinary-sign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folder, timestamp })
            });

            const signData = await signRes.json().catch(() => null);
            if (!signRes.ok || !signData?.signature || !signData?.api_key || !signData?.cloud_name) {
                throw new Error(signData?.error || 'No se pudo preparar la subida a Cloudinary.');
            }

            const cloudinaryFormData = new FormData();
            cloudinaryFormData.append('file', file);
            cloudinaryFormData.append('folder', folder);
            cloudinaryFormData.append('timestamp', String(timestamp));
            cloudinaryFormData.append('api_key', signData.api_key);
            cloudinaryFormData.append('signature', signData.signature);

            const uploadRes = await fetch(`https://api.cloudinary.com/v1_1/${signData.cloud_name}/auto/upload`, {
                method: 'POST',
                body: cloudinaryFormData
            });

            const uploadData = await uploadRes.json().catch(() => null);
            if (!uploadRes.ok || !uploadData?.secure_url) {
                throw new Error(uploadData?.error?.message || `Cloudinary rechazo la subida (${uploadRes.status}).`);
            }

            return uploadData;
        }

        async function setupVideoUpload(inputId: string, fileInputId: string, loadingId: string) {
            const fileInput = document.getElementById(fileInputId) as HTMLInputElement;
            const urlInput = document.getElementById(inputId) as HTMLInputElement;
            const loading = document.getElementById(loadingId)!;

            if (!fileInput || !urlInput || !loading) return;

            fileInput.addEventListener('change', async () => {
                const file = fileInput.files?.[0];
                if (!file) return;

                loading.classList.remove('hidden');
                loading.classList.add('flex');

                try {
                    const data = await uploadVideoToCloudinary(file, 'background_videos');
                    urlInput.value = data.secure_url;
                    updateVideoPreview(urlInput.id, data.secure_url);

                    const saveBtn = document.getElementById('btn-save-all');
                    if (saveBtn) (saveBtn as HTMLButtonElement).click();
                } catch (error) {
                    const message = error instanceof Error ? error.message : 'Error de red al subir video';
                    alert(message);
                } finally {
                    loading.classList.add('hidden');
                    loading.classList.remove('flex');
                    fileInput.value = '';
                }
            });
        }

        setupVideoUpload('hero_video_url', 'file-hero-video', 'loading-hero-video');
        setupVideoUpload('hero_video_mobile_url', 'file-hero-video-mobile', 'loading-hero-video-mobile');

        // Video Preview Logic
        const heroUrlInput = document.getElementById('hero_video_url') as HTMLInputElement;
        const heroMobileUrlInput = document.getElementById('hero_video_mobile_url') as HTMLInputElement;
        
        const getPreviewElements = (inputId: string) => {
            const isMobile = inputId === 'hero_video_mobile_url';
            return {
                container: document.getElementById(isMobile ? 'hero-mobile-preview-container' : 'hero-preview-container'),
                iframe: document.getElementById(isMobile ? 'hero-mobile-preview-iframe' : 'hero-preview-iframe') as HTMLIFrameElement | null,
            };
        };

        const updateVideoPreview = (inputId: string, url: string) => {
            const { container, iframe } = getPreviewElements(inputId);
            if (!container || !iframe) return;

            let videoId = '';
            if (url.includes('youtube.com/watch?v=')) {
                videoId = url.split('v=')[1].split('&')[0];
            } else if (url.includes('youtu.be/')) {
                videoId = url.split('youtu.be/')[1].split('?')[0];
            } else if (url.includes('youtube-nocookie.com/embed/')) {
                videoId = url.split('/embed/')[1].split('?')[0];
            }

            const existingVideo = container.querySelector('video');
            
            if (videoId) {
                if (existingVideo) existingVideo.style.display = 'none';
                iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?loop=1&playlist=${videoId}&mute=1&controls=0`;
                iframe.classList.remove('hidden');
            } else if (url.includes('cloudinary.com') || url.endsWith('.mp4') || url.endsWith('.webm')) {
                iframe.classList.add('hidden');
                iframe.src = '';
                let videoEl = existingVideo;
                if (!videoEl) {
                    videoEl = document.createElement('video');
                    videoEl.className = 'absolute inset-0 w-full h-full object-cover';
                    videoEl.autoplay = true;
                    videoEl.muted = true;
                    videoEl.loop = true;
                    videoEl.playsInline = true;
                    container.appendChild(videoEl);
                }
                videoEl.src = url;
                videoEl.style.display = 'block';
            } else {
                iframe.classList.add('hidden');
                iframe.src = '';
                if (existingVideo) existingVideo.style.display = 'none';
            }
        };

        // Initialize preview if exists
        if (heroUrlInput?.value) updateVideoPreview(heroUrlInput.id, heroUrlInput.value);
        if (heroMobileUrlInput?.value) updateVideoPreview(heroMobileUrlInput.id, heroMobileUrlInput.value);

        // Debounce for URL input
        let previewTimeout: ReturnType<typeof setTimeout>;
        const bindPreviewInput = (input: HTMLInputElement | null) => input?.addEventListener('input', (e) => {
            clearTimeout(previewTimeout);
            const url = (e.target as HTMLInputElement).value;
            previewTimeout = setTimeout(() => {
                updateVideoPreview(input.id, url);
            }, 600);
        });
        bindPreviewInput(heroUrlInput);
        bindPreviewInput(heroMobileUrlInput);

        // Form Submit
        const saveBtn = document.getElementById('btn-save-all');
        const form = document.getElementById('settings-form') as HTMLFormElement;

        saveBtn?.addEventListener('click', async () => {
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Guardando...';
            // @ts-ignore
            if (typeof lucide !== 'undefined') lucide.createIcons();
            saveBtn.setAttribute('disabled', 'true');

            const formData = new FormData(form);
            const data: Record<string, string> = {};
            formData.forEach((value, key) => {
                data[key] = value.toString();
            });

            // Toast implementation
                                    const showToast = (msg: string, type: 'success'|'error') => {
                const container = document.getElementById('toast-container')!;
                const toast = document.createElement('div');
                toast.className = `flex items-center shadow-2xl font-semibold pointer-events-auto ${type === 'success' ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'}`;
                toast.style.cssText = 'padding: 16px 24px; gap: 16px; border-radius: 16px; font-size: 16px; animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);';
                
                if (type === 'success') {
                    toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div><span>${msg}</span>`;
                } else {
                    toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div><span>${msg}</span>`;
                }
                
                container.appendChild(toast);
                setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
            };

            try {
                const res = await fetch('/api/admin/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    showToast('Ajustes guardados correctamente.', 'success');
                } else {
                    const err = await res.json();
                    throw new Error(err.error || 'Error al guardar');
                }
            } catch (err: any) {
                showToast(err.message || 'Error de conexión', 'error');
            } finally {
                saveBtn.innerHTML = originalText;
                saveBtn.removeAttribute('disabled');
                // @ts-ignore
                if (typeof lucide !== 'undefined') lucide.createIcons();
            }
        });
    });
</script>
