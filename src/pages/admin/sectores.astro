---
/**
 * Admin - Sectors Management
 * Restyled with a premium Zinc Dark Mode aesthetic natively
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getSectors } from "../../lib/data";
import { getServiceSupabase } from "../../lib/supabase";
import { getUserFromCookie } from "../../lib/auth";

// SSR auth is handled by middleware
const serviceSupabase = getServiceSupabase()!;

const sectors = await getSectors();
---

<AdminLayout title="Sectores" activeSection="sectores">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4" style="margin-bottom: 3.5rem !important;">
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Sectores</h1>
            <p class="text-zinc-400 text-sm" style="margin-top: 0.75rem !important;">Gestiona los sectores. Total: <span class="text-zinc-100 font-medium">{sectors.length}</span></p>
        </div>
        <button id="btn-add"
            class="inline-flex items-center justify-center bg-rose-600 text-white text-sm font-medium rounded-md hover:bg-rose-500 transition-colors shadow-sm"
            style="padding: 0.5rem 1rem; gap: 0.5rem;"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Nuevo sector
        </button>
    </div>

    <!-- Search Tool / Divider -->
    <div style="margin-bottom: 4rem !important;"></div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left" id="sectors-table">
                <thead class="text-xs text-zinc-500 uppercase tracking-wider font-semibold bg-zinc-900/50">
                    <tr class="border-b border-zinc-800/50">
                        <th style="padding: 1.25rem 1.5rem;">Sector</th>
                        <th class="hidden sm:table-cell w-32" style="padding: 1.25rem 1.5rem;">Vídeo</th>
                        <th class="hidden md:table-cell w-24 text-center" style="padding: 1.25rem 1.5rem;">Orden</th>
                        <th class="text-right hidden sm:table-cell w-24" style="padding: 1.25rem 1.5rem;">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {sectors.map((sector: any) => (
                        <tr class="hover:bg-zinc-800/30 transition-colors group mobile-row-click sm:cursor-default" data-id={sector.id} onclick="const btn = this.querySelector('.btn-edit'); if(btn && !event.target.closest('button')) btn.click();">
                            <td style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-start" style="gap: 0.75rem;">
                                        <div class="w-8 h-8 rounded bg-zinc-950 border border-zinc-800 flex items-center justify-center shrink-0 mt-0.5 text-zinc-400">
                                            <i data-lucide="building-2" class="w-4 h-4"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="font-medium text-zinc-100 mb-0.5">{sector.title}</div>
                                            <div class="text-xs text-zinc-500 line-clamp-1">{sector.description}</div>
                                        </div>
                                    </div>
                                    <i data-lucide="chevron-right" class="w-5 h-5 text-zinc-600 sm:hidden flex-shrink-0"></i>
                                </div>
                            </td>
                            <td class="hidden sm:table-cell" style="padding: 1.25rem 1.5rem;">
                                {sector.video ? (
                                    <span class="inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded text-[10px] font-medium bg-emerald-400/10 text-emerald-400 border border-emerald-400/20 w-fit">
                                        <i data-lucide="check" class="w-3 h-3"></i> Listo
                                    </span>
                                ) : (
                                    <span class="inline-flex items-center justify-center gap-1.5 px-2 py-1 rounded text-[10px] font-medium bg-amber-400/10 text-amber-400 border border-amber-400/20 w-fit">
                                        <i data-lucide="alert-circle" class="w-3 h-3"></i> Faltan
                                    </span>
                                )}
                            </td>
                            <td class="hidden md:table-cell" style="padding: 1rem 1.5rem;">
                                <span class="inline-flex items-center justify-center min-w-[1.5rem] h-6 px-1.5 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs font-medium">{sector.order}</span>
                            </td>
                            <td class="hidden sm:table-cell text-right" style="padding: 1.25rem 1.5rem;">
                                <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button class="p-2 text-zinc-500 hover:text-rose-500 hover:bg-rose-500/10 rounded-lg transition-all btn-edit" data-sector={JSON.stringify(sector)} title="Editar">
                                        <i data-lucide="edit-3" class="w-4.5 h-4.5"></i>
                                    </button>
                                    <button class="p-2 text-zinc-500 hover:text-red-500 hover:bg-red-500/10 rounded-lg transition-all btn-delete" data-id={sector.id} title="Eliminar">
                                        <i data-lucide="trash-2" class="w-4.5 h-4.5"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>

    {sectors.length === 0 && (
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl flex flex-col items-center justify-center text-center" style="padding: 3rem; margin-top: 1.5rem;">
            <div class="w-12 h-12 rounded-full bg-zinc-800/50 flex items-center justify-center border border-zinc-800 mb-4">
                <i data-lucide="building-2" class="w-6 h-6 text-zinc-500"></i>
            </div>
            <h3 class="text-zinc-100 font-semibold mb-1">No hay sectores</h3>
            <p class="text-zinc-400 text-sm mb-6 max-w-sm">No has añadido ningún sector comercial todavía.</p>
            <button onclick="document.getElementById('btn-add').click()" class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-950 border border-zinc-800 text-zinc-300 text-sm font-medium rounded-md hover:bg-zinc-800 hover:text-white transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Crear sector
            </button>
        </div>
    )}
</AdminLayout>

<div id="modal-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-xl w-[calc(100%-2rem)] sm:w-full max-w-2xl shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-zinc-800" style="padding: 1rem 1.5rem;">
            <h3 id="modal-title" class="text-lg font-semibold text-zinc-50 flex items-center gap-2">
                <span>Nuevo sector</span>
            </h3>
            <button id="modal-close-icon" class="p-1.5 text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800 rounded-md transition-colors">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div style="padding: 1.5rem;">
            <div id="m-id" style="display: none;"></div>

            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div class="grid grid-cols-1 sm:grid-cols-2" style="display: grid; gap: 1.5rem;">
                    <div>
                        <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Título *</label>
                        <input type="text" id="m-title" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="Título del sector" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Slug (auto-generado si vacío)</label>
                        <input type="text" id="m-slug" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="mi-sector" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Descripción</label>
                    <textarea id="m-description" rows="3" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm resize-none"></textarea>
                </div>

                <div class="bg-zinc-950/70 border border-zinc-800 rounded-xl" style="padding: 1rem;">
                    <h4 class="text-sm font-semibold text-zinc-100" style="margin-bottom: 1rem;">Textos de la página pública</h4>
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">H1 principal</label>
                            <input type="text" id="m-hero-title" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="Si está vacío usa el título del sector" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Subtítulo bajo el H1 / sobre el vídeo</label>
                            <textarea id="m-hero-subtitle" rows="2" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm resize-none" placeholder="Si está vacío usa la descripción"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">H2 sección inferior</label>
                            <input type="text" id="m-section-title" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="Título de la sección inferior" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Texto de la sección inferior</label>
                            <textarea id="m-section-text" rows="4" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm resize-none" placeholder="Separa párrafos con una línea en blanco"></textarea>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2" style="display: grid; gap: 1.5rem;">
                    <div>
                        <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Vídeo Fondo (YouTube o Cloudinary MP4)</label>
                        <div class="flex gap-2">
                            <input type="text" id="m-video" class="flex-1 px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="URL YouTube o Cloudinary" />
                            <button type="button" onclick="document.getElementById('file-m-video').click()" class="inline-flex items-center justify-center bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors px-3 py-2 rounded-md border border-zinc-700 text-sm font-medium">
                                <i data-lucide="upload" class="w-4 h-4"></i>
                            </button>
                            <input type="file" id="file-m-video" class="hidden" accept="video/mp4,video/webm" />
                        </div>
                        <div id="loading-m-video" class="hidden items-center gap-2 mt-2 text-xs text-rose-500 font-medium">
                            <i data-lucide="loader-2" class="w-3 h-3 animate-spin"></i> Subiendo...
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">URL del vídeo vertical (YouTube)</label>
                        <input type="url" id="m-video-vertical" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" placeholder="https://youtube.com/watch?v=..." />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2" style="display: grid; gap: 1.5rem;">
                    <div>
                        <label class="block text-sm font-medium text-zinc-300" style="margin-bottom: 0.25rem;">Orden</label>
                        <input type="number" id="m-order" class="w-full px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-md text-zinc-100 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors text-sm" value="0" min="0" />
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t border-zinc-800 bg-zinc-950 flex justify-end mt-auto relative" style="padding: 1rem 1.5rem; gap: 0.75rem;">
            <p id="modal-error" class="text-rose-400 text-sm hidden font-medium absolute left-6 top-4"></p>
            <button type="button" id="modal-delete" class="text-sm font-medium text-rose-500 hover:text-rose-400 transition-colors hidden mr-auto" style="padding: 0.5rem 1rem;">Eliminar</button>
            <button type="button" id="modal-cancel" class="text-sm font-medium text-zinc-400 hover:text-white transition-colors" style="padding: 0.5rem 1rem;">Cancelar</button>
            <button type="submit" id="modal-save" class="bg-rose-600 hover:bg-rose-500 text-white text-sm font-semibold rounded-lg shadow-glow transition-all" style="padding: 0.5rem 1rem;">Guardar</button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="confirm-overlay" class="fixed inset-0 bg-zinc-950/80 backdrop-blur-md z-[60] hidden flex items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl w-[calc(100%-2rem)] sm:w-full max-w-[340px] shadow-2xl overflow-hidden" style="animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
        <div style="padding: 2rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
            <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(225,29,72,0.1); border: 1px solid rgba(225,29,72,0.2); display: flex; justify-content: center; align-items: center; margin-bottom: 1.25rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 0.5rem;">¿Eliminar permanentemente?</h3>
            <p style="font-size: 0.875rem; color: #a1a1aa; line-height: 1.4; margin: 0;">Esta acción no se puede deshacer. Los datos serán borrados del sistema.</p>
        </div>
        <div style="display: flex; border-top: 1px solid #27272a; padding: 1rem; gap: 0.75rem; background: #09090b;">
            <button id="confirm-cancel" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #27272a; color: #e4e4e7; font-weight: 500; font-size: 0.9rem; border: 1px solid #3f3f46; cursor: pointer;">Cancelar</button>
            <button id="confirm-yes" style="flex: 1; padding: 0.75rem; border-radius: 12px; background: #e11d48; color: #fff; font-weight: 600; font-size: 0.9rem; border: 1px solid #be123c; cursor: pointer; box-shadow: 0 4px 12px rgba(225,29,72,0.3);">Eliminar</button>
        </div>
    </div>
</div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-6 right-6 z-[70] flex flex-col gap-2" style="pointer-events: none;"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('modal-overlay')!;
        const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
        const errEl = document.getElementById('modal-error')!;
        const modalDeleteBtn = document.getElementById('modal-delete')!;

        function openModal(sector?: any) {
            const isEdit = !!sector;
            const titleSpan = overlay.querySelector('#modal-title span')!;
            titleSpan.textContent = isEdit ? 'Editar sector' : 'Nuevo sector';
            
            $('m-id').value = sector?.id || '';
            $('m-title').value = sector?.title || '';
            $('m-slug').value = sector?.slug || '';
            ($('m-description') as unknown as HTMLTextAreaElement).value = sector?.description || '';
            $('m-hero-title').value = sector?.hero_title || '';
            ($('m-hero-subtitle') as unknown as HTMLTextAreaElement).value = sector?.hero_subtitle || '';
            $('m-section-title').value = sector?.section_title || '';
            ($('m-section-text') as unknown as HTMLTextAreaElement).value = sector?.section_text || '';
            $('m-video').value = sector?.video || '';
            $('m-video-vertical').value = sector?.video_vertical || '';
            $('m-order').value = String(sector?.order ?? 0);
            
            if (isEdit) modalDeleteBtn.classList.remove('hidden');
            else modalDeleteBtn.classList.add('hidden');
            
            errEl.classList.add('hidden');
            overlay.classList.remove('hidden');
        }

        function closeModal() {
            overlay.classList.add('hidden');
        }

        document.getElementById('btn-add')?.addEventListener('click', () => openModal());
        document.getElementById('modal-cancel')?.addEventListener('click', closeModal);
        document.getElementById('modal-close-icon')?.addEventListener('click', closeModal);

        // Close on outside click is disabled
        // overlay.addEventListener('click', (e) => {
        //     if (e.target === overlay) closeModal();
        // });

        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', () => {
                const sector = JSON.parse((btn as HTMLElement).dataset.sector || '{}');
                openModal(sector);
            });
        });

        modalDeleteBtn.addEventListener('click', () => {
            closeModal();
            const id = $('m-id').value;
            if (id) {
                const deleteBtn = document.querySelector(`.btn-delete[data-id="${id}"]`) as HTMLButtonElement;
                if (deleteBtn) deleteBtn.click();
            }
        });

        // Confirm modal logic
        const confirmOverlay = document.getElementById('confirm-overlay')!;
        const confirmYes = document.getElementById('confirm-yes')!;
        const confirmCancel = document.getElementById('confirm-cancel')!;
        let pendingDeleteId: string | null = null;

        function openConfirm(id: string) {
            pendingDeleteId = id;
            confirmOverlay.classList.remove('hidden');
        }
        function closeConfirm() {
            pendingDeleteId = null;
            confirmOverlay.classList.add('hidden');
        }
        confirmCancel.addEventListener('click', closeConfirm);
        // confirmOverlay.addEventListener('click', (e) => { if (e.target === confirmOverlay) closeConfirm(); });

        confirmYes.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            confirmYes.textContent = 'Eliminando...';
            (confirmYes as HTMLButtonElement).disabled = true;
            const res = await fetch('/api/admin/sectors', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: pendingDeleteId }),
            });
            if (res.ok) location.reload();
            else {
                showToast('Error al eliminar', 'error');
                closeConfirm();
                confirmYes.textContent = 'Eliminar';
                (confirmYes as HTMLButtonElement).disabled = false;
            }
        });

        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', () => {
                openConfirm((btn as HTMLElement).dataset.id!);
            });
        });

        // Toast notification
                                function showToast(message: string, type: 'error' | 'success' = 'error') {
            const container = document.getElementById('toast-container')!;
            const toast = document.createElement('div');
            toast.className = `flex items-center shadow-2xl font-semibold pointer-events-auto ${
                type === 'success' ? 'bg-emerald-500 text-white shadow-emerald-500/30' : 'bg-rose-500 text-white shadow-rose-500/30'
            }`;
            toast.style.cssText = 'padding: 16px 24px; gap: 16px; border-radius: 16px; font-size: 16px; animation: toast-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);';
            if (type === 'success') {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></div><span>${message}</span>`;
            } else {
                toast.innerHTML = `<div class="bg-white/20 p-1.5 rounded-full flex items-center justify-center"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-5 h-5" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></div><span>${message}</span>`;
            }
            container.appendChild(toast);
            setTimeout(() => { toast.style.animation = 'toast-out 0.3s ease-in forwards'; setTimeout(() => toast.remove(), 300); }, 4000);
        }

        // Setup Video Upload
        const fileInputVideo = document.getElementById('file-m-video') as HTMLInputElement;
        if (fileInputVideo) {
            fileInputVideo.addEventListener('change', async () => {
                const file = fileInputVideo.files?.[0];
                if (!file) return;

                const loading = document.getElementById('loading-m-video')!;
                loading.classList.remove('hidden');
                loading.classList.add('flex');

                const formData = new FormData();
                formData.append('file', file);
                formData.append('folder', 'background_videos');

                try {
                    const res = await fetch('/api/admin/upload', {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        $('m-video').value = data.url;
                        showToast('Vídeo subido correctamente', 'success');
                    } else {
                        const err = await res.json();
                        showToast(err.error || 'Error al subir vídeo', 'error');
                    }
                } catch (error) {
                    showToast('Error de conexión al subir vídeo', 'error');
                } finally {
                    loading.classList.add('hidden');
                    loading.classList.remove('flex');
                    fileInputVideo.value = '';
                }
            });
        }

        document.getElementById('modal-save')?.addEventListener('click', async () => {
            const title = $('m-title').value.trim();
            if (!title) {
                errEl.textContent = 'El título es obligatorio';
                errEl.classList.remove('hidden');
                return;
            }

            const btn = document.getElementById('modal-save')!;
            const oHtml = btn.innerHTML;
            btn.innerHTML = 'Guardando...';
            btn.setAttribute('disabled', 'true');

            const body: any = {
                title,
                slug: $('m-slug').value.trim() || null,
                description: ($('m-description') as unknown as HTMLTextAreaElement).value.trim() || null,
                hero_title: $('m-hero-title').value.trim() || null,
                hero_subtitle: ($('m-hero-subtitle') as unknown as HTMLTextAreaElement).value.trim() || null,
                section_title: $('m-section-title').value.trim() || null,
                section_text: ($('m-section-text') as unknown as HTMLTextAreaElement).value.trim() || null,
                video: $('m-video').value.trim() || null,
                video_vertical: $('m-video-vertical').value.trim() || null,
                order: parseInt($('m-order').value) || 0,
            };

            const isEdit = !!$('m-id').value;
            if (isEdit) body.id = $('m-id').value;

            try {
                const res = await fetch('/api/admin/sectors', {
                    method: isEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body),
                });

                if (res.ok) {
                    location.reload();
                } else {
                    const err = await res.json();
                    errEl.textContent = err.error || 'Error';
                    errEl.classList.remove('hidden');
                    btn.innerHTML = oHtml;
                    btn.removeAttribute('disabled');
                }
            } catch (e) {
                errEl.textContent = 'Error conexión';
                errEl.classList.remove('hidden');
                btn.innerHTML = oHtml;
                btn.removeAttribute('disabled');
            }
        });
    });
</script>
</AdminLayout>
