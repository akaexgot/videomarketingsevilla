---
/**
 * Sector Detail Page — Fullscreen Video Hero + Fullpage Scroll
 * Screen 1: Video hero with title
 * Screen 2: White content with description, CTA, related sectors
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

import "../../styles/detail.css";
import { getSectorBySlug, getSectors } from "../../lib/data";
import { getVideoId } from "../../lib/display";
import { buildBreadcrumbSchema, buildSectorSchema, getVideoThumbnail } from "../../lib/seo";


const { slug } = Astro.params;
const sector = await getSectorBySlug(slug || "");

if (!sector) {
    return Astro.redirect("/sectores");
}

const allSectors = await getSectors();
const otherSectors = allSectors.filter((s: any) => s.slug !== slug).slice(0, 3);

const isNative = (url: string | null | undefined) => !!url && (url.includes('cloudinary.com') || url.endsWith('.mp4') || url.endsWith('.webm'));

const videoUrl = sector.video;
const videoIsNative = isNative(videoUrl);
const videoId = !videoIsNative ? getVideoId(videoUrl) : null;

const videoVerticalUrl = sector.video_vertical;
const videoVerticalIsNative = isNative(videoVerticalUrl);
const videoVerticalId = !videoVerticalIsNative ? getVideoId(videoVerticalUrl) : null;
const pagePath = `/sectores/${sector.slug}`;
const structuredData = [
    buildBreadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Sectores', path: '/sectores' },
        { name: sector.title, path: pagePath },
    ]),
    buildSectorSchema(sector, pagePath),
];

const heroTitle = sector.hero_title || `Video Marketing para ${sector.title}`;
const heroSubtitle = sector.hero_subtitle || sector.description;
const defaultSectionTitle = `Producción audiovisual para el sector ${sector.title.toLowerCase()}`;
const defaultSectionText = `${sector.description || ''}\n\nConocemos las particularidades del sector ${sector.title.toLowerCase()} y sabemos cómo comunicar tu propuesta de valor a tu público objetivo. Nuestro equipo produce contenido audiovisual que habla el lenguaje de tu industria.`;
const sectionTitle = sector.section_title || defaultSectionTitle;
const sectionText = sector.section_text || defaultSectionText;
const sectionTextParagraphs = sectionText
    .split(/\n{2,}/)
    .map((text: string) => text.trim())
    .filter(Boolean);
---

<BaseLayout
    title={`Video Marketing para ${sector.title} en Sevilla`}
    image={sector.thumbnail || getVideoThumbnail(sector.video)}
    structuredData={structuredData}
    description={`Producción audiovisual especializada en ${sector.title.toLowerCase()}. ${sector.description}`}
>

    <!-- ═══ SCREEN 1: VIDEO HERO ═══ -->
    <section class="detail-hero" id="detail-hero">
        <div class="detail-hero__bg">
            {videoIsNative ? (
                <video aria-hidden="true" src={videoUrl} 
                    class="detail-hero__iframe" 
                    autoplay loop muted playsinline 
                    style="object-fit: cover;"
                ></video>
            ) : videoId ? (
                <iframe
                    src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1`}
                    class="detail-hero__iframe"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    title={`Vídeo de ${sector.title}`}
                ></iframe>
            ) : (
                <div class="detail-hero__fallback">
                    <span class="detail-hero__fallback-icon">{sector.icon}</span>
                </div>
            )}
        </div>
        <div class="detail-hero__overlay"></div>

        <!-- Back link -->
        <a href="/sectores" class="detail-hero__back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a sectores
        </a>

        <!-- Content -->
        <div class="detail-hero__content">
            <div class="detail-hero__badge">
                <span class="detail-hero__dot"></span>
                <span>Sector</span>
            </div>
            <h1 class="detail-hero__title">{heroTitle}</h1>
            {heroSubtitle && <p class="detail-hero__subtitle">{heroSubtitle}</p>}
        </div>

        <!-- Scroll indicator -->
        <div class="detail-hero__scroll">
            <span>Descubre más</span>
            <div class="detail-hero__scroll-arrow">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </div>
        </div>
    </section>

    <!-- ═══ SCREEN 2: CONTENT ═══ -->
    <section class="detail-content" id="detail-content">
        <div class="detail-content__inner">

            <!-- Description with optional vertical video -->
            <div class="detail-desc reveal">
                <div class={`detail-desc__layout ${(videoVerticalUrl || videoVerticalId) ? 'detail-desc__layout--with-video' : ''}`}>
                    {videoVerticalUrl || videoVerticalId ? (
                        <div class="detail-vertical-video">
                            <div class="detail-vertical-video__frame">
                                {videoVerticalIsNative ? (
                                    <video aria-hidden="true" src={videoVerticalUrl} 
                                        class="detail-vertical-video__iframe vm-exclusive-video" 
                                        autoplay loop muted playsinline 
                                        style="object-fit: cover;"
                                    ></video>
                                ) : (
                                    <iframe
                                        src={`https://www.youtube-nocookie.com/embed/${videoVerticalId}?autoplay=0&mute=1&controls=1&showinfo=0&rel=0&modestbranding=1&playsinline=1&enablejsapi=1`}
                                        class="detail-vertical-video__iframe vm-exclusive-video"
                                        frameborder="0"
                                        allow="autoplay; encrypted-media"
                                        title={`Vídeo vertical de ${sector.title}`}
                                    ></iframe>
                                )}
                            </div>
                        </div>
                    ) : null}
                    <div class="detail-desc__text">
                        <h2 class="detail-desc__heading">{sectionTitle}</h2>
                        <div class="detail-desc__body">
                            {sectionTextParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                        </div>
                        <!-- CTA -->
                        <div class="detail-cta reveal" style="margin-top: 2rem;">
                            <h3 class="detail-cta__title">¿Necesitas vídeo para {sector.title.toLowerCase()}?</h3>
                            <p class="detail-cta__text">Solicita tu presupuesto personalizado sin compromiso</p>
                            <a href="/contacto" class="detail-cta__btn">
                                Solicitar presupuesto
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Related Sectors -->
            <div class="detail-related reveal">
                <h2 class="detail-related__title">Otros sectores</h2>
                <div class="detail-related__grid">
                    {otherSectors.map((s: any) => (
                        <a href={`/sectores/${s.slug}`} class="detail-related__card">
                            <div class="detail-related__icon">{s.icon}</div>
                            <div>
                                <div class="detail-related__name">{s.title}</div>
                                <div class="detail-related__sub">{s.description}</div>
                            </div>
                            <svg class="detail-related__arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </a>
                    ))}
                </div>
            </div>

        </div>
    </section>

    <!-- ═══ FAQ SECTION ═══ -->


</BaseLayout>

<script>
    /* ── Fullpage Scroll ── */
    document.addEventListener('DOMContentLoaded', () => {
        return;

        const sections = Array.from(document.querySelectorAll('section'));
        if (sections.length === 0) return;

        // Solo activar scroll snap en escritorio (>1024px)
        if (window.innerWidth <= 1024) return;

        let isScrolling = false;
        let scrollTimeout: ReturnType<typeof setTimeout>;
        

        function getVisibleSectionIndex() {
            let maxIdx = 0, maxArea = 0;
            sections.forEach((sec, idx) => {
                const r = sec.getBoundingClientRect();
                const visible = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
                if (visible > maxArea) { maxArea = visible; maxIdx = idx; }
            });
            return maxIdx;
        }

        function scrollToSection(index: number) {
            if (index < 0 || index >= sections.length || isScrolling) return;
            isScrolling = true;
            sections[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                isScrolling = false;
            }, 1300);
        }

        window.addEventListener('wheel', (e) => {
            e.preventDefault();
            if (isScrolling) return;

            const currentIndex = getVisibleSectionIndex();
            if (e.deltaY > 0) {
                scrollToSection(currentIndex + 1);
            } else if (e.deltaY < 0) {
                scrollToSection(currentIndex - 1);
            }
        }, { passive: false });

        let touchStartY = 0;
        window.addEventListener('touchstart', (e) => { touchStartY = e.changedTouches[0].screenY; }, { passive: false });
        window.addEventListener('touchmove', (e) => { e.preventDefault(); }, { passive: false });
        window.addEventListener('touchend', (e) => {
            if (isScrolling) return;
            const delta = touchStartY - e.changedTouches[0].screenY;
            const cur = getVisibleSectionIndex();
            if (delta > 50) scrollToSection(cur + 1);
            else if (delta < -50) scrollToSection(cur - 1);
        }, { passive: false });

        window.addEventListener('keydown', (e) => {
            const keys = ['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' '];
            if (keys.includes(e.key)) {
                e.preventDefault();
                if (isScrolling) return;
                const cur = getVisibleSectionIndex();
                if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') scrollToSection(cur + 1);
                else scrollToSection(cur - 1);
            }
        }, { passive: false });
    });
</script>
