---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/data";
import { getMailtoHref } from "../lib/contact";

const settings = await getSettings();
const emailHref = getMailtoHref(settings.email);
---

<BaseLayout
    title="Política de Privacidad"
    description="Política de privacidad de VideoMarketing Sevilla. Información sobre el tratamiento de datos personales."
>
    <section class="pt-32 pb-24">
        <div class="section-container">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-[Outfit] font-bold text-white mb-8">
                    Política de Privacidad
                </h1>
                <div
                    class="prose prose-invert prose-sm text-light-muted leading-relaxed space-y-6"
                >
                    <p>Última actualización: Marzo 2024</p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        1. Responsable del tratamiento
                    </h2>
                    <p>
                        VideoMarketing Sevilla es responsable del tratamiento de
                        los datos personales que nos proporciones a través de
                        este sitio web.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        2. Datos que recopilamos
                    </h2>
                    <p>
                        Recopilamos los datos que nos proporcionas
                        voluntariamente a través del formulario de contacto:
                        nombre, email, teléfono, empresa y mensaje.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        3. Finalidad del tratamiento
                    </h2>
                    <p>
                        Los datos se utilizan exclusivamente para responder a
                        tus consultas y enviarte información sobre nuestros
                        servicios de producción audiovisual.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        4. Base legal
                    </h2>
                    <p>
                        El tratamiento de tus datos se basa en tu consentimiento
                        al enviar el formulario de contacto.
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        5. Derechos
                    </h2>
                    <p>
                        Puedes ejercer tus derechos de acceso, rectificación,
                        supresión, oposición y portabilidad enviando un email a
                        <a href={emailHref}>{settings.email}</a>
                    </p>

                    <h2
                        class="text-xl font-[Outfit] font-semibold text-white mt-8"
                    >
                        6. Conservación de datos
                    </h2>
                    <p>
                        Los datos se conservarán mientras dure la relación
                        comercial y durante los plazos legales establecidos.
                    </p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
