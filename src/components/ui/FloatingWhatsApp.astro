---
import { getSettings } from "../../lib/data";
import { getWhatsappHref } from "../../lib/contact";

const settings = await getSettings();
const whatsappNumber = String(settings.whatsapp_number || settings.phone || "34602447557").replace(/\D/g, "");
const whatsappHref = getWhatsappHref(whatsappNumber, "Hola, me gustaria hablar con VideoMarketing Sevilla.");
---

{whatsappNumber && (
    <a
        class="floating-whatsapp"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Abrir WhatsApp de VideoMarketing Sevilla"
        title="WhatsApp"
        data-ga-event="whatsapp_click"
        data-ga-method="whatsapp"
    >
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/>
            <path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 005.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89A11.82 11.82 0 0012.05 0zm0 21.79h-.01a9.87 9.87 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88z"/>
        </svg>
    </a>
)}

<style>
    .floating-whatsapp {
        position: fixed;
        right: clamp(1rem, 2.4vw, 1.6rem);
        bottom: clamp(1rem, 2.4vw, 1.6rem);
        z-index: 60;
        width: 60px;
        height: 60px;
        display: grid;
        place-items: center;
        color: #fff;
        background: #25d366;
        border-radius: 50%;
        box-shadow: 0 18px 38px rgba(37, 211, 102, .34), 0 6px 16px rgba(0, 0, 0, .18);
        text-decoration: none;
        transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
    }

    .floating-whatsapp svg {
        width: 30px;
        height: 30px;
        fill: currentColor;
    }

    .floating-whatsapp:hover,
    .floating-whatsapp:focus-visible {
        background: #1fbd5b;
        transform: translateY(-3px) scale(1.03);
        box-shadow: 0 22px 44px rgba(37, 211, 102, .42), 0 8px 20px rgba(0, 0, 0, .2);
        outline: none;
    }

    @media (max-width: 1024px) {
        .floating-whatsapp {
            right: 1rem;
            bottom: calc(5.35rem + env(safe-area-inset-bottom, 0px));
            width: 54px;
            height: 54px;
        }

        .floating-whatsapp svg {
            width: 27px;
            height: 27px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .floating-whatsapp {
            transition: none;
        }
    }
</style>
