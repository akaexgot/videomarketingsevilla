---
/**
 * Footer — Premium Split-Screen with Elegant Right Grid
 */
import {
    getNavigation,
    getServices,
    getSettings,
    getFooterData,
} from "../../lib/data";

const navigation = await getNavigation();
const services = await getServices();
const settings = await getSettings();
const footerData = await getFooterData();
---

<section id="site-footer" class="footer-screen">
    <div class="f-split">
        
        <!-- ═══════════════════════════════════════════════════════
             LEFT HALF: Pure Brand Experience
             ═══════════════════════════════════════════════════════ -->
        <div class="f-left group">
            <div class="absolute inset-0 bg-white/60 opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
            
            <div class="f-brand-seal relative z-10 transition-transform duration-1000 group-hover:scale-105">
                <div class="f-spin-ring">
                    <svg viewBox="0 0 200 200" class="f-spin-svg">
                        <defs>
                            <path id="textCircle" d="M 100, 100 m -75, 0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0" />
                        </defs>
                        <text class="f-spin-text" textLength="430" lengthAdjust="spacing">
                            <textPath href="#textCircle" startOffset="0%">
                                PRODUCTORA AUDIOVISUAL • 
                            </textPath>
                        </text>
                    </svg>
                </div>
                <div class="f-logo-center">
                    <img src="/logo-oscuro-web.png" alt="VideoMarketing Sevilla" width="162" height="59" class="w-full h-auto object-contain" />
                </div>
            </div>
        </div>

        <!-- DIVIDER -->
        <div class="hidden lg:block w-px bg-black/8"></div>
        <div class="block lg:hidden h-px w-full bg-black/8"></div>

        <!-- ═══════════════════════════════════════════════════════
             RIGHT HALF: Elegant Navigation & Info
             ═══════════════════════════════════════════════════════ -->
        <div class="f-right">
            <div class="f-right-inner">
                
                <!-- Top Section: Pages as elegant stacked rows -->
                <div class="f-nav-section">
                    <p class="f-section-label">Explora</p>
                    <nav class="f-nav-stack">
                        {navigation.map((item: any, i: number) => (
                            <a href={item.href} class="f-nav-row group" style={`transition-delay: ${i * 50}ms`}>
                                <span class="f-nav-number">{String(i + 1).padStart(2, '0')}</span>
                                <span class="f-nav-label">{item.label}</span>
                                <span class="f-nav-arrow">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </span>
                            </a>
                        ))}
                    </nav>
                </div>

                <!-- Bottom Section: Contact + Social in elegant grid -->
                <div class="f-info-section">
                    <div class="f-info-grid">
                        <!-- Contact -->
                        <div class="f-info-col">
                            <p class="f-section-label">Contacto</p>
                            <div class="f-info-items">
                                <a href={`mailto:${settings.email}`} class="f-info-link">{settings.email}</a>
                                <a href={`tel:${settings.phone}`} data-ga-event="click_phone" data-ga-method="phone" class="f-info-link">{settings.phone}</a>
                                <span class="f-info-muted">{settings.address}</span>
                            </div>
                        </div>
                        <!-- Social -->
                        <div class="f-info-col">
                            <p class="f-section-label">Síguenos</p>
                            <div class="f-info-items">
                                <a href={settings.instagram} target="_blank" rel="noopener" class="f-social-link">
                                    <span class="f-social-dot" style="background:#E1306C"></span>
                                    Instagram
                                </a>
                                <a href={settings.linkedin} target="_blank" rel="noopener" class="f-social-link">
                                    <span class="f-social-dot" style="background:#0A66C2"></span>
                                    LinkedIn
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Legal footer pinned to bottom -->
            <div class="f-legal-bar">
                <p>© 2026 VideoMarketing Sevilla</p>
                <div class="f-legal-links">
                    <a href="/privacidad">Privacidad</a>
                    <a href="/aviso-legal">Aviso Legal</a>
                    <a href="/cookies">Cookies</a>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
/* ═══════════════════════════════════════════════════════════
   FOOTER: Split-Screen Premium Layout
   ═══════════════════════════════════════════════════════════ */

.footer-screen {
    width: 100%;
    background: #FAFAFA;
    border-top: 1px solid rgba(0,0,0,0.06);
}

.f-split {
    display: flex;
    flex-direction: column;
    min-height: 90vh;
}
@media (min-width: 1024px) {
    .f-split { flex-direction: row; }
}

/* ── LEFT HALF ─────────────────────────────────────────── */
.f-left {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5rem 3rem;
    position: relative;
    overflow: hidden;
}
@media (min-width: 1024px) {
    .f-left {
        width: 45%;
        padding: 6rem;
    }
}

/* ── Brand Seal ────────────────────────────────────────── */
.f-brand-seal {
    position: relative;
    width: clamp(280px, 30vw, 420px);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

.f-spin-ring {
    position: absolute;
    inset: 0;
    animation: spin 40s linear infinite;
    opacity: 0.9;
}

.f-spin-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
}

.f-spin-text {
    font-size: 18.5px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    fill: #1a1a2e;
    letter-spacing: 2px;
}

.f-logo-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 58%;
    height: 58%;
    display: flex;
    align-items: center;
    justify-content: center;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ── RIGHT HALF ────────────────────────────────────────── */
.f-right {
    width: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    padding: 0;
}
@media (min-width: 1024px) {
    .f-right { width: 55%; }
}

.f-right-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 2rem 3rem;
}
@media (min-width: 1024px) {
    .f-right-inner {
        padding: 7rem 5rem 4rem;
    }
}

/* ── Section Labels ────────────────────────────────────── */
.f-section-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #525252;
    margin-bottom: 1.5rem;
}

/* ── Navigation Stack ──────────────────────────────────── */
.f-nav-section {
    margin-bottom: 3.5rem;
}

.f-nav-stack {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(0,0,0,0.08);
}

.f-nav-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0.75rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 0;
}
.f-nav-row:hover {
    background: rgba(186, 25, 41, 0.03);
    padding-left: 1.25rem;
}

.f-nav-number {
    font-family: 'Outfit', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: #ba1929;
    opacity: 0.8;
    min-width: 1.5rem;
    transition: opacity 0.3s ease;
}
.f-nav-row:hover .f-nav-number {
    opacity: 1;
}

.f-nav-label {
    font-family: var(--ff-display, 'Outfit', sans-serif);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 600;
    color: #111827;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
    flex: 1;
}
.f-nav-row:hover .f-nav-label {
    color: #ba1929;
}

.f-nav-arrow {
    color: #ba1929;
    opacity: 0;
    transform: translateX(-12px);
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}
.f-nav-row:hover .f-nav-arrow {
    opacity: 1;
    transform: translateX(0);
}

/* ── Info Section ──────────────────────────────────────── */
.f-info-section {
    padding-top: 2rem;
}

.f-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
}
@media (min-width: 640px) {
    .f-info-grid { grid-template-columns: 1fr 1fr; }
}

.f-info-col {
    display: flex;
    flex-direction: column;
}

.f-info-items {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.f-info-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: #111827;
    text-decoration: none;
    transition: color 0.3s ease;
    width: fit-content;
}
.f-info-link:hover {
    color: #ba1929;
}

.f-info-muted {
    font-size: 0.85rem;
    color: #525252;
    margin-top: 0.25rem;
}

/* ── Social Links ──────────────────────────────────────── */
.f-social-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #111827;
    text-decoration: none;
    transition: color 0.3s ease;
    width: fit-content;
}
.f-social-link:hover {
    color: #ba1929;
}

.f-social-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
}

/* ── Legal Bar ─────────────────────────────────────────── */
.f-legal-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-top: 1px solid rgba(0,0,0,0.06);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #525252;
}
@media (min-width: 768px) {
    .f-legal-bar {
        flex-direction: row;
        padding: 1.5rem 5rem;
    }
}

.f-legal-bar p { margin: 0; }

.f-legal-links {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
}
.f-legal-links a {
    color: #525252;
    text-decoration: none;
    transition: color 0.3s ease;
}
.f-legal-links a:hover {
    color: #111827;
}
</style>
