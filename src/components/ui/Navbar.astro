---
/**
 * Navbar — Estado único, sin conflictos
 */
import { getNavigation } from "../../lib/data";
const allNavigation = await getNavigation();
const navigation = allNavigation.filter((item: any) => !['Servicios', 'Sectores'].includes(item.label));
const headerPhone = "602447557";
const headerWhatsapp = "34602447557";
const headerWhatsappText = encodeURIComponent("Hola, me gustaria hablar con VideoMarketing Sevilla.");
---

<nav id="navbar" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
    <div id="nav-bg" class="absolute inset-0 -z-10 transition-all duration-300"></div>

    <div class="section-container relative lg:pt-[env(safe-area-inset-top)]">
        <div id="nav-inner" class="flex items-center justify-between h-14 lg:h-24 transition-all duration-300">
            <!-- Izquierda: Logo (dual images for scroll swap) -->
            <a href="/" id="nav-logo-link" class="flex lg:flex-1 items-center justify-start group relative select-none">
                <div class="relative h-12 lg:h-14 lg:min-w-[120px]">
                    <img id="nav-logo-white" src="/logo-blanco-web.png" alt="VideoMarketing Sevilla Logo" width="200" height="56" class="h-12 lg:h-14 w-auto object-contain transition-all duration-500 group-hover:scale-105 absolute inset-0" style="opacity:1" />
                    <img id="nav-logo-dark" src="/logo-oscuro-web.png" alt="VideoMarketing Sevilla Logo" width="200" height="56" class="h-12 lg:h-14 w-auto object-contain transition-all duration-500 group-hover:scale-105 absolute inset-0" style="opacity:0" />
                </div>
            </a>

            <!-- Centro: Links (Absolutamente centrados) -->
            <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center gap-6">
                {navigation.map((item: any) => (
                    <a
                        href={item.href}
                        class="nav-link relative px-3 py-2 text-base lg:text-lg font-medium transition-colors duration-300 hover:opacity-100 line-animated tracking-wide"
                        data-href={item.href}
                    >
                        {item.label}
                    </a>
                ))}
            </div>

            <!-- Derecha: CTA (desktop only) -->
            <div class="hidden lg:flex lg:flex-1 items-center justify-end gap-3">
                <a
                    href={`tel:${headerPhone}`}
                    class="nav-action flex items-center justify-center w-11 h-11 rounded-full border transition-all duration-300 hover:bg-carmin hover:border-carmin hover:text-white"
                    title="Llamar"
                    aria-label="Llamar a VideoMarketing Sevilla"
                    data-ga-event="phone_click"
                    data-ga-method="header_phone"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.21l-2.26 1.13a11.04 11.04 0 005.52 5.52l1.13-2.26a1 1 0 011.21-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z"/>
                    </svg>
                </a>
                <a
                    href={`https://wa.me/${headerWhatsapp}?text=${headerWhatsappText}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="nav-action flex items-center justify-center w-11 h-11 rounded-full border transition-all duration-300 hover:bg-[#25D366] hover:border-[#25D366] hover:text-white"
                    title="WhatsApp"
                    aria-label="Abrir WhatsApp de VideoMarketing Sevilla"
                    data-ga-event="whatsapp_click"
                    data-ga-method="header_whatsapp"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/>
                        <path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 005.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89A11.82 11.82 0 0012.05 0zm0 21.79h-.01a9.87 9.87 0 01-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 01-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 012.89 6.99c0 5.45-4.44 9.88-9.88 9.88z"/>
                    </svg>
                </a>
                <a
                    href="/portal-clientes"
                    id="nav-cta"
                    class="nav-action flex items-center justify-center w-11 h-11 rounded-full border transition-all duration-300 hover:bg-carmin hover:border-carmin hover:text-white"
                    title="Portal de Clientes"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- Mobile menu (hidden, handled by bottom bar) -->
<div id="mobile-menu" class="hidden"></div>

<script>
(function () {
    const navbar   = document.getElementById('navbar')!;
    const navBg    = document.getElementById('nav-bg')!;
    const navBrand = document.getElementById('nav-brand');
    const navActions = navbar.querySelectorAll<HTMLElement>('.nav-action');
    const navInner = document.getElementById('nav-inner')!;
    const links    = navbar.querySelectorAll<HTMLElement>('.nav-link');
    const lines    = navbar.querySelectorAll<HTMLElement>('.hamburger-line');

    const path        = window.location.pathname;
    const lightPages  = ['/portal-clientes'];
    const isLightPage = lightPages.some(p => path === p || path.startsWith(p + '/'));
    const isProjectPage = path.startsWith('/proyectos/') && path !== '/proyectos';

    // ── Estilos por tema ──────────────────────────────────────────────
    // DARK TRANSPARENT: encima de video/dark section sin scroll
    const isMobile = typeof window !== 'undefined' && window.innerWidth <= 1024;
    const STYLE_DARK_TRANSPARENT = {
        bg: isMobile 
            ? 'transparent'
            : 'linear-gradient(to bottom, rgba(5,5,8,0.55) 0%, rgba(5,5,8,0.12) 65%, transparent 100%)',
        bgFilter:   'none',
        border:     'none',
        linkColor:  'rgba(255,255,255,0.80)',
        linkHover:  '#ffffff',
        brand:      '#ffffff',
        cta:        { color: '#ffffff', border: 'rgba(255,255,255,0.15)', bg: 'rgba(255,255,255,0.05)' },
        lines:      '#ffffff',
        height:     true,   // h-24
    };

    // DARK SOLID: scroll hacia abajo
    // Fondo blanco con letras rojas solicitado por el usuario
    const STYLE_DARK_SOLID = {
        bg:         '#ffffff', 
        bgFilter:   'none',
        border:     '0 1px 0 0 rgba(0,0,0,0.1)',
        linkColor:  '#ba1929', 
        linkHover:  '#9b1422',
        brand:      '#ba1929',
        cta:        { color: '#ba1929', border: 'rgba(186,25,41,0.2)', bg: 'rgba(186,25,41,0.05)' },
        lines:      '#ba1929',
        height:     false,  // h-18
    };

    // LIGHT_TOP: páginas blancas sin scroll
    const STYLE_LIGHT_TOP = {
        bg:         'transparent',
        bgFilter:   'none',
        border:     'none',
        linkColor:  '#525252',
        linkHover:  '#111111',
        brand:      '#111111',
        cta:        { color: '#111111', border: 'rgba(0,0,0,0.12)', bg: 'rgba(0,0,0,0.04)' },
        lines:      '#111111',
        height:     false,
    };



    // Logo elements
    const logoWhite = document.getElementById('nav-logo-white') as HTMLImageElement | null;
    const logoDark  = document.getElementById('nav-logo-dark') as HTMLImageElement | null;

    function applyStyle(s: typeof STYLE_DARK_TRANSPARENT) {
        const mobile = window.innerWidth <= 1024;
        
        // Si es móvil y se pide el estilo "solid", usamos una versión oscura en vez de blanca para no desentonar
        const isDarkSolidMobile = mobile && s === STYLE_DARK_SOLID;

        // Ocultar completamente la barra en móvil al hacer scroll hacia abajo
        if (isDarkSolidMobile) {
            navbar.style.transform = 'translateY(-100%)';
        } else {
            navbar.style.transform = 'translateY(0)';
        }

        // Fondo
        navBg.style.background       = isDarkSolidMobile ? 'rgba(5,5,8,0.95)' : s.bg;
        navBg.style.backdropFilter   = isDarkSolidMobile ? 'blur(10px)' : s.bgFilter;
        (navBg.style as any).webkitBackdropFilter = isDarkSolidMobile ? 'blur(10px)' : s.bgFilter;
        navBg.style.boxShadow        = isDarkSolidMobile ? '0 1px 0 0 rgba(255,255,255,0.05)' : s.border;
        navBg.style.opacity          = '1';

        // Links
        links.forEach(l => {
            l.style.color = isDarkSolidMobile ? '#ffffff' : s.linkColor;
            l.onmouseenter = () => { l.style.color = isDarkSolidMobile ? '#ffffff' : s.linkHover; };
            l.onmouseleave = () => { l.style.color = isDarkSolidMobile ? '#ffffff' : s.linkColor; };
        });

        // Brand
        if (navBrand) navBrand.style.color = isDarkSolidMobile ? '#ffffff' : s.brand;

        // Logo swap: white logo for dark-transparent and dark-solid-mobile, dark logo otherwise
        if (logoWhite && logoDark) {
            if (s === STYLE_DARK_TRANSPARENT || isDarkSolidMobile || s === STYLE_LIGHT_TOP) {
                // STYLE_LIGHT_TOP also generally uses dark logo, but wait!
                // Actually, let's just stick to the specific condition for white logo
                if (s === STYLE_DARK_TRANSPARENT || isDarkSolidMobile) {
                    logoWhite.style.opacity = '1';
                    logoDark.style.opacity  = '0';
                } else {
                    logoWhite.style.opacity = '0';
                    logoDark.style.opacity  = '1';
                }
            } else {
                logoWhite.style.opacity = '0';
                logoDark.style.opacity  = '1';
            }
        }

        // Header action icons
        navActions.forEach((navAction) => {
            if (path === '/portal-clientes' && navAction.id === 'nav-cta') {
                navAction.style.color = '#c42847';
                navAction.style.borderColor = 'rgba(196,40,71,0.2)';
                navAction.style.backgroundColor = 'rgba(196,40,71,0.05)';
            } else {
                navAction.style.color = isDarkSolidMobile ? '#ffffff' : s.cta.color;
                navAction.style.borderColor = isDarkSolidMobile ? 'rgba(255,255,255,0.15)' : s.cta.border;
                navAction.style.backgroundColor = isDarkSolidMobile ? 'rgba(255,255,255,0.05)' : s.cta.bg;
            }
        });

        // Hamburger
        lines.forEach(l => { l.style.background = isDarkSolidMobile ? '#ffffff' : s.lines; });

        // Altura
        if (s.height) {
            navInner.classList.add('lg:h-24');
            navInner.classList.remove('lg:h-18');
        } else {
            navInner.classList.remove('lg:h-24');
            navInner.classList.add('lg:h-18');
        }
    }

    // ── Estado actual ─────────────────────────────────────────────────
    // 'dark-transparent' | 'dark-solid' | 'light'
    let currentState = '';

    function getDesiredState(): string {
        const scrollY = window.scrollY;
        
        // 0. Project detail pages: always dark-transparent (white icons/logo)
        if (isProjectPage) return 'dark-transparent';
        if (path.startsWith('/carta')) return 'dark-solid';

        const hero    = document.getElementById('hero');
        const fp      = document.getElementById('featured-projects');
        const cs      = document.getElementById('companies-section');

        // 1. Pages with light backgrounds (Contact, Portal)
        if (isLightPage) {
            return scrollY > 80 ? 'light' : 'light-top';
        }

        // 2. Homepage / Dark Sections Logic
        // En desktop, Hero y FeaturedProjects (pantallas 1 y 2) → siempre transparente
        const isDesktop = window.innerWidth > 1024;
        const navBottom = scrollY + 96;

        // Hero section: transparente
        if (hero && scrollY < hero.offsetHeight - 80) {
            return 'dark-transparent';
        }

        // FeaturedProjects section (incluye CompaniesCarousel en desktop): transparente
        if (fp) {
            const fpTop = fp.offsetTop;
            const fpBottom = fpTop + fp.offsetHeight;
            if (navBottom >= fpTop && navBottom <= fpBottom) {
                // En desktop, toda la sección featured-projects es oscura → transparente
                // En móvil, el companies-section se renderiza fuera, así que respetar su posición
                if (isDesktop) {
                    return 'dark-transparent';
                }
            }
        }

        // CompaniesCarousel fuera de FeaturedProjects (móvil) o tras pasar FeaturedProjects
        if (cs) {
            const csTop = cs.getBoundingClientRect().top + scrollY;
            if (scrollY + 80 >= csTop) {
                return 'dark-solid';
            }
        }

        // Default: scroll normal
        return scrollY > 80 ? 'dark-solid' : 'dark-transparent';
    }

    function update() {
        const desired = getDesiredState();
        if (desired === currentState) return;
        currentState = desired;

        if (desired === 'dark-transparent') applyStyle(STYLE_DARK_TRANSPARENT);
        else if (desired === 'dark-solid')  applyStyle(STYLE_DARK_SOLID);
        else if (desired === 'light-top')   applyStyle(STYLE_LIGHT_TOP);
        else                                applyStyle(STYLE_DARK_SOLID); // negro al scroll en light
    }

    // Ejecutar en scroll y también en resize (por si cambia offsetTop)
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    // Ejecutar al cargar
    update();

    // ── Active link ───────────────────────────────────────────────────
    links.forEach(link => {
        const href = link.dataset.href;
        if (href === path || (href !== '/' && path.startsWith(href ?? ''))) {
            link.style.fontWeight = '600';
        }
    });

    // ── Mobile menu ───────────────────────────────────────────────────
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu   = document.getElementById('mobile-menu');
    const line1  = document.getElementById('line1');
    const line2  = document.getElementById('line2');
    let open = false;

    if (toggle && menu && line1 && line2) {
        toggle.addEventListener('click', () => {
            open = !open;
            if (open) {
                menu.classList.remove('opacity-0','pointer-events-none');
                menu.classList.add('opacity-100','pointer-events-auto');
                line1.classList.add('rotate-45','translate-y-[4px]');
                line2.classList.add('-rotate-45','-translate-y-[3px]','w-6');
                line1.style.background = '#fff';
                line2.style.background = '#fff';
                if (logoWhite) logoWhite.style.opacity = '1';
                if (logoDark) logoDark.style.opacity = '0';
                document.body.style.overflow = 'hidden';
            } else {
                menu.classList.add('opacity-0','pointer-events-none');
                menu.classList.remove('opacity-100','pointer-events-auto');
                line1.classList.remove('rotate-45','translate-y-[4px]');
                line2.classList.remove('-rotate-45','-translate-y-[3px]','w-6');
                document.body.style.overflow = '';
                update(); // restaurar colores correctos tras cerrar
            }
        });
    }

    // El acceso de administrador se gestiona desde /admin/login.
})();
</script>
