---
/**
 * CTA Section — Premium White Design
 */
import { getSettings } from "../../lib/data";
const settings = await getSettings();
---

<section id="cta-section" class="cta-section">

  <!-- Fondo claro -->
  <div class="cta-bg">
    <div class="cta-bg__gradient"></div>
    <div class="cta-bg__glow-left"></div>
    <div class="cta-bg__glow-right"></div>
    <!-- Líneas decorativas horizontales tenues -->
    <div class="cta-bg__line cta-bg__line--top"></div>
    <div class="cta-bg__line cta-bg__line--bottom"></div>
  </div>

  <div class="section-container cta-inner reveal">

    <!-- Eyebrow -->
    <div class="cta-eyebrow reveal delay-1">
      <span class="cta-eyebrow__dot"></span>
      <span class="cta-eyebrow__text">¿Listo para empezar?</span>
    </div>

    <!-- Headline -->
    <h2 class="cta-title reveal delay-2">
      Hablemos de<br />
      <span class="text-gradient-carmin italic inline-block pr-2 pb-1">tu próximo proyecto</span>
    </h2>

    <!-- Subtext -->
    <p class="cta-subtitle reveal delay-3">
      Cuéntanos tu idea y crearemos una propuesta audiovisual a medida.<br class="hidden md:block" />
      Primera consulta sin compromiso.
    </p>

    <!-- Botones -->
    <div class="cta-actions reveal delay-4">
      <a href="/contacto" class="cta-btn cta-btn--primary group">
        <span>Solicitar presupuesto</span>
        <svg class="cta-btn__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
        <!-- Shimmer -->
        <div class="cta-btn__shimmer"></div>
      </a>

      <a
        href={`https://wa.me/${settings.whatsapp_number?.replace(/[^0-9]/g, '')}?text=Hola,%20me%20gustaría%20hablar%20sobre%20un%20proyecto%20audiovisual.`}
        target="_blank" rel="noopener"
        data-ga-event="click_whatsapp"
        data-ga-method="whatsapp"
        class="cta-btn cta-btn--wa group"
      >
        <svg class="cta-btn__wa-icon" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        <span>WhatsApp directo</span>
      </a>
    </div>

    <!-- Trust row -->
    <div class="cta-trust reveal delay-5">
      <div class="cta-trust__item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>Respuesta en 24h</span>
      </div>
      <div class="cta-trust__sep"></div>
      <div class="cta-trust__item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>Sin compromiso</span>
      </div>
      <div class="cta-trust__sep"></div>
      <div class="cta-trust__item">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        <span>Presupuesto gratis</span>
      </div>
    </div>

  </div>
</section>

<style>
/* ── Sección ───────────────────────────────────────────── */
.cta-section {
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 1.5rem;
  min-height: 100vh;
  background-color: #ffffff;
}

@media (max-width: 1024px) {
  .cta-section {
    min-height: auto;
    padding: 3rem 1.5rem;
  }
}

/* ── Fondo ─────────────────────────────────────────────── */
.cta-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.cta-bg__gradient {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 120% 80% at 50% 100%, rgba(155,27,48,0.06) 0%, transparent 50%),
              linear-gradient(to bottom, #f9fafb 0%, #ffffff 100%);
}
.cta-bg__glow-left {
  position: absolute;
  top: 10%; left: -10%;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(155,27,48,0.04) 0%, transparent 70%);
  filter: blur(60px);
}
.cta-bg__glow-right {
  position: absolute;
  bottom: 10%; right: -10%;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(196,40,71,0.04) 0%, transparent 70%);
  filter: blur(60px);
}
.cta-bg__line {
  position: absolute; left: 0; right: 0; height: 1px;
  background: linear-gradient(to right, transparent, rgba(0,0,0,0.05) 30%, rgba(0,0,0,0.05) 70%, transparent);
}
.cta-bg__line--top    { top: 0; }
.cta-bg__line--bottom { bottom: 0; }

/* ── Contenido ─────────────────────────────────────────── */
.cta-inner {
  position: relative; z-index: 10;
  display: flex; flex-direction: column;
  align-items: center; text-align: center;
  gap: 0;
  max-width: 780px;
  margin-left: auto;
  margin-right: auto;
}

/* Eyebrow */
.cta-eyebrow {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .375rem 1.125rem;
  border-radius: 9999px;
  border: 1px solid rgba(155,27,48,.15);
  background: rgba(155,27,48,.03);
  backdrop-filter: blur(8px);
  margin-bottom: 2rem;
}
.cta-eyebrow__dot {
  display: block; width: 6px; height: 6px; border-radius: 50%;
  background: #c42847;
  box-shadow: 0 0 8px rgba(196,40,71,.4);
  animation: cta-pulse 2s infinite;
}
.cta-eyebrow__text {
  font-size: .75rem; font-weight: 700;
  letter-spacing: .1em; text-transform: uppercase;
  color: #9b1422;
}

/* Título */
.cta-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(2.75rem, 6vw, 5rem);
  font-weight: 800;
  color: #111827; /* Texto oscuro */
  line-height: 1.1;
  letter-spacing: -.03em;
  margin: 0 0 1.5rem;
}
/* Subtítulo */
.cta-subtitle {
  font-size: 1.125rem;
  color: #4b5563; /* Gris oscuro para lectura */
  line-height: 1.7;
  max-width: 520px;
  margin: 0 0 3rem;
  font-weight: 400;
}

/* ── Botones ────────────────────────────────────────────── */
.cta-actions {
  display: flex; flex-wrap: wrap;
  align-items: center; justify-content: center;
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.cta-btn {
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; gap: .75rem;
  padding: 1.125rem 2.25rem;
  border-radius: 1rem;
  font-family: 'Outfit', sans-serif;
  font-size: .9375rem; font-weight: 700;
  letter-spacing: .04em; text-transform: uppercase;
  text-decoration: none;
  transition: transform .25s, box-shadow .25s;
  cursor: pointer;
}
.cta-btn:hover { transform: translateY(-2px); }
.cta-btn:active { transform: scale(.97); }

/* Primary */
.cta-btn--primary {
  background: linear-gradient(135deg, #c42847 0%, #9b1b30 100%);
  color: #fff;
  box-shadow: 0 10px 30px rgba(155,27,48,.25), inset 0 1px 0 rgba(255,255,255,.12);
}
.cta-btn--primary:hover {
  box-shadow: 0 16px 40px rgba(155,27,48,.35), inset 0 1px 0 rgba(255,255,255,.12);
}
.cta-btn__icon {
  width: 1.125rem; height: 1.125rem;
  transition: transform .3s;
  flex-shrink: 0;
}
.cta-btn--primary:hover .cta-btn__icon {
  transform: translate(3px, -3px);
}
/* Shimmer sweep */
.cta-btn__shimmer {
  position: absolute; inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.15) 50%, transparent 60%);
  transform: translateX(-100%);
  transition: transform .7s;
  pointer-events: none;
}
.cta-btn--primary:hover .cta-btn__shimmer { transform: translateX(100%); }

/* WhatsApp */
.cta-btn--wa {
  background: #ffffff;
  color: #1f2937;
  border: 1px solid rgba(0,0,0,0.1);
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}
.cta-btn--wa:hover {
  background: #f8fafc;
  border-color: rgba(37,211,102,.3);
  color: #111827;
  box-shadow: 0 8px 25px rgba(37,211,102,.12);
}
.cta-btn__wa-icon {
  width: 1.25rem; height: 1.25rem; flex-shrink: 0;
  color: #25D366;
  transition: transform .3s;
}
.cta-btn--wa:hover .cta-btn__wa-icon { transform: scale(1.15); }

/* ── Trust ──────────────────────────────────────────────── */
.cta-trust {
  display: flex; align-items: center; gap: 1.25rem;
  flex-wrap: wrap; justify-content: center;
}
.cta-trust__item {
  display: flex; align-items: center; gap: .375rem;
  font-size: .875rem; color: #6b7280;
  font-weight: 500;
}
.cta-trust__item svg {
  width: 1rem; height: 1rem; flex-shrink: 0;
  color: #10b981;
}
.cta-trust__sep {
  width: 1px; height: 1rem;
  background: rgba(0,0,0,.1);
}

@keyframes cta-pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: .35; }
}
</style>
