---
/**
 * Hero Section — Fullscreen Video Background
 * Uses dynamic video from settings DB
 */
import { getSettings } from "../../lib/data";
import { optimizeCloudinaryVideo } from "../../lib/cloudinary";
import { getVideoId } from "../../lib/display";
import "../../styles/contacto.css";
const settings = await getSettings();

function isNativeHeroVideo(url: string | null | undefined): boolean {
    return !!url && (url.includes('cloudinary.com') || /\.(mp4|webm)(\?.*)?$/i.test(url));
}

const desktopRawVideoUrl = settings.hero_video_desktop || settings.hero_video_mobile || '';
const mobileRawVideoUrl = settings.hero_video_mobile || desktopRawVideoUrl;

const desktopIsNative = isNativeHeroVideo(desktopRawVideoUrl);
const mobileIsNative = isNativeHeroVideo(mobileRawVideoUrl);
const desktopVideoUrl = desktopIsNative ? optimizeCloudinaryVideo(desktopRawVideoUrl, { width: 1920, quality: 'auto:best', bitRate: '6m' }) : desktopRawVideoUrl;
const mobileVideoUrl = mobileIsNative ? optimizeCloudinaryVideo(mobileRawVideoUrl, { width: 1080, quality: 'auto:best', bitRate: '5m' }) : mobileRawVideoUrl;
const desktopYoutubeId = !desktopIsNative ? getVideoId(desktopVideoUrl) : null;
const mobileYoutubeId = !mobileIsNative ? getVideoId(mobileVideoUrl) : null;
const fallbackYoutubeId = 'D91q99QK11k';
const hasConfiguredHeroVideo = !!(desktopVideoUrl || mobileVideoUrl);
const initialYoutubeId = desktopYoutubeId || mobileYoutubeId || (!hasConfiguredHeroVideo ? fallbackYoutubeId : '');
const hasNativeHero = desktopIsNative || mobileIsNative;
const hasYoutubeHero = !!(desktopYoutubeId || mobileYoutubeId || !hasConfiguredHeroVideo);
const heroBackgroundStyle = initialYoutubeId
    ? `height: 100vh; height: 100dvh; min-height: 600px; background: #050508 url(https://i.ytimg.com/vi/${initialYoutubeId}/maxresdefault.jpg) center/cover no-repeat;`
    : 'height: 100vh; height: 100dvh; min-height: 600px; background: #050508;';

const heroSources = {
    desktop: {
        url: desktopIsNative ? desktopVideoUrl : '',
        isNative: desktopIsNative,
        youtubeId: desktopYoutubeId || (!desktopVideoUrl && !mobileVideoUrl ? fallbackYoutubeId : ''),
        poster: desktopYoutubeId ? `https://i.ytimg.com/vi/${desktopYoutubeId}/maxresdefault.jpg` : '',
    },
    mobile: {
        url: mobileIsNative ? mobileVideoUrl : '',
        isNative: mobileIsNative,
        youtubeId: mobileYoutubeId || desktopYoutubeId || (!desktopVideoUrl && !mobileVideoUrl ? fallbackYoutubeId : ''),
        poster: (mobileYoutubeId || desktopYoutubeId) ? `https://i.ytimg.com/vi/${mobileYoutubeId || desktopYoutubeId}/maxresdefault.jpg` : '',
    },
};

// Prepare dynamic title lines (split by newlines)
const defaultTitle = 'Creamos\n**historias** que\nimpulsan\nmarcas';
const titleLines = (settings.hero_title || defaultTitle).split('\n');
const heroSubtitle = settings.hero_subtitle || '';
const whatsappHref = `https://wa.me/${settings.whatsapp_number?.replace(/[^0-9]/g, '')}?text=Hola,%20me%20gustaria%20hablar%20sobre%20un%20proyecto%20audiovisual.`;
---

<section
    id="hero"
    class="relative flex items-center justify-center overflow-hidden"
    style={heroBackgroundStyle}
>
    <!-- Fullscreen Video Background -->
    <div
        id="hero-video-container"
        class="absolute inset-0 z-0 overflow-hidden bg-black pointer-events-none"
    >
        {hasNativeHero && (
            <video id="hero-native-video" aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700"
                autoplay loop muted playsinline preload="none"
            ></video>
        )}
        {hasYoutubeHero && (
            <!-- Contenedor con la clase video-bg que se encarga del tamaño y posición -->
            <div id="hero-player-wrapper" class="video-bg opacity-0 transition-opacity duration-1000">
                <div id="hero-player"></div>
            </div>
        )}

        <div class="absolute inset-0 bg-dark/10 pointer-events-none"></div>
    </div>

    <script is:inline define:vars={{ heroSources }}>
        const heroMediaQuery = window.matchMedia('(max-width: 767px)');
        const selectedHeroSource = heroMediaQuery.matches ? heroSources.mobile : heroSources.desktop;
        const heroSection = document.getElementById('hero');
        const nativeVideo = document.getElementById('hero-native-video');
        const playerWrapper = document.getElementById('hero-player-wrapper');

        if (selectedHeroSource.poster && heroSection) {
            heroSection.style.backgroundImage = `url(${selectedHeroSource.poster})`;
            heroSection.style.backgroundPosition = 'center';
            heroSection.style.backgroundSize = 'cover';
            heroSection.style.backgroundRepeat = 'no-repeat';
        }

        const markHeroReady = () => window.dispatchEvent(new CustomEvent('vm-hero-ready'));

        if (selectedHeroSource.isNative && nativeVideo instanceof HTMLVideoElement && selectedHeroSource.url) {
            if (playerWrapper) playerWrapper.style.display = 'none';

            const revealNativeVideo = () => {
                nativeVideo.classList.remove('opacity-0');
                markHeroReady();
            };

            nativeVideo.addEventListener('loadeddata', revealNativeVideo, { once: true });
            nativeVideo.addEventListener('canplay', revealNativeVideo, { once: true });
            nativeVideo.addEventListener('playing', revealNativeVideo, { once: true });
            nativeVideo.src = selectedHeroSource.url;
            nativeVideo.muted = true;
            nativeVideo.playsInline = true;
            nativeVideo.autoplay = true;
            nativeVideo.loop = true;
            nativeVideo.play().catch(() => {
                if (nativeVideo.readyState >= 2) revealNativeVideo();
                else markHeroReady();
            });
            if (nativeVideo.readyState >= 2) revealNativeVideo();
        } else if (selectedHeroSource.youtubeId && playerWrapper) {
            if (nativeVideo instanceof HTMLVideoElement) {
                nativeVideo.removeAttribute('src');
                nativeVideo.load();
                nativeVideo.style.display = 'none';
            }

        // Carga de la API de YouTube diferida para no penalizar el rendimiento inicial (Lighthouse)
        function loadYouTubeAPI() {
            if (!window.YT) {
                const tag = document.createElement('script');
                tag.src = "https://www.youtube-nocookie.com/iframe_api";
                const firstScriptTag = document.getElementsByTagName('script')[0];
                if (firstScriptTag && firstScriptTag.parentNode) {
                    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
                } else {
                    document.head.appendChild(tag);
                }
            }
        }

        // Retrasar la carga para priorizar el FCP/LCP y evitar bloqueos de Best Practices
        if (document.readyState === 'complete') {
            setTimeout(loadYouTubeAPI, 2000);
        } else {
            window.addEventListener('load', () => setTimeout(loadYouTubeAPI, 2000));
        }

        function initHeroPlayer() {
            const playerEl = document.getElementById('hero-player');
            if (!playerEl) return;
            
            new window.YT.Player(playerEl, {
                host: 'https://www.youtube-nocookie.com',
                videoId: selectedHeroSource.youtubeId,
                width: '100%',
                height: '100%',
                playerVars: {
                    autoplay: 1,
                    mute: 1,
                    controls: 0,
                    showinfo: 0,
                    rel: 0,
                    modestbranding: 1,
                    playsinline: 1,
                    enablejsapi: 1,
                    origin: window.location.origin
                },
                events: {
                    onReady: (event) => {
                        // Ensure video is muted before playing
                        event.target.mute();
                        
                        // Force allow attribute for autoplay
                        const iframe = event.target.getIframe();
                        if (iframe) {
                            iframe.setAttribute('allow', 'autoplay; encrypted-media; compute-pressure');
                        }
                        
                        event.target.playVideo();
                        
                        // Pre-end loop specifically for Hero to avoid YouTube UI flash.
                        const heroLoopInterval = window.setInterval(() => {
                            try {
                                const time = event.target.getCurrentTime();
                                const duration = event.target.getDuration();
                                if (duration > 0 && time >= duration - 0.4) {
                                    const wrapper = document.getElementById('hero-player-wrapper');
                                    if (wrapper) wrapper.style.opacity = '0';
                                    
                                    event.target.seekTo(0);
                                }
                            } catch(e) {}
                        }, 800);

                        window.addEventListener('pagehide', () => {
                            window.clearInterval(heroLoopInterval);
                        }, { once: true });
                    },
                    onStateChange: (event) => {
                        // 1 = PLAYING
                        if (event.data === 1) {
                            const wrapper = document.getElementById('hero-player-wrapper');
                            if (wrapper) wrapper.style.opacity = '1';
                            
                            // Emitir el evento para el preloader
                            window.dispatchEvent(new CustomEvent('vm-hero-ready'));
                        }
                        
                        // Fallback
                        if (event.data === 0) {
                            const wrapper = document.getElementById('hero-player-wrapper');
                            if (wrapper) wrapper.style.opacity = '0';
                            
                            event.target.seekTo(0);
                            event.target.playVideo();
                        }
                    }
                }
            });
        }

        if (window.YT && window.YT.Player) {
            initHeroPlayer();
        } else {
            const previousOnReady = window.onYouTubeIframeAPIReady;
            window.onYouTubeIframeAPIReady = () => {
                if (previousOnReady) previousOnReady();
                initHeroPlayer();
            };
        }
        } else {
            markHeroReady();
        }
    </script>

    <!-- Content (Centered) -->
    <div
        class="relative z-10 w-full px-6 flex flex-col items-center justify-center text-center pt-20 lg:pt-12"
    >
        <!-- Badge -->
        <div
            class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full border border-white/10 bg-white/5 backdrop-blur-md mb-10 animate-fade-up shadow-2xl"
        >
            <div
                class="w-2 h-2 bg-carmin rounded-full animate-pulse shadow-[0_0_10px_rgba(232,54,79,0.8)]"
            >
            </div>
            <span class="text-label text-white tracking-widest uppercase"
                >Productora Audiovisual</span
            >
        </div>

        <!-- Headline -->
        <h1
            class="hero-title pointer-events-none"
        >
            {titleLines.map((line: string, idx: number) => {
                const isLeft = idx % 2 !== 0;
                const animClass = isLeft ? 'animate-slide-left-in' : 'animate-slide-right-in';
                const delay = (0.1 + idx * 0.2).toFixed(1) + 's';
                
                // Process **text** into styled spans
                const parts = line.split(/(\*\*.*?\*\*)/g);
                
                return (
                    <div class="hero-title__line">
                        <span 
                            class={`hero-title__text ${animClass} opacity-0`}
                            style={`animation-fill-mode: forwards; animation-delay: ${delay}`}
                        >
                            {parts.map((part: string) => {
                                if (part.startsWith('**') && part.endsWith('**')) {
                                    return <span class="hero-title__accent">{part.slice(2, -2)}</span>;
                                }
                                return part;
                            })}
                        </span>
                    </div>
                );
            })}
        </h1>

        {heroSubtitle && (
            <p 
                class="hero-subtitle text-white text-lg md:text-xl max-w-2xl animate-fade-up opacity-0 pointer-events-none"
                style={`animation-fill-mode: forwards; animation-delay: ${(0.3 + titleLines.length * 0.2).toFixed(1)}s`}
            >
                {heroSubtitle}
            </p>
        )}

        {/* CTA Buttons */}
        <div 
            class="hero-actions"
            style={`z-index: 99999; animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; animation-delay: ${(0.5 + titleLines.length * 0.2).toFixed(1)}s; opacity: 0;`}
        >
            <a href="/contacto" class="hero-action hero-action--primary">
                <span>Solicitar presupuesto</span>
            </a>
            <a
                href={whatsappHref}
                target="_blank"
                rel="noopener"
                data-ga-event="whatsapp_click"
                data-ga-method="hero_whatsapp"
                class="hero-action hero-action--secondary"
            >
                <span>WhatsApp directo</span>
            </a>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3 animate-fade-up pointer-events-none"
        style="animation-delay: 0.8s"
    >
        <span
            class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/50"
            >Explorar</span
        >
        <div class="w-[1px] h-16 bg-white/10 relative overflow-hidden">
            <div
                class="absolute top-0 left-0 w-full h-1/2 bg-carmin animate-scroll-down"
            >
            </div>
        </div>
    </div>
</section>



<style>
    .video-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 56.25vw;
        min-height: 100vh;
        min-height: 100dvh;
        min-width: 177.77vh;
        pointer-events: none;
    }
    .hero-title {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.34rem;
        width: min(100%, 68rem);
        margin: 0 auto;
        padding: 0 1rem;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 2.7rem;
        font-weight: 900;
        line-height: 0.98;
        letter-spacing: 0;
        text-align: center;
        text-transform: uppercase;
        text-wrap: balance;
        filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.5));
    }

    .hero-title::before {
        content: "";
        width: 5rem;
        height: 0.18rem;
        margin-bottom: 0.45rem;
        border-radius: 9999px;
        background: linear-gradient(90deg, transparent, #e8364f, #c9a962, transparent);
        box-shadow: 0 0 24px rgba(232, 54, 79, 0.45);
    }

    .hero-title__line {
        position: relative;
        display: flex;
        justify-content: center;
        width: 100%;
        overflow: visible;
    }

    .hero-title__text {
        position: relative;
        display: inline-block;
        padding: 0.02em 0.04em 0.08em;
        box-decoration-break: clone;
        -webkit-box-decoration-break: clone;
        text-shadow:
            0 1px 0 rgba(255, 255, 255, 0.12),
            0 12px 34px rgba(0, 0, 0, 0.62);
    }

    .hero-title__line:nth-child(odd) .hero-title__text {
        transform-origin: left center;
    }

    .hero-title__line:nth-child(even) .hero-title__text {
        transform-origin: right center;
    }

    .hero-title__accent {
        position: relative;
        display: inline-block;
        padding: 0 0.08em 0.04em;
        color: #fff;
        font-style: italic;
        text-shadow:
            0 0 18px rgba(232, 54, 79, 0.7),
            0 10px 32px rgba(155, 27, 48, 0.6);
    }

    .hero-title__accent::before {
        content: "";
        position: absolute;
        left: 0.02em;
        right: 0.02em;
        bottom: 0.05em;
        z-index: -1;
        height: 0.34em;
        border-radius: 9999px;
        background: linear-gradient(90deg, rgba(155, 27, 48, 0.92), rgba(232, 54, 79, 0.98), rgba(201, 169, 98, 0.78));
        transform: skewX(-10deg);
        box-shadow: 0 10px 32px rgba(232, 54, 79, 0.35);
    }

    @media (min-width: 640px) {
        .hero-title {
            gap: 0.45rem;
            font-size: 4rem;
            line-height: 0.94;
        }
    }

    @media (min-width: 1024px) {
        .hero-title {
            gap: 0.5rem;
            font-size: 5.3rem;
        }
    }

    .hero-subtitle {
        margin-top: clamp(0.95rem, 2vh, 1.4rem);
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
    }

    .hero-actions {
        position: relative;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        width: 100%;
        max-width: 23rem;
        margin-top: clamp(0.95rem, 2vh, 1.4rem);
        padding: 0 1rem;
    }
    .hero-action {
        position: relative;
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 3.25rem;
        padding: 0.95rem 1.45rem;
        border: 0;
        border-radius: 9999px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 800;
        line-height: 1;
        text-align: center;
        text-decoration: none;
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        isolation: isolate;
    }
    .hero-action > * {
        pointer-events: none;
    }

    .hero-action--primary {
        background: #e11d48;
        color: #fff;
        box-shadow: 0 10px 24px rgba(225, 29, 72, 0.38);
    }

    .hero-action--secondary {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.22);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    @media (min-width: 640px) {
        .hero-actions {
            flex-direction: row;
            max-width: none;
            margin-top: clamp(0.95rem, 2vh, 1.4rem);
        }

        .hero-action {
            width: auto;
            min-width: 13.5rem;
        }
    }

    @keyframes scroll-down {
        0% {
            transform: translateY(-100%);
            opacity: 0;
        }
        50% {
            opacity: 1;
        }
        100% {
            transform: translateY(200%);
            opacity: 0;
        }
    }
    .animate-scroll-down {
        animation: scroll-down 2s infinite cubic-bezier(0.65, 0, 0.35, 1);
    }

    @keyframes slide-right-in {
        0% {
            transform: translateX(-100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    @keyframes slide-left-in {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .animate-slide-right-in {
        animation: slide-right-in 1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .animate-slide-left-in {
        animation: slide-left-in 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Hero CTA Buttons */
    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.875rem 1.75rem;
        border-radius: 1rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
        border: none;
    }
    .hero-cta:hover { transform: translateY(-2px); }
    .hero-cta:active { transform: scale(0.97); }

    .hero-cta--primary {
        background: linear-gradient(135deg, #c42847, #9b1b30);
        color: #fff;
        box-shadow: 0 10px 30px rgba(155,27,48,0.35), inset 0 1px 0 rgba(255,255,255,0.12);
    }
    .hero-cta--primary:hover {
        box-shadow: 0 16px 40px rgba(155,27,48,0.45), inset 0 1px 0 rgba(255,255,255,0.15);
    }

    .hero-cta--secondary {
        background: rgba(255,255,255,0.08);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.15);
        backdrop-filter: blur(12px);
    }
    .hero-cta--secondary:hover {
        background: rgba(255,255,255,0.14);
        border-color: rgba(255,255,255,0.25);
        box-shadow: 0 8px 25px rgba(0,0,0,0.2);
    }
</style>
