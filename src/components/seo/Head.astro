---
/**
 * SEO Head Component
 * Generates meta tags, Open Graph, Twitter cards and JSON-LD markup.
 */
import { getPageSeo, getSettings } from "../../lib/data";
import { absoluteUrl, canonicalFromUrl, cleanPath, getSiteUrl } from "../../lib/seo";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, any> | Array<Record<string, any> | null> | null;
}

const settings = await getSettings();
const pageSeo = await getPageSeo(cleanPath(Astro.url.pathname));

const siteUrl = getSiteUrl();
const siteName = settings.site_name || 'VideoMarketing Sevilla';
const defaultDescription = settings.site_description || 'Productora audiovisual especializada en video marketing para empresas en Sevilla, Cadiz y toda Espana.';

const {
  title,
  description,
  image,
  imageAlt,
  url = Astro.url.href,
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const rawTitle = pageSeo?.title || title;
const fullTitle = rawTitle
  ? (rawTitle.includes(siteName) || rawTitle.includes('|') ? rawTitle : `${rawTitle} | ${siteName}`)
  : `${siteName} | Productora Audiovisual en Sevilla`;

const metaDescription = pageSeo?.description || description || defaultDescription;
const canonicalUrl = pageSeo?.canonical_url || canonicalFromUrl(url);
const resolvedImage = absoluteUrl(pageSeo?.og_image || image || settings.logo_url || '/logo2.png') || `${siteUrl}/logo2.png`;
const resolvedImageAlt = imageAlt || `${siteName} - productora audiovisual en Sevilla`;
const shouldNoindex = noindex || pageSeo?.no_index === true;
const themeColor = settings.primary_color || '#9B1B30';

const youtubeId = settings.hero_video_desktop?.match(/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/)?.[1] || 'D91q99QK11k';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#business`,
  name: siteName,
  description: defaultDescription,
  url: siteUrl,
  logo: absoluteUrl(settings.logo_url || '/logo2.png'),
  image: resolvedImage,
  telephone: settings.phone || '+34600000000',
  email: settings.email || 'info@videomarketingsevilla.es',
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address || 'Sevilla',
    addressLocality: 'Sevilla',
    addressRegion: 'Andalucia',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.3886,
    longitude: -5.9823,
  },
  areaServed: [
    { '@type': 'City', name: 'Sevilla' },
    { '@type': 'City', name: 'Cadiz' },
    { '@type': 'AdministrativeArea', name: 'Andalucia' },
    { '@type': 'Country', name: 'ES' },
  ],
  priceRange: 'EUR',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: settings.phone || '+34600000000',
    email: settings.email || 'info@videomarketingsevilla.es',
    contactType: 'sales',
    areaServed: 'ES',
    availableLanguage: ['es'],
  },
  sameAs: [
    settings.instagram,
    settings.linkedin,
  ].filter(Boolean),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: siteName,
  url: siteUrl,
  publisher: { '@id': `${siteUrl}/#business` },
  inLanguage: 'es-ES',
};

const extraStructuredData = Array.isArray(structuredData)
  ? structuredData.filter(Boolean)
  : structuredData ? [structuredData] : [];

const schemaItems = [
  localBusinessSchema,
  websiteSchema,
  ...extraStructuredData,
];
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDescription} />
<meta name="robots" content={shouldNoindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="theme-color" content={themeColor} />
<meta name="format-detection" content="telephone=no" />
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap-index.xml" type="application/xml" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={resolvedImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={resolvedImage} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

<!-- Schema.org -->
{schemaItems.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Preload Critical Assets -->
<link rel="preload" href={`https://i.ytimg.com/vi_webp/${youtubeId}/hqdefault.webp`} as="image" fetchpriority="high" />
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" as="style" />

<!-- Security Meta Tags -->
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />

<!-- Preconnect Google Fonts & DNS-Prefetch Media -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://i.ytimg.com" crossorigin />
<link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
<link rel="dns-prefetch" href="https://res.cloudinary.com" />

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
