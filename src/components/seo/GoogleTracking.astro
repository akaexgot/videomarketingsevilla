---
const gtmId = String(import.meta.env.PUBLIC_GTM_ID || '').trim();
const ga4MeasurementId = String(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || '').trim();
const googleAdsId = String(import.meta.env.PUBLIC_GOOGLE_ADS_ID || '').trim();
const googleAdsConversionLabel = String(import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL || '').trim();

const useGtm = Boolean(gtmId);
const directTagIds = useGtm
    ? []
    : Array.from(new Set([ga4MeasurementId, googleAdsId].filter(Boolean)));
const firstDirectTagId = directTagIds[0] || '';
const shouldLoadTracking = useGtm || Boolean(firstDirectTagId);

const grantedConsent = {
    ad_storage: 'granted',
    analytics_storage: 'granted',
    ad_user_data: 'granted',
    ad_personalization: 'granted',
};

const deniedConsent = {
    ad_storage: 'denied',
    analytics_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500,
};

const consentBootstrap = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = window.gtag || gtag;
var vmGrantedConsent = ${JSON.stringify(grantedConsent)};
var vmDeniedConsent = ${JSON.stringify(deniedConsent)};
function vmNormalizeConsent(value) {
  if (value === 'granted') {
    return Object.assign({}, vmGrantedConsent);
  }
  if (value === 'denied') {
    return Object.assign({}, vmDeniedConsent);
  }
  try {
    var parsed = typeof value === 'string' ? JSON.parse(value) : value;
    if (!parsed || typeof parsed !== 'object') return null;
    var analyticsGranted = parsed.analytics === true || parsed.analytics_storage === 'granted';
    var adsGranted = parsed.marketing === true || parsed.ads === true || parsed.ad_storage === 'granted';
    return {
      analytics_storage: analyticsGranted ? 'granted' : 'denied',
      ad_storage: adsGranted ? 'granted' : 'denied',
      ad_user_data: adsGranted ? 'granted' : 'denied',
      ad_personalization: adsGranted ? 'granted' : 'denied'
    };
  } catch (error) {
    return null;
  }
}
function vmStoreConsent(consentState, preferences) {
  try {
    var analyticsGranted = consentState.analytics_storage === 'granted';
    var adsGranted = consentState.ad_storage === 'granted';
    window.localStorage.setItem('vm_google_consent', JSON.stringify(Object.assign({
      version: 2,
      analytics: analyticsGranted,
      marketing: adsGranted,
      updatedAt: new Date().toISOString()
    }, preferences || {})));
  } catch (error) {}
}
function vmConsentForUpdate(consentState) {
  var state = Object.assign({}, consentState);
  delete state.wait_for_update;
  return state;
}
function vmUpdateConsent(consentState, preferences) {
  var normalized = vmNormalizeConsent(consentState) || Object.assign({}, vmDeniedConsent);
  var updateState = vmConsentForUpdate(normalized);
  gtag('consent', 'update', updateState);
  vmStoreConsent(updateState, preferences);
  try {
    window.dispatchEvent(new CustomEvent('vm-google-consent-updated', { detail: updateState }));
  } catch (error) {}
  return updateState;
}
gtag('consent', 'default', ${JSON.stringify(deniedConsent)});
try {
  var storedGoogleConsent = window.localStorage.getItem('vm_google_consent');
  var storedConsentState = vmNormalizeConsent(storedGoogleConsent);
  if (storedConsentState) {
    gtag('consent', 'update', vmConsentForUpdate(storedConsentState));
  }
} catch (error) {}
window.vmGoogleConsent = {
  acceptAll: function() {
    return vmUpdateConsent(vmGrantedConsent, { source: 'accept_all' });
  },
  denyAll: function() {
    return vmUpdateConsent(vmDeniedConsent, { source: 'reject_all' });
  },
  update: function(preferences) {
    var analyticsGranted = Boolean(preferences && preferences.analytics);
    var marketingGranted = Boolean(preferences && preferences.marketing);
    return vmUpdateConsent({
      analytics_storage: analyticsGranted ? 'granted' : 'denied',
      ad_storage: marketingGranted ? 'granted' : 'denied',
      ad_user_data: marketingGranted ? 'granted' : 'denied',
      ad_personalization: marketingGranted ? 'granted' : 'denied'
    }, Object.assign({ source: 'preferences' }, preferences || {}));
  },
  getStored: function() {
    try {
      return vmNormalizeConsent(window.localStorage.getItem('vm_google_consent'));
    } catch (error) {
      return null;
    }
  }
};
window.vmTrackEvent = function(eventName, params) {
  if (typeof window.gtag !== 'function') return false;
  window.gtag('event', eventName, params || {});
  return true;
};
document.addEventListener('click', function(event) {
  var target = event.target instanceof Element ? event.target.closest('a[href], [data-ga-event]') : null;
  if (!target) return;
  var href = target.getAttribute('href') || '';
  var explicitEventName = target.getAttribute('data-ga-event');
  var normalizedHref = href.toLowerCase();
  var eventName = explicitEventName;

  if (normalizedHref.indexOf('tel:') === 0) {
    eventName = 'phone_click';
  } else if (normalizedHref.indexOf('mailto:') === 0) {
    eventName = 'email_click';
  } else if (
    normalizedHref.indexOf('https://wa.me/') === 0 ||
    normalizedHref.indexOf('http://wa.me/') === 0 ||
    normalizedHref.indexOf('https://api.whatsapp.com/') === 0 ||
    normalizedHref.indexOf('http://api.whatsapp.com/') === 0 ||
    normalizedHref.indexOf('whatsapp://') === 0
  ) {
    eventName = 'whatsapp_click';
  }

  if (!eventName) return;
  window.vmTrackEvent(eventName, {
    method: target.getAttribute('data-ga-method') || undefined,
    link_url: href || undefined
  });
});
`;

const gtmScript = `
${consentBootstrap}
(function(w,d,s,l,i){
  w[l]=w[l]||[];
  w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
  var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),
      dl=l!='dataLayer'?'&l='+l:'';
  j.async=true;
  j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
  f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});
`;

const directGtagScript = `
${consentBootstrap}
gtag('js', new Date());
${directTagIds.map((tagId) => `gtag('config', ${JSON.stringify(tagId)}, { send_page_view: true });`).join('\n')}
window.vmGoogleTracking = {
  googleAdsId: ${JSON.stringify(googleAdsId)},
  defaultConversionLabel: ${JSON.stringify(googleAdsConversionLabel)},
  trackGoogleAdsConversion: function(label, params) {
    var conversionLabel = label || this.defaultConversionLabel;
    if (!window.gtag || !this.googleAdsId || !conversionLabel) return false;
    gtag('event', 'conversion', Object.assign({
      send_to: this.googleAdsId + '/' + conversionLabel
    }, params || {}));
    return true;
  }
};
`;
---

{shouldLoadTracking && (
    <>
        {useGtm ? (
            <script is:inline set:html={gtmScript}></script>
        ) : (
            <>
                <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${firstDirectTagId}`}></script>
                <script is:inline set:html={directGtagScript}></script>
            </>
        )}
    </>
)}
